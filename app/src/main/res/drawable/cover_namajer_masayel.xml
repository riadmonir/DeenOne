        android:fillColor="#00000000"
        android:strokeColor="#C5A059"
        android:strokeWidth="1.2"
        android:pathData="M18,14 L106,14 A4,4 0 0,1 110,18 L110,142 A4,4 0 0,1 106,146 L18,146 A4,4 0 0,1 14,142 L14,18 A4,4 0 0,1 18,14 Z" />

    <!-- Book Header Banner -->
    <path
        android:fillColor="#C5A059"
        android:pathData="M25,24 L95,24 A3,3 0 0,1 98,27 L98,34 A3,3 0 0,1 95,37 L25,37 A3,3 0 0,1 22,34 L22,27 A3,3 0 0,1 25,24 Z" />

