                android:endColor="#0F2B48"
                android:startColor="#1E4E79"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Book Spine Accent -->
    <path
        android:fillColor="#102A45"
        android:pathData="M0,0 L10,0 L10,160 L0,160 Z" />
    <path
        android:fillColor="#D4AF37"
        android:pathData="M10,0 L11,0 L11,160 L10,160 Z" />

    <!-- Islamic Dome & Minaret Silhouette -->
    <path
        android:fillColor="#153E65"
        android:pathData="M25,120 L25,95 Q35,80 45,95 L45,120 Z" />
    <path
        android:fillColor="#1B4D7D"
        android:pathData="M40,120 L40,85 Q60,60 80,85 L80,120 Z" />
    <path
        android:fillColor="#153E65"
        android:pathData="M75,120 L75,95 Q85,80 95,95 L95,120 Z" />

