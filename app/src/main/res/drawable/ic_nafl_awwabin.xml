<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- 1. Outer Soft Glow Ring -->
    <path
        android:fillColor="#15F472B6"
        android:pathData="M50,50m-48,0a48,48 0,1 1,96 0a48,48 0,1 1,-96 0" />

    <!-- 2. Circular Base Background: Maghrib Sunset Twilight Sky -->
    <path
        android:pathData="M50,50m-44,0a44,44 0,1 1,88 0a44,44 0,1 1,-88 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="90"
                android:endColor="#831843"
                android:startColor="#2E1065"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- 3. Twilight Sky Gradient Band & Stars -->
    <path
        android:fillColor="#F472B6"
        android:fillAlpha="0.3"
        android:pathData="M10,50 Q50,44 90,50 L90,62 L10,62 Z" />
    <path
        android:fillColor="#FDE047"
        android:pathData="M30,22 L31,24 L33,24.5 L31,25 L30,27 L29,25 L27,24.5 L29,24 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M70,24 A1.2,1.2 0 1,0 70,26.4 A1.2,1.2 0 1,0 70,24 Z" />

    <!-- 4. Mosque Silhouette in Sunset Horizon -->
    <!-- Dome -->
    <path
        android:fillColor="#581C87"
        android:pathData="M38,62 C38,50 45,46 50,44 C55,46 62,50 62,62 Z" />
    <path
        android:fillColor="#FBBF24"
        android:pathData="M50,41 A1.5,1.5 0 1,0 50,44 A1.5,1.5 0 1,0 50,41 Z" />
    <!-- Minaret Left -->
    <path
        android:fillColor="#4A044E"
        android:pathData="M24,62 L24,36 L26.5,30 L29,36 L29,62 Z" />
    <!-- Minaret Right -->
    <path
        android:fillColor="#4A044E"
        android:pathData="M71,62 L71,36 L73.5,30 L76,36 L76,62 Z" />

    <!-- 5. Holy Quran on Wooden Rihal (পবিত্র কুরআন ও রেহাল - নফল সালাতের তিলায়াত) -->
    <!-- Wooden Rihal (X-shaped stand) -->
    <path
        android:fillColor="#78350F"
        android:pathData="M34,88 L50,74 L66,88 L61,90 L50,80 L39,90 Z" />
    <path
        android:fillColor="#92400E"
        android:pathData="M50,74 L36,63 L41,60 L50,68 L59,60 L64,63 Z" />

    <!-- Open Holy Quran Book (Book Spine & Pages) -->
    <!-- Left Page -->
    <path
        android:fillColor="#FEF3C7"
        android:pathData="M50,68 L32,60 C32,60 38,56 50,60 Z" />
    <!-- Right Page -->
    <path
        android:fillColor="#FFFBEB"
        android:pathData="M50,68 L68,60 C68,60 62,56 50,60 Z" />

    <!-- Quran Ayah lines in Gold/Amber -->
    <path
        android:strokeColor="#F59E0B"
        android:strokeWidth="0.8"
        android:pathData="M36,60 Q42,58 48,61 M38,62 Q43,60 48,63 M52,61 Q58,58 64,60 M52,63 Q57,60 62,62" />

    <!-- 6. GLOSSY Specular Top Arc Reflection (কাঁচের ওপরের স্নিগ্ধ চকচকে রিফ্লেকশন) -->
    <path
        android:pathData="M16,46 C18,22 32,8 50,8 C68,8 82,22 84,46 C68,54 32,54 16,46 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="270"
                android:startColor="#65FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Bottom Crystal Rim Reflection -->
    <path
        android:fillColor="#35FFFFFF"
        android:pathData="M30,88 C38,92 62,92 70,88 C62,90 38,90 30,88 Z" />

    <!-- 7. Outer White Glass Bevel Ring -->
    <path
        android:pathData="M50,50m-44,0a44,44 0,1 1,88 0a44,44 0,1 1,-88 0"
        android:strokeColor="#C0FFFFFF"
        android:strokeWidth="1.2" />

    <!-- 8. Vibrant Themed Glass Rim -->
    <path
        android:pathData="M50,50m-42.5,0a42.5,42.5 0,1 1,85 0a42.5,42.5 0,1 1,-85 0"
        android:strokeColor="#F472B6"
        android:strokeWidth="1.8" />

    <!-- 9. Inner Soft Golden Glass Ring -->
    <path
        android:pathData="M50,50m-40.5,0a40.5,40.5 0,1 1,81 0a40.5,40.5 0,1 1,-81 0"
        android:strokeColor="#50FDE047"
        android:strokeWidth="0.8" />
</vector>
