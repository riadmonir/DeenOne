<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Outermost soft radiant aura -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A10B981" />
        </shape>
    </item>

    <!-- 2. Medium ambient glow halo -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="oval">
            <solid android:color="#3810B981" />
        </shape>
    </item>

    <!-- 3. Inner vibrant glow ring -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="#6010B981" />
        </shape>
    </item>

    <!-- 4. Ambient drop shadow for elevation (floating 3D effect) -->
    <item
        android:bottom="3dp"
        android:left="4dp"
        android:right="4dp"
        android:top="5dp">
        <shape android:shape="oval">
            <solid android:color="#35002812" />
        </shape>
    </item>

    <!-- 5. 3D Sphere Base Body with spherical radial gradient -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.35"
                android:centerY="0.30"
                android:gradientRadius="70%"
                android:startColor="#6EE7B7"
                android:centerColor="#10B981"
                android:endColor="#046C4E" />
        </shape>
    </item>

    <!-- 6. 3D Specular reflection / light gloss highlight -->
    <item
        android:bottom="9dp"
        android:left="5.5dp"
        android:right="8.5dp"
        android:top="5dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#EEFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
