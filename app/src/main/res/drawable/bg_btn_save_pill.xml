<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/btn_save_bg_start"
                android:endColor="@color/btn_save_bg_end"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/btn_save_border" />
        </shape>
    </item>
</ripple>
