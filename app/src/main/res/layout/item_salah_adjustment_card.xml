<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAdjustmentContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardMaxElevation="0dp"
    app:strokeColor="@color/border_card"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Waqt Name & Real-time Live Preview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/iconContainer"
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageView
                    android:id="@+id/ivWaqtIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_waqt_fajr" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWaqtTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ফজর"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOriginalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="মূল সময়: ০৪:৪৫ AM"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Adjusted Time Preview Badge -->
            <TextView
                android:id="@+id/tvAdjustedTimePreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/bg_badge_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="০৪:৫০ AM"
                android:textColor="@color/accent_mint"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/border_card" />

        <!-- Stepper Controller: [-] [ +5 মিনিট ] [+] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMinus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_cancel_pill"
                android:text="—"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOffsetBadge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/bg_card_secondary"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                android:text="০ মিনিট (ডিফল্ট)"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPlus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_cancel_pill"
                android:text="+"
                android:textColor="@color/accent_mint"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quick Adjustment Preset Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipMinus10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="6dp"
                    android:text="-10m"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/chipMinus5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="6dp"
                    android:text="-5m"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/chipZero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="6dp"
                    android:text="0m"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/chipPlus5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="6dp"
                    android:text="+5m"
                    android:textColor="@color/accent_mint"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/chipPlus10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="6dp"
                    android:text="+10m"
                    android:textColor="@color/accent_mint"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/chipPlus15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="6dp"
                    android:text="+15m"
                    android:textColor="@color/accent_mint"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/chipPlus20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="6dp"
                    android:text="+20m"
                    android:textColor="@color/accent_mint"
                    android:textSize="11.5sp" />

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
