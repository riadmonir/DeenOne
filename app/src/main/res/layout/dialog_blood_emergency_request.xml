<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/bg_main"
  android:orientation="vertical">

  <!-- Top App Bar: Back Arrow + Title (Left Aligned as in screenshot) -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@color/bg_top_bar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <FrameLayout
      android:id="@+id/btnCloseEmergencyReq"
      android:layout_width="38dp"
      android:layout_height="38dp"
      android:clickable="true"
      android:focusable="true">

      <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/text_primary" />
    </FrameLayout>

    <TextView
      android:id="@+id/tvEmergencyReqHeaderTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:text="রক্তের আবেদন"
      android:textColor="@color/text_primary"
      android:textSize="18sp"
      android:textStyle="bold" />
  </LinearLayout>

  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="36dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <!-- Field 1: রক্তের গ্রুপ -->
      <TextView
        android:id="@+id/lblReqBloodGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="রক্তের গ্রুপ"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

      <!-- Row 1: A+, A-, B+, B- -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/btnGroupAPos"
          android:layout_width="0dp"
          android:layout_height="42dp"
          android:layout_marginEnd="6dp"
          android:layout_weight="1"
          android:background="@drawable/bg_blood_group_pill_red"
          android:gravity="center"
          android:text="A+"
          android:textColor="#FFFFFF"
          android:textSize="14sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/btnGroupANeg"
          android:layout_width="0dp"
          android:layout_height="42dp"
          android:layout_marginEnd="6dp"
          android:layout_weight="1"
          android:background="@drawable/bg_blood_group_pill_dark"
          android:gravity="center"
          android:text="A-"
          android:textColor="#94A3B8"
          android:textSize="14sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/btnGroupBPos"
          android:layout_width="0dp"
          android:layout_height="42dp"
          android:layout_marginEnd="6dp"
          android:layout_weight="1"
          android:background="@drawable/bg_blood_group_pill_dark"
          android:gravity="center"
          android:text="B+"
          android:textColor="#94A3B8"
          android:textSize="14sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/btnGroupBNeg"
          android:layout_width="0dp"
          android:layout_height="42dp"
          android:layout_weight="1"
          android:background="@drawable/bg_blood_group_pill_dark"
          android:gravity="center"
          android:text="B-"
          android:textColor="#94A3B8"
          android:textSize="14sp"
          android:textStyle="bold" />
      </LinearLayout>

      <!-- Row 2: O+, O-, AB+, AB- -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/btnGroupOPos"
          android:layout_width="0dp"
          android:layout_height="42dp"
          android:layout_marginEnd="6dp"
          android:layout_weight="1"
          android:background="@drawable/bg_blood_group_pill_dark"
          android:gravity="center"
          android:text="O+"
          android:textColor="#94A3B8"
          android:textSize="14sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/btnGroupONeg"
          android:layout_width="0dp"
          android:layout_height="42dp"
          android:layout_marginEnd="6dp"
          android:layout_weight="1"
          android:background="@drawable/bg_blood_group_pill_dark"
          android:gravity="center"
          android:text="O-"
          android:textColor="#94A3B8"
          android:textSize="14sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/btnGroupABPos"
          android:layout_width="0dp"
          android:layout_height="42dp"
          android:layout_marginEnd="6dp"
          android:layout_weight="1"
          android:background="@drawable/bg_blood_group_pill_dark"
          android:gravity="center"
          android:text="AB+"
          android:textColor="#94A3B8"
          android:textSize="14sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/btnGroupABNeg"
          android:layout_width="0dp"
          android:layout_height="42dp"
          android:layout_weight="1"
          android:background="@drawable/bg_blood_group_pill_dark"
          android:gravity="center"
          android:text="AB-"
          android:textColor="#94A3B8"
          android:textSize="14sp"
          android:textStyle="bold" />
      </LinearLayout>

      <!-- Field 2: জরুরিতা -->
      <TextView
        android:id="@+id/lblUrgencyLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="জরুরিতা"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- Emergency Option (Selected by Default with Icon) -->
        <LinearLayout
          android:id="@+id/btnUrgencyEmergency"
          android:layout_width="0dp"
          android:layout_height="44dp"
          android:layout_marginEnd="8dp"
          android:layout_weight="1"
          android:background="@drawable/bg_blood_group_pill_red"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center"
          android:orientation="horizontal"
          android:paddingHorizontal="14dp">

          <ImageView
            android:id="@+id/ivUrgencyWarning"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_warning_triangle"
            app:tint="#FFFFFF" />

          <TextView
            android:id="@+id/tvUrgencyEmergencyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Emergency"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
        </LinearLayout>

        <!-- Normal Option -->
        <LinearLayout
          android:id="@+id/btnUrgencyNormal"
          android:layout_width="0dp"
          android:layout_height="44dp"
          android:layout_marginStart="8dp"
          android:layout_weight="1"
          android:background="@drawable/bg_blood_group_pill_dark"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center"
          android:orientation="horizontal"
          android:paddingHorizontal="14dp">

          <TextView
            android:id="@+id/tvUrgencyNormalText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Normal"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:textStyle="bold" />
        </LinearLayout>
      </LinearLayout>

      <!-- Field 3: রোগীর সমস্যা -->
      <TextView
        android:id="@+id/lblProblemReason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="রোগীর সমস্যা"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

      <LinearLayout
        android:id="@+id/layoutProblemReason"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_blood_input_box"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
          android:id="@+id/tvProblemReason"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="অপারেশন"
          android:textColor="@color/text_primary"
          android:textSize="14.5sp" />

        <ImageView
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:src="@drawable/ic_chevron_down"
          app:tint="@color/text_secondary" />
      </LinearLayout>

      <!-- Field 4: রক্তের পরিমাণ -->
      <TextView
        android:id="@+id/lblReqUnits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="রক্তের পরিমাণ"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

      <LinearLayout
        android:id="@+id/layoutUnitsNeeded"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_blood_input_box"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
          android:id="@+id/tvUnitsNeeded"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="১ ব্যাগ"
          android:textColor="@color/text_primary"
          android:textSize="14.5sp" />

        <ImageView
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:src="@drawable/ic_chevron_down"
          app:tint="@color/text_secondary" />
      </LinearLayout>

      <!-- Field 5: রক্তদানের তারিখ -->
      <TextView
        android:id="@+id/lblNeededDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="রক্তদানের তারিখ"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

      <FrameLayout
        android:id="@+id/layoutNeededDate"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_blood_input_box"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp">

        <TextView
          android:id="@+id/tvNeededDate"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="center_vertical"
          android:hint="YYYY-MM-DD"
          android:textColor="@color/text_primary"
          android:textColorHint="@color/text_secondary"
          android:textSize="14.5sp" />
      </FrameLayout>

      <!-- Field 6: রক্তদানের সময় -->
      <TextView
        android:id="@+id/lblDonationTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="রক্তদানের সময়"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

      <EditText
        android:id="@+id/etDonationTime"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_blood_input_box"
        android:hint="যেমন: সকাল ১০টা"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14.5sp" />

      <!-- Field 7: হাসপাতাল ও ঠিকানা -->
      <TextView
        android:id="@+id/lblHospitalAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="হাসপাতাল ও ঠিকানা"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_blood_input_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="10dp">

        <EditText
          android:id="@+id/etHospitalAddress"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:background="@null"
          android:hint="যেমন: ঢাকা মেডিকেল কলেজ হাস..."
          android:inputType="text"
          android:singleLine="true"
          android:textColor="@color/text_primary"
          android:textColorHint="@color/text_secondary"
          android:textSize="14.5sp" />

        <FrameLayout
          android:id="@+id/btnGpsLocation"
          android:layout_width="34dp"
          android:layout_height="34dp"
          android:clickable="true"
          android:focusable="true">

          <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_gps_fixed"
            app:tint="#F43F5E" />
        </FrameLayout>
      </LinearLayout>

      <!-- Field 8: যোগাযোগের নম্বর -->
      <TextView
        android:id="@+id/lblContactPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="যোগাযোগের নম্বর"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

      <EditText
        android:id="@+id/etContactPhone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_blood_input_box"
        android:hint="01XXXXXXXXX"
        android:inputType="phone"
        android:paddingHorizontal="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14.5sp" />

      <!-- Field 9: অতিরিক্ত নোট (ঐচ্ছিক) -->
      <TextView
        android:id="@+id/lblNotes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="অতিরিক্ত নোট (ঐচ্ছিক)"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

      <EditText
        android:id="@+id/etNotes"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_blood_input_box"
        android:gravity="top|start"
        android:hint="জরুরী যোগাযোগের জন্য বিস্তারিত লিখুন"
        android:inputType="textMultiLine"
        android:minLines="3"
        android:padding="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14.5sp" />

      <!-- Bottom Confirm Button: আবেদন নিশ্চিত করুন -->
      <FrameLayout
        android:id="@+id/btnConfirmRequest"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="26dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_blood_confirm_btn_red"
        android:clickable="true"
        android:focusable="true">

        <TextView
          android:id="@+id/tvConfirmRequestText"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:text="আবেদন নিশ্চিত করুন"
          android:textColor="#FFFFFF"
          android:textSize="16sp"
          android:textStyle="bold" />
      </FrameLayout>

    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</LinearLayout>
