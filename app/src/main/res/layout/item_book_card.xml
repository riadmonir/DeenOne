<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginBottom="12dp"
  app:cardBackgroundColor="@color/bg_card"
  app:cardCornerRadius="16dp"
  app:cardElevation="2dp"
  app:strokeColor="@color/border_subtle"
  app:strokeWidth="1dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

      <!-- Book Cover Placeholder / Icon Box -->
      <FrameLayout
        android:layout_width="56dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_card_secondary"
        android:padding="4dp">

        <ImageView
          android:id="@+id/ivBookIcon"
          android:layout_width="36dp"
          android:layout_height="36dp"
          android:layout_gravity="center"
          android:src="@drawable/ic_feat_book"
          app:tint="@color/accent_mint"
          android:contentDescription="বইয়ের আইকন" />

        <TextView
          android:id="@+id/tvBookLangBadge"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="bottom|center_horizontal"
          android:background="@drawable/bg_badge_pill"
          android:paddingHorizontal="4dp"
          android:paddingVertical="1dp"
          android:text="বাংলা"
          android:textColor="@color/accent_mint"
          android:textSize="9sp"
          android:textStyle="bold" />
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal">

          <TextView
            android:id="@+id/tvBookCategoryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="তাফসীর"
            android:textColor="@color/accent_mint"
            android:textSize="10.5sp"
            android:textStyle="bold" />

          <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

          <ImageView
            android:id="@+id/ivBookFavoriteBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_badge_pill"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_favorite_border"
            app:tint="@color/text_secondary"
            android:contentDescription="বুকমার্ক" />
        </LinearLayout>

        <TextView
          android:id="@+id/tvBookTitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:ellipsize="end"
          android:maxLines="2"
          android:text="বইয়ের পূর্ণাঙ্গ নাম"
          android:textColor="@color/text_primary"
          android:textSize="15sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/tvBookAuthor"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:text="লেখক: ইমাম ইবনে কাসীর (রহ.)"
          android:textColor="@color/text_secondary"
          android:textSize="12sp" />
      </LinearLayout>
    </LinearLayout>

    <!-- Book Description -->
    <TextView
      android:id="@+id/tvBookDescription"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:ellipsize="end"
      android:maxLines="2"
      android:text="বইয়ের সংক্ষিপ্ত পরিচিতি ও বিষয়বস্তু..."
      android:textColor="@color/text_secondary"
      android:textSize="12sp"
      android:lineSpacingExtra="2dp" />

    <!-- Meta Info (Pages, Size, Source) -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/tvBookPagesAndSize"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="৮২০ পৃষ্ঠা • ১৮.৪ MB"
        android:textColor="@color/text_secondary"
        android:textSize="11.5sp" />

      <TextView
        android:id="@+id/tvBookVerifiedSource"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="নির্ভরযোগ্য উৎস"
        android:textColor="@color/accent_mint"
        android:textSize="11sp"
        android:textStyle="bold" />
    </LinearLayout>

    <!-- Download Progress Bar (visible during download) -->
    <LinearLayout
      android:id="@+id/layoutDownloadProgress"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:orientation="vertical"
      android:visibility="gone">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/tvDownloadStatusText"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="ডাউনলোড হচ্ছে..."
          android:textColor="@color/accent_mint"
          android:textSize="11.5sp" />

        <TextView
          android:id="@+id/tvDownloadPercent"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="৪৫%"
          android:textColor="@color/accent_mint"
          android:textSize="11.5sp"
          android:textStyle="bold" />
      </LinearLayout>

      <ProgressBar
        android:id="@+id/progressBarBookDownload"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/accent_mint"
        android:progressBackgroundTint="@color/bg_card_secondary" />
    </LinearLayout>

    <!-- Action Button (Read / Download / Continue) -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:orientation="horizontal">

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBookAction"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:backgroundTint="@color/accent_mint"
        android:text="বইটি ডাউনলোড করুন"
        android:textColor="@color/bg_main"
        android:textSize="13sp"
        android:textStyle="bold"
        app:cornerRadius="12dp" />
    </LinearLayout>

  </LinearLayout>

</com.google.android.material.card.MaterialCardView>
