<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp">

            <!-- Top Circular Book Icon -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_dialog_circle_teal">

                <ImageView
                    android:id="@+id/ivDialogHeaderIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_open_book_dialog"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <!-- Dialog Title -->
            <TextView
                android:id="@+id/tvQuranDownloadTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="কুরআন ডাউনলোড করুন"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Dialog Subtitle Description -->
            <TextView
                android:id="@+id/tvQuranDownloadSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="কুরআন পড়ার জন্য প্রথমে ডাটাবেস ডাউনলোড করতে হবে"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Size Pill Container -->
            <LinearLayout
                android:id="@+id/layoutSizeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_dialog_pill_box"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="14dp"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvDownloadSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="আকার: ৬.৮৭ MB"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Download Progress Bar Container (Hidden until downloading) -->
            <LinearLayout
                android:id="@+id/layoutDownloadProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvDownloadProgressStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/tvDownloadProgressPercent"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="ডাউনলোড হচ্ছে..."
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDownloadProgressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="০%"
                        android:textColor="@color/accent_teal"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressBarDownload"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    app:indicatorColor="@color/accent_teal"
                    app:trackColor="@color/border_card"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />
            </LinearLayout>

            <!-- Primary Action: Download Button -->
            <FrameLayout
                android:id="@+id/btnStartQuranDownload"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_dialog_download"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivDownloadBtnIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_download_arrow"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/tvDownloadBtnText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ডাউনলোড"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Secondary Action: Cancel Button -->
            <TextView
                android:id="@+id/btnCancelQuranDownload"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="বাতিল করুন"
                android:textColor="@color/text_secondary"
                android:textSize="13.5sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
