<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutCommentRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/layoutCommentAuthorAvatar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/circle_progress_bg"
        android:backgroundTint="@color/bg_badge_pill">

        <ImageView
            android:id="@+id/ivCommentAuthorAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person"
            app:tint="@color/accent_mint" />

        <TextView
            android:id="@+id/tvCommentAuthorInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/accent_mint"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_card_surface"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCommentAuthorName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="মুহাম্মদ হাসিব"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCommentTimeAgo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="৫ মিনিট আগে"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Reply Context Badge (Shown if this is a reply to another comment) -->
        <TextView
            android:id="@+id/tvReplyToBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_badge_pill"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="↳ @আব্দুল্লাহ"
            android:textColor="@color/accent_mint"
            android:textSize="10.5sp"
            android:visibility="gone" />

        <!-- Comment Content -->
        <TextView
            android:id="@+id/tvCommentContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="আমিন ছুম্মা আমিন। আল্লাহ আমাদের সবাইকে এই দোয়ার উপর আমল করার তৌফিক দান করুন।"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Footer Actions (Reply button) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBtnReplyComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingEnd="12dp"
                android:text="উত্তর দিন"
                android:textColor="@color/accent_mint"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>