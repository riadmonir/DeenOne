<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginBottom="12dp"
  app:cardBackgroundColor="@color/bg_card"
  app:cardCornerRadius="16dp"
  app:cardElevation="0dp"
  app:strokeColor="@color/border_card"
  app:strokeWidth="1dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Row: Collection Pill + Action Buttons -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <!-- Collection Pill -->
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_badge_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp">

        <TextView
          android:id="@+id/tvHadithCollectionPill"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:singleLine="true"
          android:text="সহীহ আল-বুখারী: ১"
          android:textColor="@color/accent_mint"
          android:textSize="11.5sp"
          android:textStyle="bold" />
      </LinearLayout>

      <!-- Action Buttons: Copy, Share, Bookmark -->
      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/btnCopyHadith"
          android:layout_width="32dp"
          android:layout_height="32dp"
          android:layout_marginEnd="6dp"
          android:background="@drawable/bg_badge_pill"
          android:clickable="true"
          android:contentDescription="হাদিস কপি করুন"
          android:focusable="true"
          android:padding="7dp"
          android:src="@drawable/ic_copy"
          app:tint="@color/text_secondary" />

        <ImageView android:id="@+id/btnShareHadith"
          android:layout_width="32dp"
          android:layout_height="32dp"
          android:layout_marginEnd="6dp"
          android:background="@drawable/bg_badge_pill"
          android:clickable="true"
          android:contentDescription="হাদিস শেয়ার করুন"
          android:focusable="true"
          android:padding="7dp"
          android:src="@drawable/ic_share"
          app:tint="@color/accent_mint" />

        <ImageView
          android:id="@+id/btnBookmarkHadith"
          android:layout_width="32dp"
          android:layout_height="32dp"
          android:background="@drawable/bg_badge_pill"
          android:clickable="true"
          android:contentDescription="বুকমার্ক করুন"
          android:focusable="true"
          android:padding="7dp"
          android:src="@drawable/ic_bookmark"
          app:tint="@color/text_secondary" />
      </LinearLayout>
    </LinearLayout>

    <!-- Chapter Title -->
    <TextView
      android:id="@+id/tvHadithChapter"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:text="অধ্যায়: কাজের ফলাফল নিয়তের ওপর নির্ভরশীল"
      android:textColor="@color/text_primary"
      android:textSize="13.5sp"
      android:textStyle="bold" />

    <!-- Narrator -->
    <TextView
      android:id="@+id/tvHadithNarrator"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="3dp"
      android:text="বর্ণনাকারী: হযরত উমর ইবনুল খাত্তাব (রা.)"
      android:textColor="@color/text_secondary"
      android:textSize="11.5sp" />

    <!-- Arabic Text -->
    <TextView
      android:id="@+id/tvHadithArabic"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:background="@drawable/bg_card_secondary"
      android:gravity="end"
      android:lineSpacingExtra="6dp"
      android:padding="12dp"
      android:text="إِنَّمَا الأَعْمَالُ بِالنِّيَّاتِ، وَإِنَّمَا لِكُلِّ امْرِئٍ مَا نَوَى..."
      android:textColor="@color/accent_mint"
      android:textDirection="rtl"
      android:textSize="18sp"
      android:textStyle="bold" />

    <!-- Translation Text (Bengali / English / Urdu) -->
    <TextView
      android:id="@+id/tvHadithTranslation"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:lineSpacingExtra="4dp"
      android:text="নিশ্চয়ই সকল কাজ নিয়তের ওপর নির্ভরশীল। প্রত্যেক ব্যক্তি তাই পাবে যার সে নিয়ত করেছে..."
      android:textColor="@color/text_primary"
      android:textSize="13sp" />

    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginTop="12dp"
      android:layout_marginBottom="8dp"
      android:background="@color/border_card" />

    <!-- Bottom Row: Authenticity Grade & Source (Zero Overlap Guaranteed) -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <!-- Grade Badge -->
      <TextView
        android:id="@+id/tvHadithGrade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_pill"
        android:backgroundTint="@color/bg_badge_pill"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="সহীহ"
        android:textColor="@color/accent_mint"
        android:textSize="11sp"
        android:textStyle="bold" />

      <!-- Spacer -->
      <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

      <!-- Reference Source -->
      <TextView
        android:id="@+id/tvHadithSource"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:text="সহীহ বুখারী: ১, সহীহ মুসলিম: ১৯০৭"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />
    </LinearLayout>

  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
