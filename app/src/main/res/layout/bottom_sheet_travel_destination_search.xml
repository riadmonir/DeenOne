<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/bg_main"
  android:orientation="vertical">

  <!-- Top Action Bar -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_top_bar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <ImageButton android:id="@+id/btnCloseDestSearch"
      android:layout_width="38dp"
      android:layout_height="38dp"
      android:background="@drawable/bg_badge_pill"
      android:contentDescription="বন্ধ করুন"
      android:src="@drawable/ic_close"
      app:tint="@color/accent_mint" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/tvDestSearchHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ভ্রমণ গন্তব্য অনুসন্ধান ও নির্বাচন"
        android:textColor="@color/text_primary"
          android:layout_gravity="center"
        android:textSize="17sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/tvDestSearchHeaderSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_gravity="center"
        android:text="বিশ্বের যেকোনো স্থান, শহর বা জেলা ম্যাপ থেকে নির্বাচন করুন"
        android:textColor="@color/text_secondary"
        android:textSize="11.5sp" />
    </LinearLayout>

    <ImageView
      android:id="@+id/btnDestGpsAutoPin"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:background="@drawable/bg_badge_pill"
      android:clickable="true"
      android:focusable="true"
      android:padding="8dp"
      android:src="@drawable/ic_gps_fixed"
      app:tint="@color/accent_mint" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp">

    <!-- Search Input Box -->
    <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="50dp"
      app:cardBackgroundColor="@color/bg_card"
      app:cardCornerRadius="14dp"
      app:cardElevation="0dp"
      app:strokeColor="@color/border_card"
      app:strokeWidth="1.2dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:src="@drawable/ic_search"
          app:tint="@color/accent_mint" />

        <EditText
          android:id="@+id/etTravelDestSearch"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_marginStart="10dp"
          android:layout_weight="1"
          android:background="@null"
          android:hint="শহর, জেলা, দেশ বা ম্যাপের ঠিকানা লিখুন..."
          android:imeOptions="actionSearch"
          android:inputType="textCapWords"
          android:singleLine="true"
          android:textColor="@color/text_primary"
          android:textColorHint="@color/text_secondary"
          android:textSize="14sp" />

        <ImageView
          android:id="@+id/btnClearDestSearch"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:clickable="true"
          android:focusable="true"
          android:src="@drawable/ic_close"
          android:visibility="gone"
          app:tint="@color/text_secondary" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Filter Category Tabs -->
    <HorizontalScrollView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:clipToPadding="false"
      android:overScrollMode="never"
      android:scrollbars="none">

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/chipFilterAll"
          android:layout_width="wrap_content"
          android:layout_height="32dp"
          android:layout_marginEnd="6dp"
          android:background="@drawable/bg_badge_pill_active"
          android:gravity="center"
          android:paddingHorizontal="14dp"
          android:text="সকল স্থান"
          android:textColor="@color/accent_mint"
          android:textSize="12sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/chipFilterHoly"
          android:layout_width="wrap_content"
          android:layout_height="32dp"
          android:layout_marginEnd="6dp"
          android:background="@drawable/bg_badge_pill"
          android:gravity="center"
          android:paddingHorizontal="14dp"
          android:text="পবিত্র স্থান ও উমরাহ"
          android:textColor="@color/text_primary"
          android:textSize="12sp" />

        <TextView
          android:id="@+id/chipFilterBangladesh"
          android:layout_width="wrap_content"
          android:layout_height="32dp"
          android:layout_marginEnd="6dp"
          android:background="@drawable/bg_badge_pill"
          android:gravity="center"
          android:paddingHorizontal="14dp"
          android:text="বাংলাদেশের জেলাসমূহ"
          android:textColor="@color/text_primary"
          android:textSize="12sp" />

        <TextView
          android:id="@+id/chipFilterInternational"
          android:layout_width="wrap_content"
          android:layout_height="32dp"
          android:background="@drawable/bg_badge_pill"
          android:gravity="center"
          android:paddingHorizontal="14dp"
          android:text="আন্তর্জাতিক শহর"
          android:textColor="@color/text_primary"
          android:textSize="12sp" />
      </LinearLayout>
    </HorizontalScrollView>

    <!-- Search Status Indicator -->
    <LinearLayout
      android:id="@+id/layoutSearchStatus"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">

      <ProgressBar
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:indeterminateTint="@color/accent_mint" />

      <TextView
        android:id="@+id/tvSearchStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="ম্যাপ থেকে স্থান অনুসন্ধান করা হচ্ছে..."
        android:textColor="@color/accent_mint"
        android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Results RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/rvDestSearchResults"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="8dp"
      android:layout_weight="1"
      android:clipToPadding="false"
      android:paddingBottom="24dp" />

  </LinearLayout>
</LinearLayout>
