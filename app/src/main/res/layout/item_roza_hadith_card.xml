<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_card"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top-Left Hadith Pill Badge -->
        <TextView
            android:id="@+id/tvHadithBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_roza_hadith_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="হাদিস- ১৮৯১"
            android:textColor="@color/accent_teal"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Arabic Text (Right-aligned, RTL) -->
        <TextView
            android:id="@+id/tvHadithArabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/text_primary"
            android:textDirection="rtl"
            android:textSize="16sp"
            tools:text="حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ حَدَّثَنَا إِسْمَاعِيلُ بْنُ جَعْفَرٍ..." />

        <!-- Bengali / English Translation (Left-aligned, LTR) -->
        <TextView
            android:id="@+id/tvHadithTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="start"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/text_secondary"
            android:textDirection="ltr"
            android:textSize="13.5sp"
            tools:text="তালহা ইবনু 'উবায়দুল্লাহ (রাঃ) বর্ণিত এলোমেলো চুলসহ একজন গ্রাম্য আরব রসূল (সাল্লাল্লাহু 'আলাইহি ওয়া সাল্লাম)-এর নিকট এলেন..." />

        <!-- Bottom Action: Favorite (Heart Icon + প্রিয় তালিকা) -->
        <LinearLayout
            android:id="@+id/btnFavoriteAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivFavoriteIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Favorite Icon"
                android:src="@drawable/ic_heart_outline"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvFavoriteLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="প্রিয় তালিকা"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
