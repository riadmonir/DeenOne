<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_card"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Title + Actions (Play Audio, Copy, Share) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Title & Arabic Name Badge -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvKalimaTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="১ম কালিমা: তাইয়্যেবা"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvKalimaSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="1. Kalima Tayyibah"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Action Buttons: Audio, Copy, Share -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btnPlayKalimaAudio"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="@color/bg_badge_pill"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivKalimaPlayIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_play_arrow"
                        app:tint="@color/accent_mint" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnCopyKalima"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_pill"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivCopyIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/text_secondary" />
                </FrameLayout>

                <FrameLayout android:id="@+id/btnShareKalima"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_badge_pill"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_share"
                        app:tint="@color/accent_mint" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Main Display Frame: Arabic Calligraphy Box -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_secondary"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <TextView
                android:id="@+id/tvKalimaArabic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4"
                android:text="لَا إِلٰهَ إِلَّا اللهُ مُحَمَّدٌ رَسُولُ اللهِ"
                android:textColor="@color/accent_mint"
                android:textSize="22sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Bengali Pronunciation Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="@color/bg_badge_pill"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tvKalimaPronunciationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="উচ্চারণ:"
                android:textColor="@color/accent_mint"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvKalimaPronunciationBn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="3dp"
                android:text="লা ইলাহা ইল্লাল্লাহু মুহাম্মাদুর রাসুলুল্লাহ।"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />
        </LinearLayout>

        <!-- Bengali Meaning Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/tvKalimaMeaningBnLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="বাংলা অর্থ:"
                android:textColor="@color/accent_mint"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvKalimaMeaningBn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="3dp"
                android:text="আল্লাহ ব্যতীত কোনো সত্য উপাস্য নেই, মুহাম্মদ ﷺ আল্লাহর প্রেরিত রাসূল।"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />
        </LinearLayout>

        <!-- English Translation Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/tvKalimaMeaningEnLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ইংরেজি অনুবাদ:"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvKalimaMeaningEn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:text="There is no god worthy of worship except Allah, and Muhammad (pbuh) is the Messenger of Allah."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Shariah Significance Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="@color/bg_badge_pill"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tvKalimaSignificanceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="শরিয়াহ তাৎপর্য ও ফজিলত:"
                android:textColor="@color/accent_gold"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvKalimaSignificance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:text="ইসলামের মূল ভিত্তি ও তাওহীদের চূড়ান্ত সাক্ষ্য। এই কালিমা অন্তরে বিশ্বাস ও মুখে স্বীকারের মাধ্যমে একজন মানুষ ইসলামে প্রবেশ করে।"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
