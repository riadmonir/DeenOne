<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_top_bar"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <FrameLayout android:id="@+id/btnBackRakatTable"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circular_counter"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/accent_mint" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="৫ ওয়াক্ত নামাজের রাকাত সমূহ"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <FrameLayout android:id="@+id/btnShareRakatTable"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circular_counter"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_share"
                app:tint="@color/accent_mint" />
        </FrameLayout>
    </LinearLayout>

    <!-- Scrollable Content Area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. TOP MATRIX CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRakatMatrix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <!-- Row 1: ফজর -->
                    <LinearLayout
                        android:id="@+id/rowFajrMatrix"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:src="@drawable/ic_waqt_art_fajr" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="ফজর"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- Circles: 2 Green, 2 Red -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/circleFajrSunnah"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_rakat_circle_green"
                                android:gravity="center"
                                android:text="২"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/circleFajrFarz"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_rakat_circle_red"
                                android:gravity="center"
                                android:text="২"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_card" />

                    <!-- Row 2: যোহর -->
                    <LinearLayout
                        android:id="@+id/rowDhuhrMatrix"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:src="@drawable/ic_waqt_art_dhuhr" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="যোহর"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- Circles: 4 Green, 4 Red, 2 Green, 2 Purple -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/circleDhuhrSunnah1"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_rakat_circle_green"
                                android:gravity="center"
                                android:text="৪"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/circleDhuhrFarz"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginStart="7dp"
                                android:background="@drawable/bg_rakat_circle_red"
                                android:gravity="center"
                                android:text="৪"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/circleDhuhrSunnah2"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginStart="7dp"
                                android:background="@drawable/bg_rakat_circle_green"
                                android:gravity="center"
                                android:text="২"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/circleDhuhrNafl"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginStart="7dp"
                                android:background="@drawable/bg_rakat_circle_purple"
                                android:gravity="center"
                                android:text="২"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_card" />

                    <!-- Row 3: জুম'আ -->
                    <LinearLayout
                        android:id="@+id/rowJumuahMatrix"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:src="@drawable/ic_waqt_art_jumuah" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="জুম'আ"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- Circles: 4 Green, 2 Red, 4 Green, 2 Green, 2 Purple -->
                        <HorizontalScrollView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:overScrollMode="never"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/circleJumuahKablal"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/bg_rakat_circle_green"
                                    android:gravity="center"
                                    android:text="৪"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/circleJumuahFarz"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/bg_rakat_circle_red"
                                    android:gravity="center"
                                    android:text="২"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/circleJumuahBadal"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/bg_rakat_circle_green"
                                    android:gravity="center"
                                    android:text="৪"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/circleJumuahSunnahExtra"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/bg_rakat_circle_green"
                                    android:gravity="center"
                                    android:text="২"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/circleJumuahNafl"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/bg_rakat_circle_purple"
                                    android:gravity="center"
                                    android:text="২"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </HorizontalScrollView>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_card" />

                    <!-- Row 4: আসর -->
                    <LinearLayout
                        android:id="@+id/rowAsrMatrix"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:src="@drawable/ic_waqt_art_asr" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="আসর"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- Circles: 4 Light Blue, 4 Red -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/circleAsrSunnah"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_rakat_circle_blue"
                                android:gravity="center"
                                android:text="৪"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/circleAsrFarz"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_rakat_circle_red"
                                android:gravity="center"
                                android:text="৪"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_card" />

                    <!-- Row 5: মাগরিব -->
                    <LinearLayout
                        android:id="@+id/rowMaghribMatrix"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:src="@drawable/ic_waqt_art_maghrib" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="মাগরিব"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- Circles: 3 Red, 2 Green, 2 Purple -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/circleMaghribFarz"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_rakat_circle_red"
                                android:gravity="center"
                                android:text="৩"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/circleMaghribSunnah"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginStart="7dp"
                                android:background="@drawable/bg_rakat_circle_green"
                                android:gravity="center"
                                android:text="২"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/circleMaghribNafl"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginStart="7dp"
                                android:background="@drawable/bg_rakat_circle_purple"
                                android:gravity="center"
                                android:text="২"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_card" />

                    <!-- Row 6: এশা -->
                    <LinearLayout
                        android:id="@+id/rowIshaMatrix"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:src="@drawable/ic_waqt_art_isha" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="এশা"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- Circles: 4 Blue, 4 Red, 2 Green, 2 Purple, 3 Orange, 2 Purple -->
                        <HorizontalScrollView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:overScrollMode="never"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/circleIshaSunnah1"
                                    android:layout_width="31dp"
                                    android:layout_height="31dp"
                                    android:background="@drawable/bg_rakat_circle_blue"
                                    android:gravity="center"
                                    android:text="৪"
                                    android:textColor="#FFFFFF"
                                    android:textSize="13.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/circleIshaFarz"
                                    android:layout_width="31dp"
                                    android:layout_height="31dp"
                                    android:layout_marginStart="5dp"
                                    android:background="@drawable/bg_rakat_circle_red"
                                    android:gravity="center"
                                    android:text="৪"
                                    android:textColor="#FFFFFF"
                                    android:textSize="13.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/circleIshaSunnah2"
                                    android:layout_width="31dp"
                                    android:layout_height="31dp"
                                    android:layout_marginStart="5dp"
                                    android:background="@drawable/bg_rakat_circle_green"
                                    android:gravity="center"
                                    android:text="২"
                                    android:textColor="#FFFFFF"
                                    android:textSize="13.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/circleIshaNafl1"
                                    android:layout_width="31dp"
                                    android:layout_height="31dp"
                                    android:layout_marginStart="5dp"
                                    android:background="@drawable/bg_rakat_circle_purple"
                                    android:gravity="center"
                                    android:text="২"
                                    android:textColor="#FFFFFF"
                                    android:textSize="13.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/circleIshaWitr"
                                    android:layout_width="31dp"
                                    android:layout_height="31dp"
                                    android:layout_marginStart="5dp"
                                    android:background="@drawable/bg_rakat_circle_orange"
                                    android:gravity="center"
                                    android:text="৩"
                                    android:textColor="#FFFFFF"
                                    android:textSize="13.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/circleIshaNafl2"
                                    android:layout_width="31dp"
                                    android:layout_height="31dp"
                                    android:layout_marginStart="5dp"
                                    android:background="@drawable/bg_rakat_circle_purple"
                                    android:gravity="center"
                                    android:text="২"
                                    android:textColor="#FFFFFF"
                                    android:textSize="13.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </HorizontalScrollView>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Middle Separator -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="18dp"
                android:background="@color/border_card" />

            <!-- 2. BOTTOM LEGEND CARDS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. ফরয Legend -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLegendFarz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="104dp"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_legend_pill_red"
                            android:gravity="center"
                            android:text="ফরয"
                            android:textColor="#FFFFFF"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="2dp"
                            android:text="যে সকল নামাজ মুসলিমদের জন্য পড়া বাধ্যতামূলক।"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. ওয়াজিব Legend -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLegendWajib"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="104dp"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_legend_pill_orange"
                            android:gravity="center"
                            android:text="ওয়াজিব"
                            android:textColor="#FFFFFF"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="2dp"
                            android:text="প্রয়োজনীয় নামাজ যা ফরজ নামাজের পরে গুরুত্বের দিক থেকে আসে।"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. সুন্নতে মুয়াক্কাদা Legend -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLegendSunnahMuakkadah"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="104dp"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_legend_pill_green"
                            android:gravity="center"
                            android:lineSpacingExtra="1dp"
                            android:text="সুন্নতে\nমুয়াক্কাদা"
                            android:textColor="#FFFFFF"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="2dp"
