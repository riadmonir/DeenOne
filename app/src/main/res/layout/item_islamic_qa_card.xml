<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginBottom="12dp"
  app:cardBackgroundColor="@color/bg_card"
  app:cardCornerRadius="16dp"
  app:cardElevation="0dp"
  app:strokeColor="@color/border_card"
  app:strokeWidth="1.2dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header with Category Badge & Copy -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/tvItemCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_badge_pill"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="সালাত ও তাহারাত"
        android:textColor="@color/accent_mint"
        android:textSize="11sp"
        android:textStyle="bold" />

      <ImageView
        android:id="@+id/btnCopyQA"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="কপি করুন"
        android:src="@drawable/ic_copy"
        app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Question -->
    <TextView
      android:id="@+id/tvItemQuestion"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:lineSpacingExtra="3dp"
      android:text="ভ্রমণে কত কিলোমিটার দূরত্বে গেলে কসর নামাজ পড়তে হয়?"
      android:textColor="@color/text_primary"
      android:textSize="14.5sp"
      android:textStyle="bold" />

    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginTop="10dp"
      android:layout_marginBottom="10dp"
      android:background="@color/border_card" />

    <!-- Verified Answer -->
    <TextView
      android:id="@+id/tvItemAnswer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:lineSpacingExtra="4dp"
      android:textColor="@color/text_secondary"
      android:textSize="13sp" />

    <!-- Scholar / Fatwa Board & Reference -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:background="@color/bg_card_secondary"
      android:orientation="vertical"
      android:padding="10dp">

      <TextView
        android:id="@+id/tvItemScholar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="দারুল উলুম দেওবন্দ ফতোয়া বিভাগ"
        android:textColor="@color/accent_mint"
        android:textSize="11.5sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/tvItemReference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="সূত্র: ফাতাওয়া হিন্দিয়া ১/১৩৯"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

      <TextView
        android:id="@+id/tvItemDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="তারিখ: ২০২৩-০৪-১২"
        android:textColor="#6B7280"
        android:textSize="10sp" />
    </LinearLayout>

    <!-- Actions Row: Source URL & Share -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:orientation="horizontal">

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenSourceUrl"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:text="মূল সোর্স দেখুন"
        android:textColor="@color/accent_mint"
        android:textSize="11.5sp"
        app:cornerRadius="8dp"
        app:strokeColor="@color/accent_mint" />

      <com.google.android.material.button.MaterialButton android:id="@+id/btnShareQA"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:text="শেয়ার করুন"
        android:textColor="@color/text_secondary"
        android:textSize="11.5sp"
        app:cornerRadius="8dp"
        app:strokeColor="@color/border_card" />
    </LinearLayout>
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>