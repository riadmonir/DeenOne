<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_oled_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Dhikr Name & Reset -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvWidgetZikrName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btnWidgetTasbihReset"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="সুবহানাল্লাহ"
            android:textColor="#34D399"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnWidgetTasbihReset"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_badge_pill"
            android:padding="3dp"
            android:src="@drawable/ic_refresh" />
    </RelativeLayout>

    <!-- Interactive Tasbih Center Count + Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Giant Counter Number -->
        <TextView
            android:id="@+id/tvWidgetTasbihCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="৩৩"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <!-- Tap +1 Count Button -->
        <TextView
            android:id="@+id/btnWidgetTasbihCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_widget_pill_mint"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="+ ১"
            android:textColor="#022C22"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="গণনা করতে +১ বাটনে ট্যাপ করুন"
        android:textColor="#64748B"
        android:textSize="10sp" />
</LinearLayout>
