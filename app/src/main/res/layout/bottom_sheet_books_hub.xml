<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/bg_main"
  android:orientation="vertical">

  <!-- Top App Bar with Islamic Book Library Title -->
  <RelativeLayout
    android:id="@+id/layoutTopHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <FrameLayout
      android:id="@+id/btnCloseBooksHub"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:layout_alignParentStart="true"
      android:layout_centerVertical="true"
      android:background="@drawable/bg_circular_counter"
      android:backgroundTint="@color/bg_badge_pill"
      android:clickable="true"
      android:focusable="true">

      <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/accent_mint" />
    </FrameLayout>

    <!-- Center: Islamic Book Library Title in place of DeenOne logo -->
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_centerInParent="true"
      android:gravity="center"
      android:orientation="vertical">

      <TextView
        android:id="@+id/tvBooksHubMainTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ইসলামিক বই লাইব্রেরি"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/tvBooksHubMainSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="প্রামাণ্য ইসলামিক কিতাব সম্ভার"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />
    </LinearLayout>

    <!-- Right: View Mode Toggle (Grid/List) & Refresh Catalog Button -->
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_alignParentEnd="true"
      android:layout_centerVertical="true"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <!-- View Mode Toggle (Grid / List) -->
      <FrameLayout
        android:id="@+id/btnToggleViewMode"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_badge_pill"
        android:clickable="true"
        android:focusable="true">

        <TextView
          android:id="@+id/tvToggleViewModeIcon"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:text="⊞"
          android:textColor="@color/text_primary"
          android:textSize="16sp" />
      </FrameLayout>

      <!-- Refresh Button -->
      <FrameLayout
        android:id="@+id/btnRefreshBooks"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_badge_pill"
        android:clickable="true"
        android:focusable="true">

        <ImageView
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:layout_gravity="center"
          android:src="@drawable/ic_refresh"
          app:tint="@color/accent_mint" />
      </FrameLayout>
    </LinearLayout>
  </RelativeLayout>

  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingHorizontal="16dp"
      android:paddingTop="12dp"
      android:paddingBottom="24dp">

      <!-- Offline Status Banner -->
      <LinearLayout
        android:id="@+id/layoutOfflineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_badge_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text=""
          android:textSize="14sp" />

        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:layout_weight="1"
          android:text="অফলাইন মোড: ইন্টারনেটের অনুপস্থিতিতে সংরক্ষিত বই ও ক্যাশ প্রদর্শন করা হচ্ছে।"
          android:textColor="@color/accent_mint"
          android:textSize="11.5sp"
          android:textStyle="bold" />
      </LinearLayout>

      <!-- Language, Favorites & Downloads Tabs -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/btnBookLangAll"
          android:layout_width="0dp"
          android:layout_height="34dp"
          android:layout_marginEnd="4dp"
          android:layout_weight="1"
          android:background="@drawable/bg_btn_mint_pill"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center"
          android:text="সকল"
          android:textColor="@color/bg_main"
          android:textSize="11.5sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/btnBookLangBn"
          android:layout_width="0dp"
          android:layout_height="34dp"
          android:layout_marginEnd="4dp"
          android:layout_weight="1"
          android:background="@drawable/bg_badge_pill"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center"
          android:text="বাংলা"
          android:textColor="@color/text_primary"
          android:textSize="11.5sp" />

        <TextView
          android:id="@+id/btnBookLangEn"
          android:layout_width="0dp"
          android:layout_height="34dp"
          android:layout_marginEnd="4dp"
          android:layout_weight="1.1"
          android:background="@drawable/bg_badge_pill"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center"
          android:text="English"
          android:textColor="@color/text_primary"
          android:textSize="11.5sp" />

        <TextView
          android:id="@+id/btnBookTabFavorites"
          android:layout_width="0dp"
          android:layout_height="34dp"
          android:layout_marginEnd="4dp"
          android:layout_weight="1.2"
          android:background="@drawable/bg_badge_pill"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center"
          android:text="প্রিয় বই"
          android:textColor="@color/text_primary"
          android:textSize="11.5sp" />

        <TextView
          android:id="@+id/btnBookTabDownloads"
          android:layout_width="0dp"
          android:layout_height="34dp"
          android:layout_weight="1.3"
          android:background="@drawable/bg_badge_pill"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center"
          android:text="অফলাইন"
          android:textColor="@color/text_primary"
          android:textSize="11.5sp" />
      </LinearLayout>

      <!-- Offline Storage Summary Card -->
      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOfflineStorageSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="12dp"
        app:strokeColor="@color/border_subtle"
        app:strokeWidth="1dp">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingHorizontal="14dp"
          android:paddingVertical="10dp">

          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="18sp" />

          <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
              android:id="@+id/tvOfflineStorageHeading"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="অফলাইন সংরক্ষিত বই"
              android:textColor="@color/text_primary"
              android:textSize="12.5sp"
              android:textStyle="bold" />

            <TextView
              android:id="@+id/tvOfflineStorageDetails"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="মোট ব্যবহৃত জায়গা: ০ MB"
              android:textColor="@color/accent_mint"
              android:textSize="11sp" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Continue Reading Section (Dedicated Card) -->
      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardContinueReading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/accent_mint"
        app:strokeWidth="1.2dp">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
              android:id="@+id/tvContinueReadingSectionTitle"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="পড়া অব্যাহত রাখুন"
              android:textColor="@color/accent_mint"
              android:textSize="12.5sp"
              android:textStyle="bold" />

            <TextView
              android:id="@+id/tvContinueReadingPageBadge"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:background="@drawable/bg_btn_mint_pill"
              android:paddingHorizontal="8dp"
              android:paddingVertical="2dp"
              android:text="পৃষ্ঠা ১২৪"
              android:textColor="@color/bg_main"
              android:textSize="11sp"
              android:textStyle="bold" />
          </LinearLayout>

          <TextView
            android:id="@+id/tvContinueReadingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="আর-রাহীকুল মাখতূম"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

          <TextView
            android:id="@+id/tvContinueReadingAuthorAndProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="লেখক: শফিউর রহমান • ৪২% সম্পন্ন"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

          <ProgressBar
            android:id="@+id/progressBarContinueReading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="42"
            android:progressBackgroundTint="@color/bg_card_secondary"
            android:progressTint="@color/accent_mint" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickResumeReading"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/accent_mint"
            android:text="▶ পড়া শুরু করুন"
            android:textColor="@color/bg_main"
            android:textSize="12.5sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Books List Section Header -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/tvCurrentCategoryHeading"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="সকল বই তালিকা"
          android:textColor="@color/text_primary"
          android:textSize="14sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/tvFilteredCountLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="১৬টি বই উপলব্ধ"
          android:textColor="@color/text_secondary"
          android:textSize="11.5sp" />
      </LinearLayout>

      <!-- Empty State -->
      <LinearLayout
        android:id="@+id/layoutBooksEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="40dp"
        android:visibility="gone">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text=""
          android:textSize="40sp" />

        <TextView
          android:id="@+id/tvBooksEmptyTitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="কোনো বই পাওয়া যায়নি"
          android:textColor="@color/text_primary"
          android:textSize="14sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/tvBooksEmptySubtitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:text="অন্য কোনো শব্দ দিয়ে সার্চ করে দেখুন বা ক্যাটাগরি পরিবর্তন করুন।"
          android:textColor="@color/text_secondary"
          android:textSize="12sp" />
      </LinearLayout>

      <!-- Main Books RecyclerView -->
      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBooksList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" />

    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

</LinearLayout>
