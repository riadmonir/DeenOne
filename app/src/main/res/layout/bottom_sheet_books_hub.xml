<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Main Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar (Screenshot 3) -->
        <LinearLayout
            android:id="@+id/layoutTopHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0E4D46"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:id="@+id/btnCloseBooksHub"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circular_counter"
                android:backgroundTint="#1AFFFFFF"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvBooksHubMainTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="বইসমূহ"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Search Icon in Top Bar -->
            <FrameLayout
                android:id="@+id/btnTopSearch"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circular_counter"
                android:backgroundTint="#1AFFFFFF"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_search"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- Settings Icon in Top Bar -->
            <FrameLayout
                android:id="@+id/btnTopSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circular_counter"
                android:backgroundTint="#1AFFFFFF"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/white" />
            </FrameLayout>

        </LinearLayout>

        <!-- Scrollable Body -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollBooksHub"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="80dp">

                <!-- 1. Recent Read Section (সর্বশেষ পড়া বই) -->
                <LinearLayout
                    android:id="@+id/layoutRecentReadHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_menu_book"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvRecentReadHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="সর্বশেষ পড়া বই - ১টি"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Recent Read Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRecentReadRoot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_circular_counter"
                            android:backgroundTint="#DDF3EF">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_menu_book"
                                app:tint="#0D5C55" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvRecentBookTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="প্রশ্নোত্তরে সহজ তাওহীদ শিক্ষা"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvRecentBookSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="তাওহীদ সম্পর্কে প্রশ্ন এবং উত্তর"
                                android:textColor="@color/text_secondary"
                                android:textSize="12.5sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/ic_clock"
                                    app:tint="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/tvRecentTimeElapsed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="৫৭ মিনিট আগে"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11.5sp" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Search Box & Filter Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Search Input -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chapter_search_bar"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_search"
                            app:tint="@color/text_secondary" />

                        <EditText
                            android:id="@+id/etBooksSearch"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="বই বা লেখক খুঁজ করুন...."
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="14sp" />

                        <FrameLayout
                            android:id="@+id/btnClearBooksSearch"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="✕"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Filter Button on Right of Search -->
                    <FrameLayout
                        android:id="@+id/btnSearchFilterOptions"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_card"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_tune"
                            app:tint="@color/text_primary" />
                    </FrameLayout>

                </LinearLayout>

                <!-- 3. Download Filter Button (↓ ডাউনলোড) -->
                <LinearLayout
                    android:id="@+id/btnFilterDownloaded"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_badge_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_download_arrow"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvDownloadFilterLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="ডাউনলোড"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 4. Categories Accordion RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvBookCategoriesAccordion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Bottom Navigation Bar (Screenshot 3) -->
        <LinearLayout
            android:id="@+id/layoutBooksBottomNav"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/bg_card"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- গ্রন্থাবলি (Active) -->
            <LinearLayout
                android:id="@+id/tabBooksCatalog"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_pill"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_books_duo"
                    app:tint="#0D5C55" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="গ্রন্থাবলি"
                    android:textColor="#0D5C55"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- পছন্দ (Favorites) -->
            <LinearLayout
                android:id="@+id/tabBooksFavorites"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_favorite_border"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="পছন্দ"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- ট্যাগ (Tags) -->
            <LinearLayout
                android:id="@+id/tabBooksTags"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_tag_price"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="ট্যাগ"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- হাইলাইট (Highlights) -->
            <LinearLayout
                android:id="@+id/tabBooksHighlights"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="হাইলাইট"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- আরো (More) -->
            <LinearLayout
                android:id="@+id/tabBooksMore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_more_horiz"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="আরো"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Floating Action Button (Screenshot 3) -->
    <FrameLayout
        android:id="@+id/fabBooksAction"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="70dp"
        android:background="@drawable/bg_circular_counter"
        android:backgroundTint="#0E4D46"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_books_duo"
            app:tint="@color/white" />

        <!-- Red Badge with number "১" -->
        <FrameLayout
            android:id="@+id/badgeFabCount"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_circular_counter"
            android:backgroundTint="#DC2626">

            <TextView
                android:id="@+id/tvFabBadgeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="১"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

    </FrameLayout>

</RelativeLayout>
