<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_emerald_gradient"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="দৈনিক সালাতের সময়সূচি"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnWidgetRefresh"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_badge_pill"
            android:padding="3dp"
            android:src="@drawable/ic_refresh" />
    </RelativeLayout>

    <!-- Table Rows -->
    <!-- 1. Fazr -->
    <LinearLayout
        android:id="@+id/rowFajr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="3dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_sunrise_vector" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="ফজর"
            android:textColor="#E2E8F0"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/tvWaqtFajrRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="০৪:১১ AM - ০৫:২৯ AM"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Dhuhr -->
    <LinearLayout
        android:id="@+id/rowDhuhr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="3dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_sun" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="জোহর"
            android:textColor="#E2E8F0"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/tvWaqtDhuhrRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="১১:৫৯ AM - ০৪:৩১ PM"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. Asr -->
    <LinearLayout
        android:id="@+id/rowAsr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="3dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_sun" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="আসর"
            android:textColor="#E2E8F0"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/tvWaqtAsrRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="০৪:৩২ PM - ০৬:২৩ PM"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. Maghrib -->
    <LinearLayout
        android:id="@+id/rowMaghrib"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="3dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_sunset_vector" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="মাগরিব"
            android:textColor="#E2E8F0"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/tvWaqtMaghribRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="০৬:২৪ PM - ০৭:৪২ PM"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5. Isha -->
    <LinearLayout
        android:id="@+id/rowIsha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="3dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_moon" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="এশা"
            android:textColor="#E2E8F0"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/tvWaqtIshaRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="০৭:৪৩ PM - ০৪:১০ AM"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
