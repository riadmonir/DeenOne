<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Circular Day Container: Green / Red / Yellow Indicator Circle -->
    <FrameLayout
        android:id="@+id/layoutDayCircle"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center">

        <TextView
            android:id="@+id/tvDayNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="১৫"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Optional Small Bottom Indicator Dot for Additional Status Precision -->
        <View
            android:id="@+id/viewFastingDot"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_circular_counter"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
