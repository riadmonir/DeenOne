<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- Top Bar: Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <ImageButton android:id="@+id/btnCloseAuthForgot"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="@color/bg_badge_pill"
            android:contentDescription="বন্ধ করুন"
            android:src="@drawable/ic_close"
            app:tint="@color/accent_mint" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Brand Logo Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deen"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="One"
                    android:textColor="@color/accent_mint"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card Container -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="24dp">

                    <!-- ========================================================= -->
                    <!-- STEP 1: REQUEST VERIFICATION CODE -->
                    <!-- ========================================================= -->
                    <LinearLayout
                        android:id="@+id/layoutForgotStep1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <TextView
                            android:id="@+id/tvForgotTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="পাসওয়ার্ড পুনরুদ্ধার"
                            android:textColor="@color/accent_mint"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvForgotSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="22dp"
                            android:text="আপনার অ্যাকাউন্টের নিবন্ধিত ইমেইল ঠিকানা প্রদান করুন। আমরা একটি ৬ ডিজিটের ভেরিফিকেশন কোড পাঠাব।"
                            android:textColor="@color/text_secondary"
                            android:textSize="13.5sp"
                            android:lineSpacingExtra="2dp" />

                        <!-- Field: Email -->
                        <TextView
                            android:id="@+id/tvForgotIdentifierLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="নিবন্ধিত ইমেইল ঠিকানা"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="24dp"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_person"
                                app:tint="@color/accent_mint"
                                android:contentDescription="ইউজার আইকন" />

                            <EditText
                                android:id="@+id/etForgotIdentifier"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="10dp"
                                android:background="@null"
                                android:hint="example@email.com"
                                android:inputType="textEmailAddress"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_muted"
                                android:textSize="14.5sp" />
                        </LinearLayout>

                        <!-- Send Code Submit Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmitForgotPassword"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:backgroundTint="@color/accent_mint"
                            android:text="ভেরিফিকেশন কোড পাঠান →"
                            android:textColor="@color/text_dark"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp" />
                    </LinearLayout>

                    <!-- ========================================================= -->
                    <!-- STEP 2: VERIFY OTP CODE WITH 5-MIN COUNTDOWN -->
                    <!-- ========================================================= -->
                    <LinearLayout
                        android:id="@+id/layoutForgotStep2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvVerifyOtpTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="কোড যাচাইকরণ"
                            android:textColor="@color/accent_mint"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvVerifyOtpSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="12dp"
                            android:text="আপনার ইমেইলে প্রেরিত ৬ ডিজিটের ওটিপি ভেরিফিকেশন কোডটি প্রবেশ করান।"
                            android:textColor="@color/text_secondary"
                            android:textSize="13.5sp"
                            android:lineSpacingExtra="2dp" />

                        <!-- Target Identifier Pill -->
                        <TextView
                            android:id="@+id/tvForgotTargetIdentifier"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="@color/bg_card_active"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:text="user@email.com"
                            android:textColor="@color/accent_mint"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="18dp" />

                        <!-- 5-Minute Rate Limit / Expiry Countdown Timer Card -->
                        <LinearLayout
                            android:id="@+id/layoutForgotTimerCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="@color/bg_main"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="10dp"
                            android:layout_marginBottom="16dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_time"
                                app:tint="@color/accent_gold"
                                android:contentDescription="টাইমার আইকন" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvForgotCountdownLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="কোডের মেয়াদ ও পুনঃঅনুরোধ সময়"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11.5sp" />

                                <TextView
                                    android:id="@+id/tvForgotCountdownTimer"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="০৫:০০"
                                    android:textColor="@color/accent_gold"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Field: 6-Digit Verification Code -->
                        <TextView
                            android:id="@+id/tvResetCodeLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="৬ ডিজিটের ওটিপি কোড"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="18dp"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_shield_check"
                                app:tint="@color/accent_mint"
                                android:contentDescription="কোড আইকন" />

                            <EditText
                                android:id="@+id/etResetCode"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="10dp"
                                android:background="@null"
                                android:hint="••••••"
                                android:inputType="number"
                                android:maxLength="6"
                                android:letterSpacing="0.25"
                                android:textColor="@color/accent_mint"
                                android:textColorHint="@color/text_muted"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Verify OTP Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVerifyOtpCode"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:backgroundTint="@color/accent_mint"
                            android:text="কোড যাচাই করুন →"
                            android:textColor="@color/text_dark"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp" />

                        <!-- Resend Code Button -->
                        <TextView
                            android:id="@+id/btnResendResetCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="6dp"
                            android:text="পুনরায় কোড পাঠান"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- ========================================================= -->
                    <!-- STEP 3: SET NEW PASSWORD -->
                    <!-- ========================================================= -->
                    <LinearLayout
                        android:id="@+id/layoutForgotStep3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvResetTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="নতুন পাসওয়ার্ড নির্ধারণ"
                            android:textColor="@color/accent_mint"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvResetSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="18dp"
                            android:text="আপনার অ্যাকাউন্টের জন্য নতুন ও শক্তিশালী পাসওয়ার্ড নির্ধারণ করুন।"
                            android:textColor="@color/text_secondary"
                            android:textSize="13.5sp"
                            android:lineSpacingExtra="2dp" />

                        <!-- Field: New Password -->
                        <TextView
                            android:id="@+id/tvResetNewPassLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="নতুন পাসওয়ার্ড (ন্যূনতম ৬ অক্ষর)"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="14dp"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_lock"
                                app:tint="@color/accent_mint"
                                android:contentDescription="লক আইকন" />

                            <EditText
                                android:id="@+id/etResetNewPassword"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="••••••••"
                                android:inputType="textPassword"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_muted"
                                android:textSize="14.5sp" />

                            <ImageView
                                android:id="@+id/ivResetToggleNewPass"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:src="@drawable/ic_eye"
                                app:tint="@color/text_muted"
                                android:contentDescription="পাসওয়ার্ড দেখুন" />
                        </LinearLayout>

                        <!-- Field: Confirm New Password -->
                        <TextView
                            android:id="@+id/tvResetConfirmPassLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="পাসওয়ার্ড নিশ্চিত করুন"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="22dp"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_lock_check"
                                app:tint="@color/accent_mint"
                                android:contentDescription="কনফার্ম লক আইকন" />

                            <EditText
                                android:id="@+id/etResetConfirmPassword"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="••••••••"
                                android:inputType="textPassword"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_muted"
                                android:textSize="14.5sp" />

                            <ImageView
                                android:id="@+id/ivResetToggleConfirmPass"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:src="@drawable/ic_eye"
                                app:tint="@color/text_muted"
                                android:contentDescription="পাসওয়ার্ড দেখুন" />
                        </LinearLayout>

                        <!-- Submit Reset Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmitResetPassword"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:backgroundTint="@color/accent_mint"
                            android:text="পাসওয়ার্ড রিসেট সম্পন্ন করুন →"
                            android:textColor="@color/text_dark"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp" />
                    </LinearLayout>

                    <!-- Return to Login Link -->
                    <TextView
                        android:id="@+id/tvReturnToLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="20dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp"
                        android:text="লগইন পেজে ফিরে যান"
                        android:textColor="@color/accent_mint"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Footer: Privacy, Terms, Support -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAuthPrivacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:text="PRIVACY"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp"
                    android:letterSpacing="0.06" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="•"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp"
                    android:layout_marginHorizontal="3dp" />

                <TextView
                    android:id="@+id/tvAuthTerms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:text="TERMS"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp"
                    android:letterSpacing="0.06" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="•"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp"
                    android:layout_marginHorizontal="3dp" />

                <TextView
                    android:id="@+id/tvAuthSupport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:text="SUPPORT"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp"
                    android:letterSpacing="0.06" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="© ২০২৬ DeenOne. সর্বস্বত্ব সংরক্ষিত।"
                android:textColor="@color/text_muted"
                android:textSize="10.5sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
