<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded_top"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_circular_counter"
        android:backgroundTint="@color/border_card" />

    <!-- Top Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSettingsSheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="কুরআন বাংলা সেটিংস"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSettingsSheetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="ফন্ট সাইজ ও আরবি দৃশ্যমানতা নির্ধারণ করুন"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnCloseSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circular_counter"
            android:backgroundTint="@color/bg_badge_pill">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_close"
                app:tint="@color/accent_mint" />
        </FrameLayout>
    </RelativeLayout>

    <!-- Toggle 1: Show Arabic Text (উসমানী আরবি প্রদর্শন) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/switchShowArabic"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvShowArabicTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="উসমানী আরবি টেক্সট দেখুন"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvShowArabicSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="অনুবাদ পড়ার সাথে সাথে মূল আরবি আয়াত প্রদর্শিত থাকবে"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchShowArabic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:checked="true"
                app:useMaterialThemeColors="true" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Slider 1: Arabic Font Size -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardArabicFontSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvArabicFontLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="আরবি ফন্ট সাইজ"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvArabicFontPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_badge_makki"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="১০০%"
                    android:textColor="@color/text_surah_makki"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Sample Arabic Preview -->
            <TextView
                android:id="@+id/tvSampleArabicPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:text="ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ"
                android:textAlignment="viewEnd"
                android:textColor="@color/accent_mint"
                android:textDirection="rtl"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Slider -->
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderArabicFontSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:value="100"
                android:valueFrom="70"
                android:valueTo="160"
                android:stepSize="5"
                app:thumbColor="@color/accent_mint"
                app:trackColorActive="@color/accent_mint"
                app:trackColorInactive="@color/border_card" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Slider 2: Bangla Translation Font Size -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvBanglaFontLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="বাংলা অনুবাদ ফন্ট সাইজ"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBanglaFontSizeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_badge_madani"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="১৫ sp"
                    android:textColor="@color/text_surah_madani"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Sample Bangla Preview -->
            <TextView
                android:id="@+id/tvSampleBanglaPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="যাবতীয় প্রশংসা আল্লাহ তাআলার যিনি সকল সৃষ্টিজগতের পালনকর্তা।"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <!-- Slider -->
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderBanglaFontSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:value="15"
                android:valueFrom="12"
                android:valueTo="24"
                android:stepSize="1"
                app:thumbColor="@color/accent_mint"
                app:trackColorActive="@color/accent_mint"
                app:trackColorInactive="@color/border_card" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
