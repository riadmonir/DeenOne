<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Top App Bar & Header Container -->
    <LinearLayout
        android:id="@+id/layoutHadithHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Global Top App Bar (DeenOne Official Style) -->
        <LinearLayout
            android:id="@+id/layoutTopHeader"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/bg_top_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <FrameLayout
                android:id="@+id/btnCloseHadith"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circular_counter"
                android:backgroundTint="@color/bg_card"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/accent_mint"
                    android:contentDescription="Close" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvHadithViewerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="হাদিস"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_card" />

        <!-- Selected Category Header (Visible when viewing specific book's hadiths if needed) -->
        <LinearLayout
            android:id="@+id/layoutSelectedCategoryBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_hadith_category_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/btnBackToCategories"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circular_counter"
                android:backgroundTint="@color/bg_badge_pill">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/accent_mint" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvSelectedBookTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="সহীহ বুখারী"
                android:textColor="@color/text_primary"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSelectedBookCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="৭৫৬৩ হাদিস"
                android:textColor="@color/accent_mint"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- 1. Hadith Categories RecyclerView (25 Books with Hexagon Badges) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHadithCategories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHadithHeader" />

    <!-- 2. Individual Hadiths RecyclerView (Shown when a book is selected) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHadithList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHadithHeader" />

    <!-- 3. HADITH CHAPTERS SCREEN (Official DeenOne UI/UX) -->
    <LinearLayout
        android:id="@+id/layoutChapterView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_main"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Header: Back Button + Book Title (DeenOne Official Style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/bg_top_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <FrameLayout
                android:id="@+id/btnBackFromChapters"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circular_counter"
                android:backgroundTint="@color/bg_card"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/accent_mint"
                    android:contentDescription="Back" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvChapterBookTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="সহীহ বুখারী"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_card" />

        <!-- Content Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg_main">

            <!-- Search Bar: অধ্যায় অনুসন্ধান করুন -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_badge_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/ivSearchChapterIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_secondary"
                    android:contentDescription="@null" />

                <EditText
                    android:id="@+id/etSearchChapter"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="অধ্যায় অনুসন্ধান করুন..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- Empty State Container for Chapters -->
            <LinearLayout
                android:id="@+id/layoutEmptyChapters"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_open_book_dialog"
                    app:tint="@color/text_secondary"
                    android:alpha="0.6"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvEmptyChaptersTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="এই কিতাবের অধ্যায়সমূহ শীঘ্রই যুক্ত হচ্ছে"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmptyChaptersSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="অনুগ্রহ করে অন্য কিতাব নির্বাচন করুন"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Chapters List RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHadithChapters"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="4dp"
                android:paddingBottom="24dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 4. HADITH READER SCREEN (Official DeenOne UI/UX) -->
    <LinearLayout
        android:id="@+id/layoutHadithReaderView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_main"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Header: Back Button + Chapter Title (e.g. ওহীর সূচনা অধ্যায়) + Right Settings/Tune Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/bg_top_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <!-- Left: Back Button -->
            <FrameLayout
                android:id="@+id/btnBackFromReader"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circular_counter"
                android:backgroundTint="@color/bg_card"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/accent_mint"
                    android:contentDescription="Back" />
            </FrameLayout>

            <!-- Title: Chapter Title -->
            <TextView
                android:id="@+id/tvReaderChapterTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="ওহীর সূচনা অধ্যায়"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Right: Settings / Font Changer Icon -->
            <FrameLayout
                android:id="@+id/btnReaderSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circular_counter"
                android:backgroundTint="@color/bg_card"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tune"
                    app:tint="@color/accent_mint"
                    android:contentDescription="Display Settings" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_card" />

        <!-- Content Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg_main">

            <!-- Empty State Container for Hadiths -->
            <LinearLayout
                android:id="@+id/layoutEmptyHadiths"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_open_book_dialog"
                    app:tint="@color/text_secondary"
                    android:alpha="0.6"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvEmptyHadithsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="এই অধ্যায়ের হাদিসসমূহ শীঘ্রই যুক্ত হচ্ছে"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmptyHadithsSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="অনুগ্রহ করে অন্য অধ্যায় নির্বাচন করুন"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Hadith Reader RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChapterHadithReader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="8dp"
                android:paddingBottom="32dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Centered DeenOne Official Loading View Overlay -->
    <com.devflux.deenone.core.ui.loading.DeenOneLoadingView
        android:id="@+id/loadingViewHadith"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
