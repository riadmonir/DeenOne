<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- Top Header Bar (Fixed 56dp height with standard DeenOne alignment) -->
    <LinearLayout
        android:id="@+id/layoutJanazaHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_top_bar"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- Back Button with Circular Container -->
        <FrameLayout
            android:id="@+id/btnBackJanaza"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circular_counter"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <!-- Header Title -->
        <TextView
            android:id="@+id/tvJanazaHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="জানাযা গাইড"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Settings Gear Action Button with Circular Container -->
        <FrameLayout
            android:id="@+id/btnSettingsJanaza"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circular_counter"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_primary" />
        </FrameLayout>
    </LinearLayout>

    <!-- Scrollable Content with Hero Card and 8 Topics -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollJanazaContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Banner Card: Significance & 2 Qirat Reward -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardJanazaHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_circular_counter"
                            android:backgroundTint="@color/bg_badge_pill">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_feat_janaza"
                                app:tint="@color/accent_teal" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvHeroBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_pill"
                                android:backgroundTint="@color/accent_teal"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="ফরযে কেফায়া"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvHeroTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="পরিপূর্ণ জানাযা ও কাফন-দাফন গাইড"
                                android:textColor="@color/text_primary"
                                android:textSize="15.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHeroSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="3dp"
                        android:text="“যে ব্যক্তি জানাযার সালাতে অংশ নেয় সে এক ক্বীরাত এবং যে দাফন পর্যন্ত থাকে সে দুই ক্বীরাত (ওহুদ পাহাড় সমপরিমাণ) সওয়াব অর্জন করে।” — সহীহ বুখারী: ৪৭"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section Header -->
            <TextView
                android:id="@+id/tvTopicsSectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="সূচিপত্র ও বিষয়ভিত্তিক অধ্যায়সমূহ:"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- RecyclerView for the 8 Verbatim Topics from Screenshot -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvJanazaTopicsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
