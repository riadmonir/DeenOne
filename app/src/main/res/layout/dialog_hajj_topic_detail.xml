<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_modal_emerald_sheet"
        android:backgroundTint="@color/bg_card"
        android:orientation="vertical">

        <!-- Top Drag Pill -->
        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="@color/border_card" />

        <!-- Header Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <FrameLayout
                android:id="@+id/flTopicIconContainer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_icon">

                <ImageView
                    android:id="@+id/ivDetailTopicIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    tools:src="@drawable/ic_hajj_1_hajj" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="48dp"
                android:layout_toEndOf="@id/flTopicIconContainer"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetailTopicTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="ফজিলত ও তাৎপর্য" />

                <TextView
                    android:id="@+id/tvDetailCategoryPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="@color/bg_badge_pill"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/accent_mint"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="মর্যাদা ও সওয়াব" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnDetailClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circular_counter"
                android:backgroundTint="@color/bg_card_secondary"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_secondary" />
            </FrameLayout>

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_card" />

        <!-- Scrollable Content Body -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. Overview Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/bg_card_secondary"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvLabelOverview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="সারসংক্ষেপ ও তাৎপর্য"
                            android:textColor="@color/accent_mint"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailOverview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3.5dp"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp"
                            tools:text="হজের ফজিলত ও তাৎপর্য অপরিসীম..." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. What To Do (করণীয়) Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWhatToDo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/bg_card_secondary"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvLabelWhatToDo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="করণীয় ও দিকনির্দেশনা"
                            android:textColor="#16A34A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailWhatToDo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3.5dp"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp"
                            tools:text="• সহযাত্রী হাজীদের সেবা করা..." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. What Not To Do (বর্জনীয়) Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWhatNotToDo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/bg_card_secondary"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvLabelWhatNotToDo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="সতর্কতা ও বর্জনীয় বিষয়"
                            android:textColor="#DC2626"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailWhatNotToDo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3.5dp"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp"
                            tools:text="• কারো সাথে ঝগড়া-বিবাদ করা যাবে না..." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Dua Card (If Available) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDuaSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/bg_card_secondary"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvLabelDua"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="মাসনূন দোয়া ও জিকির"
                            android:textColor="@color/accent_gold"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailArabicDua"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:lineSpacingExtra="6dp"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="اللَّهُمَّ اجْعَلْهُ حَجًّا مَبْرُورًا..." />

                        <TextView
                            android:id="@+id/tvDetailTransliteration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12.5sp"
                            android:textStyle="italic"
                            tools:text="উচ্চারণ: আল্লাহুম্মাজ'আলহু..." />

                        <TextView
                            android:id="@+id/tvDetailTranslation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="3.5dp"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            tools:text="অর্থ: হে আল্লাহ! এই হজকে কবুল হজ..." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. Authentic Reference Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReferenceSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/bg_card_secondary"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/accent_mint" />

                        <TextView
                            android:id="@+id/tvDetailReference"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            tools:text="সূত্র: সহীহ বুখারী: ১৫২১, সহীহ মুসলিম: ১৩৫০" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Bottom Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnShareTopic"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/bg_card_secondary"
                        android:text="শেয়ার করুন"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_share"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconTint="@color/text_primary"
                        app:strokeColor="@color/border_card"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/btnCloseDialog"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/accent_mint"
                        android:text="ঠিক আছে"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
