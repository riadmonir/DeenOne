<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_emerald_gradient"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="13dp">

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_feat_hadith" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="দৈনিক হাদিস ও উপদেশ"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnWidgetRefresh"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_badge_pill"
            android:padding="3dp"
            android:src="@drawable/ic_refresh" />
    </RelativeLayout>

    <!-- Bengali Hadith Text -->
    <TextView
        android:id="@+id/tvWidgetHadithBengali"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="তোমাদের মধ্যে সর্বোত্তম ব্যক্তি সে, যে কুরআন শিক্ষা করে এবং অন্যকে শিক্ষা দেয়।"
        android:textColor="#FFFFFF"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <!-- Hadith Reference -->
    <TextView
        android:id="@+id/tvWidgetHadithReference"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="সহীহ বুখারী: ৫০২৭"
        android:textColor="#FDE047"
        android:textSize="10.5sp"
        android:textStyle="bold" />
</LinearLayout>
