<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardJourneyWord"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_goal_item_unselected"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Row: Serial Badge & Eye Toggle Icon -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvWordSerial"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentStart="true"
            android:background="@drawable/bg_badge_pill"
            android:gravity="center"
            android:text="১"
            android:textColor="@color/accent_mint"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivEyeToggle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_badge_pill"
            android:padding="5dp"
            android:src="@drawable/ic_eye_off"
            app:tint="@color/text_secondary" />
    </RelativeLayout>

    <!-- Arabic Word -->
    <TextView
        android:id="@+id/tvWordArabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="ٱلْحَمْدُ"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Thin Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="@color/border_card" />

    <!-- Meaning (Hidden or Revealed) -->
    <TextView
        android:id="@+id/tvWordMeaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="(ট্যাপ করুন)"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
