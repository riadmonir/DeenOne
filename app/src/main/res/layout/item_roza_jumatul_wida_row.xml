<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardJumatulWidaItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_card"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Jumatul Wida Topic Title -->
        <TextView
            android:id="@+id/tvJumatulWidaTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="অর্থ ও গুরুত্ব" />

        <!-- Preview Text (Visible when collapsed) -->
        <TextView
            android:id="@+id/tvJumatulWidaPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="জুমাতুল বিদা হলো পবিত্র মাহে রমজানের শেষ শুক্রবার..." />

        <!-- Detailed Full Content (Visible when expanded) -->
        <TextView
            android:id="@+id/tvJumatulWidaFullContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="বিস্তারিত ঐতিহাসিক বিবরণ ও ইসলামিক ব্যাখ্যা..." />

        <!-- Islamic Reference (Visible when expanded) -->
        <TextView
            android:id="@+id/tvJumatulWidaReference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/accent_teal"
            android:textSize="13sp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="রেফারেন্স: সহীহ মুসলিম, হাদিস ৮৫৪" />

        <!-- Expand / Collapse Action Row ("বিস্তারিত ⌵") -->
        <LinearLayout
            android:id="@+id/layoutJumatulWidaToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/tvJumatulWidaToggleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="বিস্তারিত"
                android:textColor="@color/accent_teal"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivJumatulWidaToggleChevron"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/accent_teal" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
