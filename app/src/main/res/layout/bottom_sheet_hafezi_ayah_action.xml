<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded_top"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_circular_counter"
        android:backgroundTint="@color/border_card" />

    <!-- Top Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAyahActionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="সূরা আল-কাহফ: আয়াত ১০"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAyahActionSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="পারা ১৫ • পৃষ্ঠা ২৯৩"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnCloseAyahAction"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circular_counter"
            android:backgroundTint="@color/bg_badge_pill">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                app:tint="@color/accent_mint" />
        </FrameLayout>
    </RelativeLayout>

    <!-- Arabic Text Preview Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvAyahActionArabic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:lineSpacingMultiplier="1.25"
                android:text="رَبَّنَا آتِنَا مِنْ لَدُنْكَ رَحْمَةً وَهَيِّئْ لَنَا مِنْ أَمْرِنَا رَشَدًا ۝١٠"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvAyahActionTranslation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="অর্থ: হে আমাদের পালনকর্তা, নিজের পক্ষ থেকে আমাদের অনুগ্রহ দান করুন এবং আমাদের কাজ সঠিকভাবে পরিচালনার ব্যবস্থা করে দিন।"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons Grid / List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Action 1: Play Repetition Loop -->
        <TextView
            android:id="@+id/btnActionPlayLoop"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_btn_mint_pill"
            android:gravity="center"
            android:text="🔁 অডিও রিপিটেশন লুপে শুনুন (৩ / ৫ / ১০ বার)"
            android:textColor="@color/bg_main"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Action 2: Toggle Mistake / Mutashabihat -->
        <TextView
            android:id="@+id/btnActionToggleMistake"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_card_secondary"
            android:gravity="center"
            android:text="⚠️ ভুল / মুতাশাবিহাত হিসেবে চিহ্নিত করুন"
            android:textColor="@color/accent_gold"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Action Row: Meaning + Bookmark + Copy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnActionWordByWord"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_pill"
                android:gravity="center"
                android:text="শব্দে শব্দে অর্থ"
                android:textColor="@color/accent_mint"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnActionBookmark"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_pill"
                android:gravity="center"
                android:text="বুকমার্ক"
                android:textColor="@color/accent_mint"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnActionCopy"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_pill"
                android:gravity="center"
                android:text="কপি"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
