<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/bg_main"
  android:orientation="vertical">

  <!-- Global Top Header Bar -->
  <RelativeLayout
    android:id="@+id/layoutTopHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_top_bar"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <FrameLayout
      android:id="@+id/btnBackRedeem"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:layout_alignParentStart="true"
      android:layout_centerVertical="true"
      android:background="@drawable/bg_circular_counter"
      android:backgroundTint="@color/bg_badge_pill"
      android:clickable="true"
      android:focusable="true">

      <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/accent_mint" />
    </FrameLayout>

    <!-- Center: DeenOne Brand Logo -->
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_centerInParent="true"
      android:gravity="center"
      android:orientation="horizontal">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Deen"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="One"
        android:textColor="@color/accent_mint"
        android:textSize="22sp"
        android:textStyle="bold" />
    </LinearLayout>

    <!-- Right: Theme Toggle + Standing Divider + Notification Bell -->
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_alignParentEnd="true"
      android:layout_centerVertical="true"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <FrameLayout
        android:id="@+id/btnRedeemThemeToggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circular_counter"
        android:backgroundTint="@color/bg_badge_pill"
        android:clickable="true"
        android:focusable="true">

        <ImageView
          android:id="@+id/ivRedeemThemeIcon"
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_gravity="center"
          android:src="@drawable/ic_moon"
          app:tint="@color/accent_mint" />
      </FrameLayout>

      <View
        android:layout_width="1.5dp"
        android:layout_height="20dp"
        android:layout_marginHorizontal="6dp"
        android:background="@color/border_card" />

      <FrameLayout
        android:id="@+id/btnRedeemNotification"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circular_counter"
        android:backgroundTint="@color/bg_badge_pill"
        android:clickable="true"
        android:focusable="true">

        <ImageView
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_gravity="center"
          android:src="@drawable/ic_notifications"
          app:tint="@color/accent_mint" />

        <View
          android:layout_width="8dp"
          android:layout_height="8dp"
          android:layout_gravity="top|end"
          android:layout_marginTop="7dp"
          android:layout_marginEnd="7dp"
          android:background="@drawable/bg_circular_counter"
          android:backgroundTint="#EF4444" />
      </FrameLayout>
    </LinearLayout>
  </RelativeLayout>

  <!-- Subheader: Page Title & Subtitle -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_top_bar"
    android:paddingHorizontal="16dp"
    android:paddingBottom="10dp"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/bg_badge_pill"
      android:backgroundTint="@color/bg_card_active"
      android:paddingHorizontal="14dp"
      android:paddingVertical="4dp"
      android:text="• পয়েন্ট রিডিম ও রিওয়ার্ড"
      android:textColor="@color/accent_mint"
      android:textSize="12.5sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="3dp"
      android:text="দ্বীনি আমলের পয়েন্ট রিডিম করুন"
      android:textColor="@color/text_secondary"
      android:textSize="11.5sp" />
  </LinearLayout>

  <!-- Scrollable Content -->
  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingHorizontal="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="40dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <!-- 1. HERO POINTS & LEVEL CARD -->
      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1.2dp">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="18dp"
          android:paddingVertical="20dp">

          <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentStart="true"
              android:orientation="vertical">

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আপনার বর্তমান ব্যালেন্স"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

              <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                  android:id="@+id/tvRedeemTotalPoints"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="১২৭২"
                  android:textColor="#FFA000"
                  android:textSize="26sp"
                  android:textStyle="bold" />

                <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="6dp"
                  android:text="XP পয়েন্ট"
                  android:textColor="#FFB74D"
                  android:textSize="14sp"
                  android:textStyle="bold" />
              </LinearLayout>
            </LinearLayout>

            <FrameLayout
              android:layout_width="48dp"
              android:layout_height="48dp"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true"
              android:background="@drawable/circle_progress_bg"
              android:backgroundTint="@color/badge_pill_amber_bg">

              <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_star"
                app:tint="#F59E0B"
                android:contentDescription="স্টার পয়েন্ট" />
            </FrameLayout>
          </RelativeLayout>

          <!-- Level Badge & Progress Bar -->
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_secondary"
            android:backgroundTint="@color/bg_card_secondary"
            android:orientation="vertical"
            android:padding="12dp">

            <RelativeLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content">

              <TextView
                android:id="@+id/tvRedeemCurrentLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="লেভেল ৩: সাবেকুনা বিল খাইরাত"
                android:textColor="#34D399"
                android:textSize="12.5sp"
                android:textStyle="bold" />

              <TextView
                android:id="@+id/tvRedeemNextLevelTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="পরবর্তী: লেভেল ৪ (২,০০০ XP)"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
            </RelativeLayout>

            <ProgressBar
              android:id="@+id/pbRedeemLevelProgress"
              style="?android:attr/progressBarStyleHorizontal"
              android:layout_width="match_parent"
              android:layout_height="8dp"
              android:layout_marginTop="8dp"
              android:max="1000"
              android:progress="272"
              android:progressDrawable="@drawable/progress_waqt_mint_horizontal" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- 2. REWARD CATALOG SECTION -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:src="@drawable/ic_medal_reward"
          app:tint="@color/accent_gold"
          android:contentDescription="পুরস্কার আইকন" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:text="পয়েন্ট রিডিম করে পুরস্কার ও গিফট"
          android:textColor="@color/text_primary"
          android:textSize="15sp"
          android:textStyle="bold" />
      </LinearLayout>

      <!-- Rewards Container -->
      <LinearLayout
        android:id="@+id/layoutRewardsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <!-- Reward 1: Gift Box Voucher -->
        <com.google.android.material.card.MaterialCardView
          android:id="@+id/cardRewardGiftBox"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          app:cardBackgroundColor="@color/bg_card"
          app:cardCornerRadius="16dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/border_card"
          app:strokeWidth="1.2dp">

          <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <FrameLayout
              android:id="@+id/flGiftIcon1"
              android:layout_width="44dp"
              android:layout_height="44dp"
              android:layout_alignParentStart="true"
              android:layout_centerVertical="true"
              android:background="@drawable/bg_badge_pill"
              android:backgroundTint="@color/badge_pill_amber_bg">

              <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_medal_reward"
                app:tint="#FFA000"
                android:contentDescription="গিফট বক্স" />
            </FrameLayout>

            <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_centerVertical="true"
              android:layout_marginStart="12dp"
              android:layout_toStartOf="@+id/btnClaimReward1"
              android:layout_toEndOf="@+id/flGiftIcon1"
              android:orientation="vertical">

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ইসলামিক গিফট বক্স ভাউচার"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="কুরআন শরীফ, জায়নামাজ ও আতর গিফট সেট"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="২,০০০ XP পয়েন্ট"
                android:textColor="#FFA000"
                android:textSize="12sp"
                android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
              android:id="@+id/btnClaimReward1"
              style="@style/Widget.MaterialComponents.Button"
              android:layout_width="wrap_content"
              android:layout_height="36dp"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true"
              android:backgroundTint="@color/accent_mint"
              android:insetTop="0dp"
              android:insetBottom="0dp"
              android:paddingHorizontal="14dp"
              android:text="রিডিম"
              android:textColor="@color/white"
              android:textSize="12sp"
              android:textStyle="bold"
              app:cornerRadius="14dp" />
          </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reward 2: Water Project Sadaqah -->
        <com.google.android.material.card.MaterialCardView
          android:id="@+id/cardRewardWaterProject"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          app:cardBackgroundColor="@color/bg_card"
          app:cardCornerRadius="16dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/border_card"
          app:strokeWidth="1.2dp">

          <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <FrameLayout
              android:id="@+id/flGiftIcon2"
              android:layout_width="44dp"
              android:layout_height="44dp"
              android:layout_alignParentStart="true"
              android:layout_centerVertical="true"
              android:background="@drawable/bg_badge_pill"
              android:backgroundTint="@color/bg_card_secondary">

              <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_charity_hand"
                app:tint="#38BDF8"
                android:contentDescription="সদকাহ" />
            </FrameLayout>

            <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_centerVertical="true"
              android:layout_marginStart="12dp"
              android:layout_toStartOf="@+id/btnClaimReward2"
              android:layout_toEndOf="@+id/flGiftIcon2"
              android:orientation="vertical">

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="সদকাহ জারিয়াহ অনুদান"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="উম্মাহ টিউবওয়েল ও বিশুদ্ধ পানি প্রকল্পে সহায়তা"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="১,০০০ XP পয়েন্ট"
                android:textColor="#FFA000"
                android:textSize="12sp"
                android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
              android:id="@+id/btnClaimReward2"
              style="@style/Widget.MaterialComponents.Button"
              android:layout_width="wrap_content"
              android:layout_height="36dp"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true"
              android:backgroundTint="@color/accent_mint"
              android:insetTop="0dp"
              android:insetBottom="0dp"
              android:paddingHorizontal="14dp"
              android:text="দান করুন"
              android:textColor="@color/white"
              android:textSize="12sp"
              android:textStyle="bold"
              app:cornerRadius="14dp" />
          </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reward 3: Quran Distribution -->
        <com.google.android.material.card.MaterialCardView
          android:id="@+id/cardRewardQuranDistribution"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          app:cardBackgroundColor="@color/bg_card"
          app:cardCornerRadius="16dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/border_card"
          app:strokeWidth="1.2dp">

          <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <FrameLayout
              android:id="@+id/flGiftIcon3"
              android:layout_width="44dp"
              android:layout_height="44dp"
              android:layout_alignParentStart="true"
              android:layout_centerVertical="true"
              android:background="@drawable/bg_badge_pill"
              android:backgroundTint="@color/bg_badge_pill">

              <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_feat_book"
                app:tint="@color/accent_mint"
                android:contentDescription="কুরআন ফান্ড" />
            </FrameLayout>

            <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_centerVertical="true"
              android:layout_marginStart="12dp"
              android:layout_toStartOf="@+id/btnClaimReward3"
              android:layout_toEndOf="@+id/flGiftIcon3"
              android:orientation="vertical">

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="কুরআন বিতরণ ফান্ড"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="মাদরাসার শিক্ষার্থীদের কুরআন উপহার দিন"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="৮০০ XP পয়েন্ট"
                android:textColor="#FFA000"
                android:textSize="12sp"
                android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
              android:id="@+id/btnClaimReward3"
              style="@style/Widget.MaterialComponents.Button"
              android:layout_width="wrap_content"
              android:layout_height="36dp"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true"
              android:backgroundTint="@color/accent_mint"
              android:insetTop="0dp"
              android:insetBottom="0dp"
              android:paddingHorizontal="14dp"
              android:text="দান করুন"
              android:textColor="@color/white"
              android:textSize="12sp"
              android:textStyle="bold"
              app:cornerRadius="14dp" />
          </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reward 4: Premium Reciters Audio Pack -->
        <com.google.android.material.card.MaterialCardView
          android:id="@+id/cardRewardAudioPack"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          app:cardBackgroundColor="@color/bg_card"
          app:cardCornerRadius="16dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/border_card"
          app:strokeWidth="1.2dp">

          <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <FrameLayout
              android:id="@+id/flGiftIcon4"
              android:layout_width="44dp"
              android:layout_height="44dp"
              android:layout_alignParentStart="true"
              android:layout_centerVertical="true"
              android:background="@drawable/bg_badge_pill"
              android:backgroundTint="@color/bg_card_secondary">

              <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_feat_audio"
                app:tint="#818CF8"
                android:contentDescription="অডিও প্যাক" />
            </FrameLayout>

            <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_centerVertical="true"
              android:layout_marginStart="12dp"
              android:layout_toStartOf="@+id/btnClaimReward4"
              android:layout_toEndOf="@+id/flGiftIcon4"
              android:orientation="vertical">

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="প্রিমিয়াম তিলাওয়াত অডিও প্যাক"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="হারামাইন কারীদের হাই-কোয়ালিটি অডিও আনলক"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="৫০০ XP পয়েন্ট"
                android:textColor="#FFA000"
                android:textSize="12sp"
                android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
              android:id="@+id/btnClaimReward4"
              style="@style/Widget.MaterialComponents.Button"
              android:layout_width="wrap_content"
              android:layout_height="36dp"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true"
              android:backgroundTint="@color/accent_mint"
              android:insetTop="0dp"
              android:insetBottom="0dp"
              android:paddingHorizontal="14dp"
              android:text="আনলক"
              android:textColor="@color/white"
              android:textSize="12sp"
              android:textStyle="bold"
              app:cornerRadius="14dp" />
          </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

      </LinearLayout>

      <!-- 3. HOW TO EARN POINTS (নিয়মাবলী) -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:src="@drawable/ic_sparkle"
          app:tint="@color/accent_mint"
