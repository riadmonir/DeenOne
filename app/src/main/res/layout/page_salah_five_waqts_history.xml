                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="3.5dp"
                        android:text="আব্দুল্লাহ ইবনে ওমর (রাঃ) হতে বর্ণিত, তিনি বলেন যে, রাসুলুল্লাহ (সাঃ) বলেছেন, 'ইসলাম পাঁচটি স্তম্ভের উপর প্রতিষ্ঠিত: আল্লাহর একত্ববাদের সাক্ষ্য দেয়া, নামাজ কায়েম করা, যাকাত প্রদান করা, রমযানের সাওম পালন করা এবং বায়তুল্লাহ গমন করা।"
                        android:textColor="@color/text_primary"
