<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_top_bar"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- Back Button with Circular Container -->
        <FrameLayout android:id="@+id/btnBackFiftyRewardHistory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circular_counter"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/accent_mint" />
        </FrameLayout>

        <!-- Header Title -->
        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="পাঁচ ওয়াক্ত নামাজ পড়লেই পঞ্চাশ ওয়াক্তের সাওয়াব"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Settings Gear Action Button with Circular Container -->
        <FrameLayout android:id="@+id/btnSettingsFiftyRewardHistory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circular_counter"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                app:tint="@color/accent_mint" />
        </FrameLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollHistoryContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Main Topic Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFiftyRewardMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Card Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvCardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:lineSpacingExtra="3dp"
                            android:text="পাঁচ ওয়াক্ত নামাজ পড়লে পঞ্চাশ ওয়াক্ত নামাজের সওয়াব পাওয়া যায় কিভাবে"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <!-- Three dots button -->
                        <FrameLayout
                            android:id="@+id/btnMenuCardFiftyReward"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_glassy_icon_button"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_more_horiz"
                                app:tint="@color/text_primary" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Intro Paragraph -->
                    <TextView
                        android:id="@+id/tvRewardIntro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="4dp"
                        android:text="মেরাজের রাতে আল্লাহ তাআলা রাসুলুল্লাহ (সাঃ) কে প্রথমে ৫০ ওয়াক্ত নামাজের আদেশ দেন। তবে পরে মুসা (আঃ)-এর পরামর্শে রাসুলুল্লাহ (সাঃ) আল্লাহর কাছে নামাজের সংখ্যা কমানোর অনুরোধ করেন এবং শেষ পর্যন্ত এটি ৫ ওয়াক্তে নির্ধারিত হয়। তবে আল্লাহ তাআলা ৫ ওয়াক্ত নামাজ পড়ার ফলে ৫০ ওয়াক্ত নামাজের সওয়াব দেয়ার প্রতিশ্রুতি দেন।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <!-- Subheading: হাদিসের বর্ণনা - -->
                    <TextView
                        android:id="@+id/tvSubheadingHadithDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="হাদিসের বর্ণনা -"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHadithDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="4dp"
                        android:text="এই বিষয়ে বিভিন্ন হাদিস বর্ণিত হয়েছে। সহীহ বুখারি ও মুসলিমে উল্লেখিত হাদিস থেকে বিষয়টি স্পষ্ট হয়ে ওঠে।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <!-- Quote 1: বুখারি ৩৪৯ -->
                    <TextView
                        android:id="@+id/tvRewardHadithQuote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="4dp"
                        android:text="&quot;মেরাজের রাতে নবী মুহাম্মদ (সাঃ) আল্লাহর সাথে সাক্ষাৎ করেন এবং আল্লাহ তাকে ৫০ ওয়াক্ত নামাজের আদেশ দেন। পরবর্তীতে মুসা (আঃ)-এর পরামর্শে আল্লাহ তা ৫ ওয়াক্তে কমিয়ে দেন। আল্লাহ তাআলা বলেন, 'এই ৫ ওয়াক্ত নামাজ ৫০ ওয়াক্ত নামাজের সমান হবে এবং আমার কথা কখনও পরিবর্তিত হয় না।'&quot;"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvHadithRef"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="সহীহ বুখারী: ৩৪৯"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Subheading: সওয়াবের ব্যাখ্যা- -->
                    <TextView
                        android:id="@+id/tvSubheadingRewardExplanation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="সওয়াবের ব্যাখ্যা-"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvExplanationIntro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="4dp"
                        android:text="আল্লাহর করুণা এবং দয়া এমন যে, তিনি ৫ ওয়াক্ত নামাজ পড়ার পরও ৫০ ওয়াক্ত নামাজের সওয়াব প্রদান করেন। এর ব্যাখ্যা নিম্নরূপ হতে পারে:"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <!-- Sub-point 1: আল্লাহর অনুগ্রহ -->
                    <TextView
                        android:id="@+id/tvGracePoint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3.5dp"
                        android:text="আল্লাহর অনুগ্রহ: আল্লাহর অনুগ্রহ অপরিসীম। তিনি তাঁর বান্দাদের উপর সহজসাধ্য ইবাদতের মাধ্যমে অধিক সওয়াব প্রদানের প্রতিশ্রুতি দেন।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <!-- Sub-point 2: মহান প্রজ্ঞা -->
                    <TextView
                        android:id="@+id/tvWisdomPoint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3.5dp"
                        android:text="মহান প্রজ্ঞা: আল্লাহ তাআলার মহত্ব এবং প্রজ্ঞা অনুযায়ী, তিনি তাঁর বান্দাদের অল্প ইবাদতের মাধ্যমে অধিক পুরস্কার প্রদান করতে সক্ষম।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <!-- Sub-point 3: নিয়তের মূল্য -->
                    <TextView
                        android:id="@+id/tvIntentionPoint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3.5dp"
                        android:text="নিয়তের মূল্য: ইসলামে নিয়ত বা উদ্দেশ্য খুবই গুরুত্বপূর্ণ। যখন একজন মুসলিম সঠিক নিয়তে ৫ ওয়াক্ত নামাজ আদায় করেন, আল্লাহ তার উদ্দেশ্য এবং ইবাদতের মূল্যায়ন করেন এবং তাকে অধিক সওয়াব প্রদান করেন।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <!-- Subheading: উপসংহার - -->
                    <TextView
                        android:id="@+id/tvSubheadingConclusion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="উপসংহার -"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvConclusionDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="4dp"
                        android:text="৫ ওয়াক্ত নামাজের মাধ্যমে ৫০ ওয়াক্ত নামাজের সওয়াব পাওয়ার বিষয়টি আল্লাহ তাআলার এক বিশেষ করুণা এবং দয়া। এটি মুসলিমদের জন্য একটি বড় প্রেরণা এবং পুরস্কার। আল্লাহর আদেশ এবং প্রজ্ঞা অনুযায়ী, এই বিধান মুসলিম উম্মাহর জন্য একটি বড় নিয়ামত হিসেবে গণ্য হয়।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
