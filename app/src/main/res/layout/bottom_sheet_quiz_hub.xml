<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/bg_main"
  android:orientation="vertical">

  <!-- Global Top App Bar -->
  <RelativeLayout
    android:id="@+id/layoutTopHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <FrameLayout
      android:id="@+id/btnCloseQuizSheet"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:layout_alignParentStart="true"
      android:layout_centerVertical="true"
      android:background="@drawable/bg_circular_counter"
      android:backgroundTint="@color/bg_badge_pill"
      android:clickable="true"
      android:focusable="true">

      <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_arrow_back"
        app:tint="#34D399" />
    </FrameLayout>

    <!-- Center: DeenOne Brand Logo -->
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_centerInParent="true"
      android:gravity="center"
      android:orientation="horizontal">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Deen"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="One"
        android:textColor="#34D399"
        android:textSize="22sp"
        android:textStyle="bold" />
    </LinearLayout>

    <!-- Right: Theme Toggle + Standing Divider + Notification Bell -->
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_alignParentEnd="true"
      android:layout_centerVertical="true"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <FrameLayout
        android:id="@+id/btnQuizThemeToggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circular_counter"
        android:backgroundTint="@color/bg_badge_pill"
        android:clickable="true"
        android:focusable="true">

        <ImageView
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_gravity="center"
          android:src="@drawable/ic_moon"
          app:tint="#34D399" />
      </FrameLayout>

      <View
        android:layout_width="1.5dp"
        android:layout_height="20dp"
        android:layout_marginHorizontal="6dp"
        android:background="@color/border_card" />

      <FrameLayout
        android:id="@+id/btnQuizNotification"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circular_counter"
        android:backgroundTint="@color/bg_badge_pill"
        android:clickable="true"
        android:focusable="true">

        <ImageView
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_gravity="center"
          android:src="@drawable/ic_notifications"
          app:tint="#34D399" />

        <View
          android:layout_width="8dp"
          android:layout_height="8dp"
          android:layout_gravity="top|end"
          android:layout_marginTop="7dp"
          android:layout_marginEnd="7dp"
          android:background="@drawable/bg_circular_counter"
          android:backgroundTint="#EF4444" />
      </FrameLayout>
    </LinearLayout>
  </RelativeLayout>

  <!-- Subheader: Page Title & Points Badge -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginEnd="12dp"
      android:orientation="vertical">

      <TextView
        android:id="@+id/tvQuizHubTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ইসলামিক কুইজ হাব"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/tvQuizHubSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="দৈনিক ১০টি কুইজ ও সহীহ হাদিস রেফারেন্স"
        android:textColor="@color/text_secondary"
        android:textSize="11.5sp" />
    </LinearLayout>

    <TextView
      android:id="@+id/tvQuizPointsBadge"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/bg_badge_pill"
      android:paddingHorizontal="10dp"
      android:paddingVertical="5dp"
      android:text="০ পয়েন্ট"
      android:textColor="@color/accent_mint"
      android:textSize="12sp"
      android:textStyle="bold" />
  </LinearLayout>

  <View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:background="@color/border_card" />

  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="40dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <!-- ========================================================= -->
      <!-- QUIZ HUB HERO CARD (হুবহু স্ক্রিনশট অনুযায়ী কুইজ ব্যানার) -->
      <!-- ========================================================= -->
      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQuizHubHeroSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:cardBackgroundColor="#061A13"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="#143C2E"
        app:strokeWidth="1.2dp">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="20dp"
          android:paddingTop="20dp"
          android:paddingBottom="20dp">

          <!-- TOP: Tag Badge (⚡ ঈমান বৃদ্ধি ও যাচাই) -->
          <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_quiz_hero_tag_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <ImageView
              android:layout_width="14dp"
              android:layout_height="14dp"
              android:src="@drawable/ic_lightning"
              app:tint="#34D399" />

            <TextView
              android:id="@+id/tvQuizTagBadgeSheet"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="6dp"
              android:text="ঈমান বৃদ্ধি ও যাচাই"
              android:textColor="#34D399"
              android:textSize="12sp"
              android:textStyle="bold" />
          </LinearLayout>

          <!-- MAIN HEADLINE: কুইজ খেলে জ্ঞান অর্জন করুন -->
          <TextView
            android:id="@+id/tvQuizHubMainTitleSheet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-black"
            android:lineSpacingMultiplier="1.05"
            android:text="কুইজ খেলে জ্ঞান অর্জন করুন"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

          <!-- SUBTITLE / DESCRIPTION: ইসলামিক কুইজ প্রতিযোগিতায় অংশ নিয়ে আপনার মেধা যাচাই করুন এবং পয়েন্ট অর্জন করুন। -->
          <TextView
            android:id="@+id/tvQuizHubMainSubtitleSheet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:lineSpacingExtra="3.5dp"
            android:text="ইসলামিক কুইজ প্রতিযোগিতায় অংশ নিয়ে আপনার মেধা যাচাই করুন এবং পয়েন্ট অর্জন করুন।"
            android:textColor="#94A3B8"
            android:textSize="13.5sp" />

          <!-- ACTION BUTTON: 🏆 কুইজ র‍্যাংক তালিকা -->
          <LinearLayout
            android:id="@+id/btnQuizRankListSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_orange_gradient_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="13dp"
            android:paddingHorizontal="16dp">

            <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:layout_marginEnd="8dp"
              android:src="@drawable/ic_nav_rank"
              app:tint="#FFFFFF" />

            <TextView
              android:id="@+id/tvQuizRankBtnTextSheet"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="কুইজ র‍্যাংক তালিকা"
              android:textColor="#FFFFFF"
              android:textSize="15.5sp"
              android:textStyle="bold" />
          </LinearLayout>

        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- ========================================================= -->
      <!-- QUIZ CATEGORIES SECTION (একটার নিচে একটা ভার্টিক্যাল লিস্ট) -->
      <!-- ========================================================= -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/tvQuizCategoriesSectionTitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="কুইজ বিষয় ও ক্যাটাগরি"
          android:textColor="@color/text_primary"
          android:textSize="16sp"
          android:textStyle="bold" />

        <View
          android:layout_width="0dp"
          android:layout_height="0dp"
          android:layout_weight="1" />

        <TextView
          android:id="@+id/tvQuizCategoriesCountBadge"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_badge_pill"
          android:paddingHorizontal="8dp"
          android:paddingVertical="2dp"
          android:text="ক্যাটাগরি"
          android:textColor="@color/accent_mint"
          android:textSize="11sp"
          android:textStyle="bold" />
      </LinearLayout>

      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQuizCategoriesVertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:nestedScrollingEnabled="false" />

    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</LinearLayout>