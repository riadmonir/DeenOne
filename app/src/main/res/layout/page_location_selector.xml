<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/bg_main">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- TOP BAR (Matching Screenshot) -->
    <RelativeLayout
      android:id="@+id/topBarLocation"
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:background="@color/bg_top_bar"
      android:paddingHorizontal="16dp">

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView android:id="@+id/btnBackLocationSelector"
          android:layout_width="36dp"
          android:layout_height="36dp"
          android:background="@drawable/bg_badge_pill"
          android:clickable="true"
          android:focusable="true"
          android:padding="6dp"
          android:src="@drawable/ic_arrow_back"
          app:tint="@color/accent_mint" />

        <ImageView
          android:layout_width="26dp"
          android:layout_height="26dp"
          android:layout_marginStart="6dp"
          android:src="@drawable/ic_deenone_logo"
          app:tint="@color/text_primary" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:fontFamily="sans-serif-black"
          android:text="DeenOne"
          android:textColor="@color/text_primary"
          android:textSize="20sp"
          android:textStyle="bold" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Dark Mode Toggle -->
        <FrameLayout
          android:id="@+id/btnLocationThemeToggle"
          android:layout_width="38dp"
          android:layout_height="38dp"
          android:background="@drawable/bg_card_secondary"
          android:backgroundTint="@color/bg_badge_pill"
          android:clickable="true"
          android:focusable="true">

          <ImageView
            android:id="@+id/ivLocationThemeIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_moon"
            app:tint="@color/accent_mint" />
        </FrameLayout>

        <!-- Notification Bell -->
        <FrameLayout
          android:id="@+id/btnLocationNotification"
          android:layout_width="38dp"
          android:layout_height="38dp"
          android:layout_marginStart="8dp"
          android:background="@drawable/bg_card_secondary"
          android:backgroundTint="@color/bg_badge_pill"
          android:clickable="true"
          android:focusable="true">

          <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_notifications"
            app:tint="@color/accent_mint" />

          <View
            android:id="@+id/badgeNotificationDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/pill_badge_bg"
            android:backgroundTint="#EF4444"
            android:visibility="gone" />
        </FrameLayout>

        <!-- Menu / Close -->
        <FrameLayout
          android:id="@+id/btnCloseLocationSelector"
          android:layout_width="38dp"
          android:layout_height="38dp"
          android:layout_marginStart="8dp"
          android:background="@drawable/bg_card_secondary"
          android:backgroundTint="@color/bg_badge_pill"
          android:clickable="true"
          android:focusable="true">

          <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_menu"
            app:tint="@color/accent_mint" />
        </FrameLayout>
      </LinearLayout>
    </RelativeLayout>

    <!-- SCROLLABLE CONTENT -->
    <androidx.core.widget.NestedScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:fillViewport="true"
      android:overScrollMode="never">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="36dp">

        <!-- 1. HERO LIVE PREVIEW CARD (Screenshot 1 Exact) -->
        <com.google.android.material.card.MaterialCardView
          android:id="@+id/cardLiveClockPreview"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/bg_card"
          app:cardCornerRadius="22dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/border_card"
          app:strokeWidth="1.2dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp">

            <!-- Live Preview Dot Header -->
            <TextView
              android:id="@+id/tvLivePreviewBadge"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:letterSpacing="0.05"
              android:text="● লাইভ প্রিভিউ"
              android:textColor="@color/accent_mint"
              android:textSize="12sp"
              android:textStyle="bold" />

            <!-- Big Clock Time (Bengali Digits) -->
            <TextView
              android:id="@+id/tvLiveClockTime"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:fontFamily="sans-serif-black"
              android:text="অপরাহ্ন ০৮:২০:৫৪"
              android:textColor="@color/text_primary"
              android:textSize="28sp"
              android:textStyle="bold" />

            <!-- Bengali Date -->
            <TextView
              android:id="@+id/tvLiveClockDate"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:text="রবিবার, ২৩ আগস্ট ২০২৬"
              android:textColor="@color/accent_mint"
              android:textSize="13.5sp"
              android:textStyle="bold" />

            <View
              android:layout_width="match_parent"
              android:layout_height="1dp"
              android:layout_marginVertical="14dp"
              android:background="@color/border_card" />

            <!-- Timezone / Location Pill -->
            <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:gravity="center"
              android:orientation="horizontal">

              <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_globe"
                app:tint="@color/text_secondary" />

              <TextView
                android:id="@+id/tvLiveTimezoneBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Asia/Dhaka"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
            </LinearLayout>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. STATUS PILL (Screenshot 1 Exact) -->
        <com.google.android.material.card.MaterialCardView
          android:id="@+id/cardLocationStatusPill"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="14dp"
          app:cardBackgroundColor="@color/bg_card"
          app:cardCornerRadius="16dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/border_card"
          app:strokeWidth="1.2dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <ImageView
              android:id="@+id/ivStatusCheckIcon"
              android:layout_width="22dp"
              android:layout_height="22dp"
              android:src="@drawable/ic_check_circle"
              app:tint="@color/accent_mint" />

            <TextView
              android:id="@+id/tvLocationStatusMessage"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="12dp"
              android:layout_weight="1"
              android:text="জিপিএস লোকেশন সফলভাবে সনাক্ত করা হয়েছে।"
              android:textColor="@color/accent_mint"
              android:textSize="13sp"
              android:textStyle="bold" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. SECTION TITLE: লোকেশন মোড সিলেক্ট করুন -->
        <TextView
          android:id="@+id/tvSectionLocationModeTitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="20dp"
          android:layout_marginBottom="12dp"
          android:text="লোকেশন মোড সিলেক্ট করুন"
          android:textColor="@color/accent_mint"
          android:textSize="13.5sp"
          android:textStyle="bold" />

        <!-- MODE CARD 1: অটো ডিটেকশন (প্রস্তাবিত) -->
        <com.google.android.material.card.MaterialCardView
          android:id="@+id/cardModeAutoGps"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="10dp"
          android:clickable="true"
          android:focusable="true"
          app:cardBackgroundColor="@color/bg_card_active"
          app:cardCornerRadius="18dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/accent_mint"
          app:strokeWidth="1.5dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Icon Container -->
            <FrameLayout
              android:id="@+id/flModeAutoIconBox"
              android:layout_width="44dp"
              android:layout_height="44dp"
              android:background="@drawable/bg_card_secondary"
              android:backgroundTint="@color/bg_badge_pill">

              <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_compass"
                app:tint="@color/accent_mint" />
            </FrameLayout>

            <!-- Text Info -->
            <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="14dp"
              android:layout_weight="1"
              android:orientation="vertical">

              <TextView
                android:id="@+id/tvModeAutoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="অটো ডিটেকশন"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

              <TextView
                android:id="@+id/tvModeAutoSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="জিপিএস এবং রিয়েল-টাইম লোকেশন ব্যবহার করবে"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Radio Checkmark Indicator -->
            <ImageView
              android:id="@+id/ivModeAutoCheck"
              android:layout_width="22dp"
              android:layout_height="22dp"
              android:layout_marginStart="8dp"
              android:src="@drawable/ic_check_circle"
              app:tint="@color/accent_mint" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- MODE CARD 2: শুধুমাত্র টাইমজোন -->
        <com.google.android.material.card.MaterialCardView
          android:id="@+id/cardModeTimezoneOnly"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="10dp"
          android:clickable="true"
          android:focusable="true"
          app:cardBackgroundColor="@color/bg_card"
          app:cardCornerRadius="18dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/border_card"
          app:strokeWidth="1.2dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
              android:id="@+id/flModeTimezoneIconBox"
              android:layout_width="44dp"
              android:layout_height="44dp"
              android:background="@drawable/bg_card_secondary"
              android:backgroundTint="@color/bg_badge_pill">

              <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_clock"
                app:tint="@color/accent_mint" />
            </FrameLayout>

            <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="14dp"
              android:layout_weight="1"
              android:orientation="vertical">

              <TextView
                android:id="@+id/tvModeTimezoneTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="শুধুমাত্র টাইমজোন"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

              <TextView
                android:id="@+id/tvModeTimezoneSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="আপনার এলাকার টাইমজোন অনুযায়ী আনুমানিক সময়"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
            </LinearLayout>

            <ImageView
              android:id="@+id/ivModeTimezoneCheck"
              android:layout_width="22dp"
              android:layout_height="22dp"
              android:layout_marginStart="8dp"
              android:src="@drawable/ic_check_circle"
              android:visibility="gone"
              app:tint="@color/accent_mint" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- MODE CARD 3: ম্যানুয়াল সিলেকশন -->
        <com.google.android.material.card.MaterialCardView
          android:id="@+id/cardModeManualSelection"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="14dp"
          android:clickable="true"
          android:focusable="true"
          app:cardBackgroundColor="@color/bg_card"
          app:cardCornerRadius="18dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/border_card"
          app:strokeWidth="1.2dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
              android:id="@+id/flModeManualIconBox"
              android:layout_width="44dp"
              android:layout_height="44dp"
              android:background="@drawable/bg_card_secondary"
              android:backgroundTint="@color/bg_badge_pill">

              <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_location_pin"
                app:tint="@color/accent_mint" />
            </FrameLayout>

            <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="14dp"
              android:layout_weight="1"
              android:orientation="vertical">

              <TextView
                android:id="@+id/tvModeManualTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ম্যানুয়াল সিলেকশন"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

              <TextView
                android:id="@+id/tvModeManualSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="নিজে থেকে স্থানাঙ্ক বা টাইমজোন নির্বাচন করবেন"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
            </LinearLayout>

            <ImageView
              android:id="@+id/ivModeManualCheck"
              android:layout_width="22dp"
              android:layout_height="22dp"
              android:layout_marginStart="8dp"
              android:src="@drawable/ic_check_circle"
              android:visibility="gone"
              app:tint="@color/accent_mint" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========================================================= -->
        <!-- DYNAMIC SUB-VIEW 1: AUTO GPS SUB-PANEL (Screenshot 4) -->
        <!-- ========================================================= -->
        <LinearLayout
          android:id="@+id/layoutAutoGpsSubView"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:visibility="visible">

          <TextView
            android:id="@+id/tvGpsCoordinatesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:text="জি-পি-এস স্থানাঙ্ক"
            android:textColor="@color/accent_mint"
            android:textSize="13sp"
            android:textStyle="bold" />

          <!-- Coordinates Display Card (Screenshot 4) -->
          <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGpsCoordinatesBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_card"
            app:strokeWidth="1.2dp">

            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:orientation="horizontal"
              android:paddingHorizontal="16dp"
              android:paddingVertical="14dp">

              <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_gps_fixed"
                app:tint="@color/accent_mint" />

              <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                  android:id="@+id/tvGpsLatVal"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="অক্ষাংশ: ২৮.৩৯৯৬৯"
                  android:textColor="@color/text_primary"
                  android:textSize="14sp"
                  android:textStyle="bold" />

                <TextView
                  android:id="@+id/tvGpsLngVal"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="2dp"
                  android:text="দ্রাঘিমাংশ: ৩৬.৫৭৭৪৭"
                  android:textColor="@color/text_primary"
                  android:textSize="14sp"
                  android:textStyle="bold" />
              </LinearLayout>

              <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_target_bullseye"
                app:tint="@color/accent_mint" />
            </LinearLayout>
          </com.google.android.material.card.MaterialCardView>

          <!-- Timezone Auto Header -->
          <TextView
            android:id="@+id/tvGpsAutoTimezoneLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="টাইমজোন ড্রপডাউন"
            android:textColor="@color/accent_mint"
            android:textSize="13sp"
            android:textStyle="bold" />

          <!-- Timezone Auto Display Box -->
          <LinearLayout
            android:id="@+id/layoutGpsAutoTimezonePill"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
              android:id="@+id/tvGpsAutoTimezoneName"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="Asia/Dhaka"
              android:textColor="@color/text_primary"
              android:textSize="14sp"
              android:textStyle="bold" />

            <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:src="@drawable/ic_chevron_down"
              app:tint="@color/text_secondary" />
          </LinearLayout>
        </LinearLayout>

        <!-- ========================================================= -->
        <!-- DYNAMIC SUB-VIEW 2: TIMEZONE ONLY SUB-PANEL (Screenshot 2) -->
        <!-- ========================================================= -->
        <LinearLayout
          android:id="@+id/layoutTimezoneOnlySubView"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:visibility="gone">

          <TextView
            android:id="@+id/tvTimezoneOnlyLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:text="টাইমজোন ড্রপডাউন"
            android:textColor="@color/accent_mint"
            android:textSize="13sp"
            android:textStyle="bold" />

          <LinearLayout
            android:id="@+id/layoutTimezoneSelectorPill"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
              android:id="@+id/tvSelectedTimezoneName"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="Asia/Riyadh"
              android:textColor="@color/text_primary"
              android:textSize="14sp"
              android:textStyle="bold" />

            <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:src="@drawable/ic_chevron_down"
              app:tint="@color/accent_mint" />
          </LinearLayout>
        </LinearLayout>

        <!-- ========================================================= -->
        <!-- DYNAMIC SUB-VIEW 3: MANUAL SELECTION SUB-PANEL (Screenshot 3) -->
        <!-- ========================================================= -->
        <LinearLayout
          android:id="@+id/layoutManualSelectionSubView"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:visibility="gone">

          <!-- Popular Districts -->
          <TextView
            android:id="@+id/tvPopularDistrictsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:text="জনপ্রিয় জেলাসমূহ"
            android:textColor="@color/accent_mint"
            android:textSize="13sp"
            android:textStyle="bold" />

          <LinearLayout
            android:id="@+id/layoutDistrictSelectorPill"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
              android:id="@+id/tvSelectedDistrictName"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="একটি জেলা সিলেক্ট করুন"
              android:textColor="@color/text_secondary"
              android:textSize="14sp" />

            <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:src="@drawable/ic_chevron_down"
              app:tint="@color/accent_mint" />
          </LinearLayout>

          <!-- Google Maps / Area Search -->
          <TextView
            android:id="@+id/tvGoogleMapsSearchLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="গুগল ম্যাপে লোকেশন খুঁজুন"
            android:textColor="@color/accent_mint"
            android:textSize="13sp"
            android:textStyle="bold" />

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:src="@drawable/ic_search"
              app:tint="@color/accent_mint" />

            <EditText
              android:id="@+id/etManualSearchLocation"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:layout_marginStart="10dp"
              android:background="@null"
              android:hint="শহর বা এলাকার নাম লিখে অনুসন্ধান করুন..."
              android:imeOptions="actionSearch"
              android:inputType="text"
              android:maxLines="1"
              android:textColor="@color/text_primary"
              android:textColorHint="@color/text_muted"
              android:textSize="13.5sp" />
          </LinearLayout>

          <!-- Lat / Lng Two Column Row -->
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- Latitude -->
            <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginEnd="6dp"
              android:layout_weight="1"
              android:orientation="vertical">

              <TextView
                android:id="@+id/tvManualLatLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="অক্ষাংশ"
                android:textColor="@color/accent_mint"
                android:textSize="12.5sp"
                android:textStyle="bold" />

              <EditText
                android:id="@+id/etManualLatitude"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_field"
                android:hint="28.39969"
                android:inputType="numberDecimal|numberSigned"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp"
                android:textStyle="bold" />
            </LinearLayout>

            <!-- Longitude -->
            <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="6dp"
              android:layout_weight="1"
              android:orientation="vertical">

              <TextView
                android:id="@+id/tvManualLngLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="দ্রাঘিমাংশ"
                android:textColor="@color/accent_mint"
                android:textSize="12.5sp"
                android:textStyle="bold" />

              <EditText
                android:id="@+id/etManualLongitude"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_field"
                android:hint="36.577475"
                android:inputType="numberDecimal|numberSigned"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp"
                android:textStyle="bold" />
            </LinearLayout>
          </LinearLayout>

          <!-- Manual Timezone Dropdown -->
          <TextView
            android:id="@+id/tvManualTimezoneLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="টাইমজোন ড্রপডাউন"
            android:textColor="@color/accent_mint"
            android:textSize="13sp"
            android:textStyle="bold" />

          <LinearLayout
            android:id="@+id/layoutManualTimezonePill"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
              android:id="@+id/tvManualTimezoneName"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="Asia/Riyadh"
              android:textColor="@color/text_primary"
              android:textSize="14sp"
              android:textStyle="bold" />

            <ImageView
              android:layout_width="20dp"
              android:layout_height="20dp"
              android:src="@drawable/ic_chevron_down"
              app:tint="@color/accent_mint" />
          </LinearLayout>
        </LinearLayout>

        <!-- SAVE BUTTON (Screenshot Exact) -->
        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnSaveLocationSettings"
          android:layout_width="match_parent"
          android:layout_height="54dp"
          android:layout_marginTop="22dp"
          android:backgroundTint="@color/accent_mint"
          android:insetTop="0dp"
          android:insetBottom="0dp"
          android:text="সেটিংস সেভ করুন"
          android:textColor="@color/white"
          android:textSize="15sp"
          android:textStyle="bold"
          app:cornerRadius="16dp"
          app:strokeColor="@color/border_active"
          app:strokeWidth="1.2dp" />

        <!-- PRO TIPS CARD (Screenshot Exact) -->
        <com.google.android.material.card.MaterialCardView
          android:id="@+id/cardProTips"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="20dp"
          app:cardBackgroundColor="@color/bg_card"
          app:cardCornerRadius="18dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/border_card"
          app:strokeWidth="1.2dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
              android:layout_width="38dp"
              android:layout_height="38dp"
              android:background="@drawable/bg_card_secondary"
              android:backgroundTint="@color/bg_badge_pill">

              <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lightbulb"
                app:tint="@color/accent_mint" />
            </FrameLayout>

            <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="12dp"
              android:layout_weight="1"
              android:orientation="vertical">

              <TextView
                android:id="@+id/tvProTipsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="প্রো টিপস"
                android:textColor="@color/accent_mint"
                android:textSize="14sp"
                android:textStyle="bold" />

              <TextView
                android:id="@+id/tvProTipsDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="সঠিক নামাজের সময়ের জন্য 'অটো ডিটেকশন' মোড সবচেয়ে কার্যকর। আপনি যদি দেশের বাইরে ভ্রমণে থাকেন, তবে এই মোড আপনার লোকেশন অনুযায়ী সময় অটো আপডেট করবে।"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
            </LinearLayout>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

      </LinearLayout>
    </androidx.core.widget.NestedScrollView>
  </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
