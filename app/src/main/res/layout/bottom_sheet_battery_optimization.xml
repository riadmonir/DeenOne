<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="28dp">

    <!-- Top Handle Indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_badge_pill"
        android:alpha="0.4" />

    <!-- Icon & Badge Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_mosque"
            android:background="@drawable/bg_circle_icon"
            android:padding="10dp"
            app:tint="@color/accent_mint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:id="@+id/tvBatterySheetBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ব্যাকগ্রাউন্ড পারমিশন"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/accent_mint"
                android:background="@drawable/bg_badge_pill"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/tvBatterySheetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আযান ও অ্যালার্ট পারমিশন"
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnBatterySheetClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/text_muted"
            android:contentDescription="বন্ধ" />
    </LinearLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvBatterySheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="সঠিক সময়ে আযান ও সালাত অ্যালার্ট নিশ্চিত করুন"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginTop="16dp" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvBatterySheetDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ফোন লক বা সাইলেন্ট থাকা অবস্থাতেও ওয়াক্তমতো নির্ভুল আযান এবং নামাজের নোটিফিকেশন পেতে DeenOne-এর ব্যাকগ্রাউন্ড অ্যাক্টিভিটি সর্বদা সচল রাখা প্রয়োজন।"
        android:textSize="13.5sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="8dp" />

    <!-- Benefit Badges Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_surface"
        android:padding="14dp"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/tvBatterySheetBenefit1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓  লক স্ক্রিনে যথাসময়ে পূর্ণ আযান বেজে উঠবে"
            android:textSize="12.5sp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvBatterySheetBenefit2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓  ফোন সাইলেন্ট বা স্লিপ মোডে থাকলেও আযান মিস হবে না"
            android:textSize="12.5sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvBatterySheetBenefit3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓  অটো-স্টার্ট ও ব্যাকগ্রাউন্ড সিঙ্ক চালু থাকবে"
            android:textSize="12.5sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="22dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBatterySheetLater"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="পরে করবো"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_btn_cancel_pill"
            app:backgroundTint="@null"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBatterySheetAllow"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.3"
            android:text="অনুমতি দিন"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_btn_save_pill"
            app:backgroundTint="@null"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
