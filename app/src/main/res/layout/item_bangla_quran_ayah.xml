<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAyahItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_card"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Ayah Number Badge, Juz Badge & Action Buttons -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:id="@+id/tvAyahNumberBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="আয়াত ১"
                        android:textColor="@color/accent_mint"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvJuzBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_madani"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="পারা ১"
                    android:textColor="@color/text_surah_madani"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Actions: Play Audio, Bookmark, Copy, Share -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnPlayAyahAudio"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_pill"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_audio_play"
                    app:tint="@color/accent_mint" />

                <ImageView
                    android:id="@+id/btnBookmarkAyah"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_pill"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_bookmark"
                    app:tint="@color/text_muted" />

                <ImageView
                    android:id="@+id/btnCopyAyah"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_pill"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/text_muted" />

                <ImageView
                    android:id="@+id/btnShareAyah"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_badge_pill"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_share"
                    app:tint="@color/accent_mint" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Arabic Uthmani Script -->
        <TextView
            android:id="@+id/tvAyahArabicText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="end"
            android:lineSpacingExtra="10dp"
            android:text="بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"
            android:textAlignment="viewEnd"
            android:textColor="@color/text_primary"
            android:textDirection="rtl"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Bangla Translation Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tafsir_box"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvTranslatorBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="অনুবাদ: মাওলানা মুহিউদ্দীন খান"
                android:textColor="@color/accent_gold"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Bangla Translation Text -->
            <TextView
                android:id="@+id/tvAyahBanglaTranslation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:text="শুরু করছি আল্লাহর নামে যিনি পরম করুণাময়, অতি দয়ালু।"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
