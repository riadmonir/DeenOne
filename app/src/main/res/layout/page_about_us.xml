<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootAboutUsContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- 1. GLOBAL TOP APP BAR (Consistent Across Entire App - Rule 14) -->
    <RelativeLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_top_bar"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Left: Back Button -->
        <FrameLayout
            android:id="@+id/btnCloseAboutUs"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circular_counter"
            android:backgroundTint="@color/bg_badge_pill"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/accent_mint" />
        </FrameLayout>

        <!-- Center: DeenOne Brand Logo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHeaderBrandDeen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deen"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderBrandOne"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="One"
                android:textColor="@color/accent_mint"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right: Theme Toggle + Standing Divider + Notification Bell -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Theme Toggle Button -->
            <FrameLayout
                android:id="@+id/btnAboutThemeToggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circular_counter"
                android:backgroundTint="@color/bg_badge_pill"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivAboutThemeIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_moon"
                    app:tint="@color/accent_mint" />
            </FrameLayout>

            <!-- Standing Vertical Divider Bar -->
            <View
                android:layout_width="1.5dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="6dp"
                android:background="@color/border_card" />

            <!-- Notification Bell with Dot Badge -->
            <FrameLayout
                android:id="@+id/btnAboutNotifications"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circular_counter"
                android:backgroundTint="@color/bg_badge_pill"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/accent_mint" />
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. SCROLLABLE BODY CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. HERO BRAND CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAboutHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="24dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvHeroBrandDeen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Deen"
                            android:textColor="@color/text_primary"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeroBrandOne"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="One"
                            android:textColor="@color/accent_mint"
                            android:textSize="32sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAboutTagline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="আপনার দ্বীনি জীবনের বিশ্বস্ত নিত্যসঙ্গী"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. APP VERSION CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAboutVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="@color/bg_badge_pill">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_info"
                            app:tint="@color/accent_mint" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvVersionLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="অ্যাপ সংস্করণ"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvVersionNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="v২.০.০"
                            android:textColor="@color/accent_mint"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Latest Version Pill Badge -->
                    <TextView
                        android:id="@+id/btnVersionBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="@color/bg_badge_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="সর্বশেষ সংস্করণ"
                        android:textColor="@color/accent_mint"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. SECTION HEADING: অ্যাপ্লিকেশন ডেভেলপার / টিম -->
            <TextView
                android:id="@+id/tvDevelopersHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="অ্যাপ্লিকেশন ডেভেলপার"
                android:textColor="@color/accent_mint"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Dynamic Team Members Container -->
            <LinearLayout
                android:id="@+id/layoutTeamMembersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:orientation="vertical" />

            <!-- 4. MISSION & GOALS CARD (আমাদের লক্ষ্য) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAboutMission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="20dp">

                    <TextView
                        android:id="@+id/tvMissionHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="আমাদের লক্ষ্য"
                        android:textColor="@color/accent_mint"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMissionDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingMultiplier="1.3"
                        android:text="দ্বীনওয়ান (DeenOne) হলো একটি সর্বাধুনিক ও শতভাগ প্রামাণিক ইসলামিক জীবনধারা ট্র্যাকিং প্ল্যাটফর্ম, যা মুসলিম উম্মাহকে তাদের দৈনন্দিন সালাত, ইবাদত, আমল ও আধ্যাত্মিক অনুশীলনে সাহায্য করার জন্য তৈরি করা হয়েছে।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <!-- Inner Motto / Quote Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="@color/bg_badge_pill"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvMissionQuote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.25"
                            android:text="“আমাদের উদ্দেশ্য হলো সর্বাধুনিক প্রযুক্তির মাধ্যমে উম্মাহর আধ্যাত্মিক ও দ্বীনি উন্নতিতে সহায়তা করা।”"
                            android:textColor="@color/accent_mint"
                            android:textSize="13.5sp"
                            android:textStyle="italic" />
                    </LinearLayout>

                    <!-- Pill Tags Row -->
                    <LinearLayout
                        android:id="@+id/layoutPillsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/pill1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="@color/bg_badge_pill"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="7dp"
                            android:text="আধ্যাত্মিকতা"
                            android:textColor="@color/accent_mint"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/pill2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="@color/bg_badge_pill"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="7dp"
                            android:text="সুন্নাহ"
                            android:textColor="@color/accent_mint"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/pill3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="@color/bg_badge_pill"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="7dp"
                            android:text="প্রযুক্তি"
                            android:textColor="@color/accent_mint"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/pill4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="@color/bg_badge_pill"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="7dp"
                            android:text="উম্মাহ"
                            android:textColor="@color/accent_mint"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 5. SIGNATURE HALLMARKS CARD (Authentic DeenOne Core Values) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="18dp">

                    <TextView
                        android:id="@+id/tvValuesTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="দ্বীনওয়ানের মূল অঙ্গীকার"
                        android:textColor="@color/accent_mint"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Feature 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/accent_mint" />

                        <TextView
                            android:id="@+id/tvValue1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="১০০% সহীহ ও প্রামাণিক ইসলামিক তথ্য নীতি"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <!-- Feature 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/accent_mint" />

                        <TextView
                            android:id="@+id/tvValue2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="শতভাগ বিজ্ঞাপনমুক্ত ও নিরাপদ অভিজ্ঞতা"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <!-- Feature 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/accent_mint" />

                        <TextView
                            android:id="@+id/tvValue3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="অফলাইন ফার্স্ট ও ব্যক্তিগত তথ্য সুরক্ষামূলক আর্কিটেকচার"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 6. FOOTER: COPYRIGHT -->
            <TextView
                android:id="@+id/tvAboutFooterCopyright"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="© ২০২৬ DeenOne - সর্বস্বত্ব সংরক্ষিত"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
