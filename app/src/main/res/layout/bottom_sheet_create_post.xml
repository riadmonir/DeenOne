<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/bg_card_surface"
  android:orientation="vertical"
  android:padding="20dp">

  <View
    android:layout_width="40dp"
    android:layout_height="4dp"
    android:layout_gravity="center"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_badge_pill" />

  <TextView
    android:id="@+id/tvCreatePostHeaderTitle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="দ্বীনি পোস্ট প্রকাশ করুন"
    android:textColor="@color/text_primary"
    android:textSize="18sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/tvCreatePostHeaderSubtitle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:text="কোরআন, সুন্নাহ ও উম্মাহর কল্যাণে ভালো কথা প্রচার করুন"
    android:textColor="@color/text_secondary"
    android:textSize="12sp" />

  <!-- Category Dropdown / Selector -->
  <TextView
    android:id="@+id/tvCreatePostCategoryLabel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:text="বিষয়শ্রেণী নির্বাচন করুন"
    android:textColor="@color/accent_mint"
    android:textSize="12sp"
    android:textStyle="bold" />

  <RadioGroup
    android:id="@+id/rgPostCategory"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:orientation="horizontal">

    <RadioButton
      android:id="@+id/rbCatDua"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:checked="true"
      android:text="দোয়া"
      android:textColor="@color/text_primary"
      android:textSize="12.5sp" />

    <RadioButton
      android:id="@+id/rbCatAdvice"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:text="নসীহত"
      android:textColor="@color/text_primary"
      android:textSize="12.5sp" />

    <RadioButton
      android:id="@+id/rbCatQA"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:text="জিজ্ঞাসা"
      android:textColor="@color/text_primary"
      android:textSize="12.5sp" />
  </RadioGroup>

  <!-- Title Input -->
  <com.google.android.material.textfield.TextInputLayout
    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:hint="শিরোনাম লিখুন"
    app:boxStrokeColor="@color/accent_mint">

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/etNewPostTitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textColor="@color/text_primary"
      android:textSize="14sp" />
  </com.google.android.material.textfield.TextInputLayout>

  <!-- Content Body Input -->
  <com.google.android.material.textfield.TextInputLayout
    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:hint="বিস্তারিত বক্তব্য / দোয়া লিখুন..."
    app:boxStrokeColor="@color/accent_mint">

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/etNewPostContent"
      android:layout_width="match_parent"
      android:layout_height="120dp"
      android:gravity="top"
      android:inputType="textMultiLine"
      android:textColor="@color/text_primary"
      android:textSize="14sp" />
  </com.google.android.material.textfield.TextInputLayout>

  <!-- Submit Button -->
  <com.google.android.material.button.MaterialButton
    android:id="@+id/btnSubmitNewPost"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:layout_marginTop="18dp"
    android:backgroundTint="@color/accent_mint"
    android:text="পোস্ট প্রকাশ করুন"
    android:textColor="@color/btn_save_text"
    android:textSize="15sp"
    android:textStyle="bold"
    app:cornerRadius="14dp" />

</LinearLayout>