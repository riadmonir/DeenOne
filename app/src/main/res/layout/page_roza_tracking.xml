<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- 1. Top Action Bar -->
    <LinearLayout
        android:id="@+id/layoutRozaTrackingTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnCloseRozaTracking"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_badge_pill"
            android:contentDescription="ফিরে যান"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/accent_mint" />

        <TextView
            android:id="@+id/tvRozaTrackingHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="রোজা ট্র্যাকিং"
            android:textColor="@color/text_primary"
            android:textSize="18.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Content to guarantee all device stability -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 2. Month Navigation Header with Theme-Aware Card Background -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_card"
                android:orientation="vertical"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageButton
                        android:id="@+id/btnPrevMonth"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="@color/bg_badge_pill"
                        android:contentDescription="পূর্ববর্তী মাস"
                        android:src="@drawable/ic_chevron_left"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvCurrentMonthYear"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="সেপ্টেম্বর ২০২৬"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnNextMonth"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="@color/bg_badge_pill"
                        android:contentDescription="পরবর্তী মাস"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_primary" />
                </LinearLayout>

                <!-- Subtitle: Hijri Date Range for this month -->
                <TextView
                    android:id="@+id/tvMonthHijriRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="১৮ রবিউল আউয়াল, ১৪৪৮ হিজরী থেকে ১৭ রবিউস সানি, ১৪৪৮ হিজরী"
                    android:textColor="@color/accent_gold"
                    android:textSize="12sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_card" />

            <!-- 3. Weekday Header Row (7 equal columns, Friday in Red) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_main"
                android:orientation="horizontal"
                android:paddingVertical="10dp"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/tvDaySun"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="রবি"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDayMon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="সোম"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDayTue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="মঙ্গল"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDayWed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="বুধ"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDayThu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="বৃহস্পতি"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDayFri"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="শুক্র"
                    android:textColor="@color/accent_red"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDaySat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="শনি"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_card" />

            <!-- 4. Calendar Days Grid (7 columns) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRozaCalendarGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginHorizontal="12dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- 5. Bottom Selected Day Fasting Action Card (Theme Aware Dark/Light Mode) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSelectedDayRoza"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- Decorative Crescent Lantern Illustration in Top-Right Corner -->
                    <ImageView
                        android:id="@+id/ivCrescentLanternIllustration"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:alpha="0.25"
                        android:contentDescription="হিজরী চাঁদ ও লণ্ঠন"
                        android:src="@drawable/ic_crescent_lantern_card"
                        app:tint="@color/accent_gold" />

                    <!-- Top Left: Gregorian + Bengali Date Line -->
                    <TextView
                        android:id="@+id/tvSelectedDayGregorianBengali"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/ivCrescentLanternIllustration"
                        android:layout_alignParentStart="true"
                        android:text="Tuesday, 15 September 2026 • ০১ ভাদ্র, ১৪৩৩"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <!-- Prominent Golden Hijri Date -->
                    <TextView
                        android:id="@+id/tvSelectedDayHijri"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvSelectedDayGregorianBengali"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/ivCrescentLanternIllustration"
                        android:layout_marginTop="4dp"
                        android:text="২ রবিউস সানি, ১৪৪৮ হিজরী"
                        android:textColor="@color/accent_gold"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Question: "আজ রোজা আছেন?" + Counter: "০/৬০" -->
                    <RelativeLayout
                        android:id="@+id/layoutQuestionAndCounter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvSelectedDayHijri"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:id="@+id/tvAreYouFastingTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="আজ রোজা আছেন?"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvFastingCounterFraction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="০/৬০"
                            android:textColor="@color/accent_mint"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Horizontal Progress Divider Line -->
                    <ProgressBar
                        android:id="@+id/progressFastingLine"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3.5dp"
                        android:layout_below="@id/layoutQuestionAndCounter"
                        android:layout_marginTop="8dp"
                        android:max="60"
                        android:progress="0"
                        android:progressDrawable="@drawable/progress_waqt_mint_horizontal" />

                    <!-- Dual Toggle Pill Container: "◯ হ্যাঁ রোজা আছি" vs "✓ এখনো না" (Split Pills) -->
                    <LinearLayout
                        android:id="@+id/layoutFastingToggleContainer"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_below="@id/progressFastingLine"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Left Pill: হ্যাঁ, রোজা আছি -->
                        <LinearLayout
                            android:id="@+id/btnYesFasting"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="@color/bg_badge_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivYesFastingRadio"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="6dp"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvYesFastingText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="হ্যাঁ, রোজা আছি"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Right Pill: এখনো না -->
                        <LinearLayout
                            android:id="@+id/btnNotYetFasting"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="@color/bg_badge_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivNotYetRadio"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="6dp"
                                android:src="@drawable/ic_radio_circle_empty"
                                app:tint="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvNotYetText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="এখনো না"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
