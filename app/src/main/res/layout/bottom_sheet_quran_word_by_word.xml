<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded_top"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_badge_pill"
        android:backgroundTint="@color/border_card" />

    <!-- Header Row (Matching Screenshots 2 & 3) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <!-- Left: Translate Icon + শব্দে শব্দে অর্থ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivWbwHeaderIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_translate"
                app:tint="@color/accent_mint" />

            <TextView
                android:id="@+id/tvWbwHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="শব্দে শব্দে অর্থ"
                android:textColor="@color/accent_mint"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right: Surah Name • Ayah Number -->
        <TextView
            android:id="@+id/tvWbwSurahAyahRef"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="কুরাইশ • আয়াত ১"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </RelativeLayout>

    <!-- State 1: Empty / Not Downloaded State (Matching Screenshot 2) -->
    <LinearLayout
        android:id="@+id/llWbwNotDownloadedContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="16dp"
        android:visibility="visible">

        <ImageView
            android:id="@+id/ivWbwEmptyIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_translate"
            app:tint="@color/text_muted" />

        <TextView
            android:id="@+id/tvWbwEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="এই সূরার শব্দার্থ এখনো নামানো হয়নি।"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWbwEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="একবার নামালে পুরো সূরাই অফলাইনে পড়া যাবে।"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Download Action Button (Rule 7: Touch Animation ONLY on Buttons) -->
        <FrameLayout
            android:id="@+id/btnDownloadWbwNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="@color/accent_teal"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:id="@+id/llDownloadWbwContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivDownloadWbwIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_download"
                    app:tint="#042F2E" />

                <TextView
                    android:id="@+id/tvDownloadWbwText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="শব্দার্থ নামান"
                    android:textColor="#042F2E"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbDownloadWbw"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="#042F2E"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- State 2: Words Display Container (Wrap Flow, Responsive, No Sliding) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvWbwWordsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:visibility="gone">

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/fblWbwWordCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="rtl"
            android:paddingVertical="8dp"
            app:alignContent="center"
            app:alignItems="center"
            app:flexDirection="row_reverse"
            app:flexWrap="wrap"
            app:justifyContent="center" />

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
