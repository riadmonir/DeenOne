<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_badge_pill"
        android:backgroundTint="@color/border_card" />

    <!-- Sheet Header -->
    <TextView
        android:id="@+id/tvOptionsSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="পোস্ট অপশন"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvOptionsSheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="আপনার প্রয়োজনীয় অপশনটি নির্বাচন করুন"
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:background="@color/border_card" />

    <!-- Option 1: Edit Post (Visible only for Author) -->
    <LinearLayout
        android:id="@+id/layoutOptionEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="12dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_progress_bg"
            android:backgroundTint="@color/bg_card_secondary">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_edit"
                app:tint="@color/accent_mint" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOptionEditText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="পোস্ট সম্পাদনা করুন"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOptionEditSubtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="শিরোনাম, বিবরণ বা বিষয়শ্রেণী পরিবর্তন করুন"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Option 2: Delete Post (Visible only for Author) -->
    <LinearLayout
        android:id="@+id/layoutOptionDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="12dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_progress_bg"
            android:backgroundTint="#26EF4444">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_trash_can"
                app:tint="#EF4444" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOptionDeleteText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="পোস্ট মুছে ফেলুন"
                android:textColor="#EF4444"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOptionDeleteSubtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="কমিউনিটি হাব থেকে এই পোস্টটি স্থায়ীভাবে মুছে যাবে"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Option 3: Report Post (Visible only for Non-Author) -->
    <LinearLayout
        android:id="@+id/layoutOptionReport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="12dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_progress_bg"
            android:backgroundTint="#26F59E0B">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_report_flag"
                app:tint="#F59E0B" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOptionReportText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="রিপোর্ট করুন"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOptionReportSubtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আপত্তিকর, বিভ্রান্তিকর বা অনৈসলামিক বক্তব্য রিপোর্ট করুন"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Option 4: Share Post (Universal) -->
    <LinearLayout
        android:id="@+id/layoutOptionShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="12dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_progress_bg"
            android:backgroundTint="@color/bg_card_secondary">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_share"
                app:tint="@color/accent_teal" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOptionShareText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="পোস্ট শেয়ার করুন"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOptionShareSubtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="উম্মাহর বন্ধুদের সাথে এই পোস্টটি ছড়িয়ে দিন"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
