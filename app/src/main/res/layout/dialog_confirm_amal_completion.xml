<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp"
    app:strokeColor="@color/border_card"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Big Green Circular Checkmark -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/circle_progress_bg"
            android:backgroundTint="@color/bg_card_active">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/accent_mint" />
        </FrameLayout>

        <!-- Title: আপনি কি নিশ্চিত? -->
        <TextView
            android:id="@+id/tvConfirmTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="আপনি কি নিশ্চিত?"
            android:textColor="@color/accent_mint"
            android:textSize="21sp"
            android:textStyle="bold" />

        <!-- Warning / Confirmation Description -->
        <TextView
            android:id="@+id/tvConfirmDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="আপনি কি সত্যিই এই নেক আমলটি সম্পন্ন করেছেন? মিথ্যা তথ্য প্রদান করলে পয়েন্ট কর্তন করা হতে পারে।"
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp" />

        <!-- Primary Action: হ্যাঁ, করেছি -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmYes"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="@color/accent_mint"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="হ্যাঁ, করেছি"
            android:textColor="@color/bg_main"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="24dp" />

        <!-- Secondary Action: এখনো না -->
        <TextView
            android:id="@+id/btnConfirmNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="এখনো না"
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
