<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_top_bar"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- Back Button with Circular Container -->
        <FrameLayout android:id="@+id/btnBackWhyFiveTimesHistory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circular_counter"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/accent_mint" />
        </FrameLayout>

        <!-- Header Title -->
        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="নামাজের জন্য পাঁচটি সময় কেন নির্ধারিত"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Settings Gear Action Button with Circular Container -->
        <FrameLayout android:id="@+id/btnSettingsWhyFiveTimesHistory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circular_counter"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                app:tint="@color/accent_mint" />
        </FrameLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollHistoryContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CARD 1: যে কারণে পাঁচ ওয়াক্ত নামাজ পাঁচটি সময়ে ভাগ করা -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWhyFiveTimesReasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Card Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvCard1Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="যে কারণে পাঁচ ওয়াক্ত নামাজ পাঁচটি সময়ে ভাগ করা"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <!-- Three dots button -->
                        <FrameLayout
                            android:id="@+id/btnMenuCardWhyFiveTimes"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_glassy_icon_button"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_more_horiz"
                                app:tint="@color/text_primary" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Intro Paragraph -->
                    <TextView
                        android:id="@+id/tvReasonsIntro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"
                        android:text="পাঁচ ওয়াক্ত নামাজের পাঁচটি সময় নির্ধারিত করার পেছনে আল্লাহ তাআলার গভীর প্রজ্ঞা এবং উদ্দেশ্য রয়েছে। প্রতিটি সময় নির্দিষ্ট কারণে এবং জীবনের বিভিন্ন প্রেক্ষাপটে আল্লাহ তাআলা নামাজের সময় নির্ধারণ করেছেন। এখানে পাঁচ ওয়াক্ত নামাজের সময়ের কারণ এবং তাৎপর্য আলোচনা করা হলো:"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <!-- 1. ফজর -->
                    <TextView
                        android:id="@+id/tvSubheadingFajr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="১. ফজর -"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFajrTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="সময়: ভোরের সূর্যোদয়ের আগে।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSubheadingFajrReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="কারণ:"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFajrReason1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="3.5dp"
                        android:text="• নতুন দিনের শুরুতে আল্লাহর স্মরণ এবং তার সাহায্য প্রার্থনা করা।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvFajrReason2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="3.5dp"
                        android:text="• একজন মুসলিমের দিন শুরু হয় আল্লাহর ইবাদত দিয়ে, যা তাকে সারা দিন সতর্ক এবং ন্যায়নিষ্ঠ রাখে।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <!-- 2. যোহর -->
                    <TextView
                        android:id="@+id/tvSubheadingDhuhr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="২. যোহর -"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDhuhrTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="সময়: মধ্যাহ্নে, যখন সূর্য আকাশের মধ্যস্থলে।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSubheadingDhuhrReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="কারণ:"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDhuhrReason1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="3.5dp"
                        android:text="• দিনের ব্যস্ততার মধ্যে আল্লাহর স্মরণ করিয়ে দেয়।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvDhuhrReason2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="3.5dp"
                        android:text="• একজন মুসলিমকে তার কর্মজীবনে আল্লাহর প্রতি আনুগত্য এবং দায়িত্বশীলতা মনে করিয়ে দেয়।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <!-- 3. আসর -->
                    <TextView
                        android:id="@+id/tvSubheadingAsr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="৩. আসর -"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAsrTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="সময়: দুপুরের পর থেকে সূর্য অস্ত যাওয়ার কিছুক্ষণ আগে।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSubheadingAsrReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="কারণ:"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAsrReason1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="3.5dp"
                        android:text="• দিনের শেষভাগে আল্লাহর স্মরণ, যা তাকে সারা দিনের কাজের পর বিশ্রাম ও ধৈর্যের প্রয়োজনীয়তা স্মরণ করিয়ে দেয়।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvAsrReason2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="3.5dp"
                        android:text="• একজন মুসলিমের ঈমান এবং কর্মচাঞ্চল্য বজায় রাখে।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <!-- 4. মাগরিব -->
                    <TextView
                        android:id="@+id/tvSubheadingMaghrib"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="৪. মাগরিব -"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMaghribTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="সময়: সূর্যাস্তের পর।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSubheadingMaghribReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="কারণ:"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMaghribReason1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="3.5dp"
                        android:text="• সন্ধ্যায় দিনের শেষ সময়ে আল্লাহর কাছে কৃতজ্ঞতা প্রকাশ।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvMaghribReason2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="3.5dp"
                        android:text="• পরিবারের সাথে সময় কাটানোর আগে এবং রাতের বিশ্রামের আগে আল্লাহর স্মরণ।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <!-- 5. ইশা -->
                    <TextView
                        android:id="@+id/tvSubheadingIsha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="৫. ইশা -"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvIshaTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="সময়: রাতের অন্ধকার নেমে আসার পর।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSubheadingIshaReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="কারণ:"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvIshaReason1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="3.5dp"
                        android:text="• রাতের বিশ্রামের আগে আল্লাহর স্মরণ এবং তার সাহায্য প্রার্থনা।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvIshaReason2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="3.5dp"
                        android:text="• একজন মুসলিমকে রাতে পাপাচারে লিপ্ত না হওয়া এবং সঠিক পথে চলার নির্দেশনা দেয়।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSubheadingWisdom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• ইসলামের প্রজ্ঞা"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvIslamWisdomDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="4dp"
                        android:text="• আল্লাহ তাআলা মানুষের দৈনন্দিন জীবনের প্রেক্ষাপটে নামাজের পাঁচটি সময় নির্ধারণ করেছেন। এই সময়গুলি মানুষের জীবনের বিভিন্ন মুহূর্তে আল্লাহর স্মরণ, আত্মশুদ্ধি এবং ধৈর্যের শিক্ষা দেয়। প্রতিটি নামাজ মুসলিমদের জীবনকে শৃঙ্খলাবদ্ধ, সৎ ও পূতপবিত্র রাখতে সহায়তা করে।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 2: কোরআন ও হাদিসের নির্দেশনা - -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGuidance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Card Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvCard2Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="কোরআন ও হাদিসের নির্দেশনা"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <!-- Three dots button -->
                        <FrameLayout
                            android:id="@+id/btnMenuCardGuidance"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_glassy_icon_button"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_more_horiz"
                                app:tint="@color/text_primary" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Intro -->
                    <TextView
                        android:id="@+id/tvGuidanceIntro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"
                        android:text="কোরআন ও হাদিসে পাঁচ ওয়াক্ত নামাজের বিভিন্ন সময়ের কথা উল্লেখ করা হয়েছে।"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <!-- Quote 1: সূরা হুদ -->
                    <TextView
                        android:id="@+id/tvGuidanceQuote1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="3.5dp"
                        android:text="&quot;আর আপনি দিনের দুই প্রান্তে এবং রাতের প্রথম ভাগে নামাজ কায়েম করুন।&quot;"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvGuidanceRef1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="সূরা হুদ: ১১:১১৪"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Quote 2: সূরা আল-ইসরা -->
                    <TextView
                        android:id="@+id/tvGuidanceQuote2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="3.5dp"
                        android:text="&quot;সূর্য ঢলে পড়া থেকে রাতের অন্ধকার পর্যন্ত নামাজ কায়েম করুন এবং ফজরের কুরআন।&quot;"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvGuidanceRef2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
