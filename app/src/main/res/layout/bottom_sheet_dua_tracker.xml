<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/bg_main">

  <!-- Top App Bar -->
  <LinearLayout
    android:id="@+id/layoutTrackerHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_top_bar"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <View
      android:layout_width="40dp"
      android:layout_height="4dp"
      android:layout_gravity="center_horizontal"
      android:layout_marginBottom="12dp"
      android:background="@drawable/bg_badge_pill" />

    <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

      <FrameLayout
        android:id="@+id/btnCloseDuaTracker"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_circular_counter"
        android:backgroundTint="@color/bg_badge_pill"
        android:clickable="true"
        android:focusable="true">

        <ImageView
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_gravity="center"
          android:src="@drawable/ic_arrow_back"
          app:tint="@color/text_primary" />
      </FrameLayout>

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
          android:id="@+id/tvDuaTrackerTitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="দোয়া ট্র্যাকার"
          android:textColor="@color/text_primary"
          android:textSize="16sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/tvDuaTrackerSubtitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:text="ব্যক্তিগত দোয়া পাঠ ও ইবাদতের হিসাব"
          android:textColor="@color/text_secondary"
          android:textSize="11sp" />
      </LinearLayout>
    </RelativeLayout>
  </LinearLayout>

  <!-- Scrollable Content -->
  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:overScrollMode="never"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="30dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/layoutTrackerHeader">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <!-- Card 1: Today's Progress & Daily Goal -->
      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

          <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
              android:id="@+id/tvTodayDuaProgressTitle"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentStart="true"
              android:text="আজকের দোয়া অগ্রগতি"
              android:textColor="@color/text_primary"
              android:textSize="14.5sp"
              android:textStyle="bold" />

            <TextView
              android:id="@+id/tvTodayDuaFraction"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentEnd="true"
              android:text="০ / ৭ টি সম্পন্ন"
              android:textColor="@color/accent_mint"
              android:textSize="13.5sp"
              android:textStyle="bold" />
          </RelativeLayout>

          <!-- Progress Bar -->
          <ProgressBar
            android:id="@+id/progressDuaToday"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_custom_horizontal" />

          <!-- Daily Goal Selector -->
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
              android:id="@+id/tvDailyGoalLabel"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="দৈনিক লক্ষ্য:"
              android:textColor="@color/text_secondary"
              android:textSize="12sp" />

            <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="10dp"
              android:layout_weight="1"
              android:gravity="end"
              android:orientation="horizontal">

              <TextView
                android:id="@+id/btnGoal3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="৩টি"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

              <TextView
                android:id="@+id/btnGoal5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="৫টি"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

              <TextView
                android:id="@+id/btnGoal7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_active"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="৭টি"
                android:textColor="@color/accent_mint"
                android:textSize="11.5sp"
                android:textStyle="bold" />

              <TextView
                android:id="@+id/btnGoal10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="১০টি"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
            </LinearLayout>
          </LinearLayout>

        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Card 2: Most Read & Total Stats Grid -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <!-- Most Read Dua -->
        <com.google.android.material.card.MaterialCardView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginEnd="6dp"
          android:layout_weight="1"
          app:cardBackgroundColor="@color/bg_card"
          app:cardCornerRadius="16dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/border_card"
          app:strokeWidth="1dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
              android:id="@+id/tvMostReadLabel"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="সর্বাধিক পঠিত দোয়া"
              android:textColor="@color/text_secondary"
              android:textSize="11sp" />

            <TextView
              android:id="@+id/tvMostReadTitle"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:ellipsize="end"
              android:maxLines="1"
              android:text="সাইয়্যিদুল ইস্তিগফার"
              android:textColor="@color/accent_mint"
              android:textSize="13sp"
              android:textStyle="bold" />

            <TextView
              android:id="@+id/tvMostReadCount"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="2dp"
              android:text="পাঠ সংখ্যা: ০ বার"
              android:textColor="@color/text_secondary"
              android:textSize="11sp" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Total Duas Read -->
        <com.google.android.material.card.MaterialCardView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:layout_weight="1"
          app:cardBackgroundColor="@color/bg_card"
          app:cardCornerRadius="16dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/border_card"
          app:strokeWidth="1dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
              android:id="@+id/tvTotalReadLabel"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="সর্বমোট পঠিত দোয়া"
              android:textColor="@color/text_secondary"
              android:textSize="11sp" />

            <TextView
              android:id="@+id/tvTotalReadCount"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:text="০ টি"
              android:textColor="@color/accent_mint"
              android:textSize="16sp"
              android:textStyle="bold" />

            <TextView
              android:id="@+id/tvPersonalRecordLabel"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="2dp"
              android:text="ব্যক্তিগত রেকর্ড"
              android:textColor="@color/text_secondary"
              android:textSize="11sp" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
      </LinearLayout>

      <!-- Card 3: Category-wise Usage Breakdown -->
      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

          <TextView
            android:id="@+id/tvCategoryUsageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ক্যাটাগরিভিত্তিক ব্যবহার"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

          <LinearLayout
            android:id="@+id/layoutCategoryUsageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
              android:id="@+id/tvNoUsagePlaceholder"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="কোনো দোয়া পাঠের রেকর্ড পাওয়া যায়নি। দোয়া পড়ার পর ' পড়া হয়েছে' ট্যাপ করুন।"
              android:textColor="@color/text_secondary"
              android:textSize="12sp" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Card 4: Recent History Timeline -->
      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

          <TextView
            android:id="@+id/tvDuaHistoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="সাম্প্রতিক দোয়া পাঠের ইতিহাস"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

          <LinearLayout
            android:id="@+id/layoutHistoryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
              android:id="@+id/tvNoHistoryPlaceholder"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="এখনো কোনো দোয়া পড়া হয়নি।"
              android:textColor="@color/text_secondary"
              android:textSize="12sp" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
