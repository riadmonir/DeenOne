<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/bg_main"
  android:orientation="vertical">

  <!-- Top Action Bar -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_top_bar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <ImageButton android:id="@+id/btnCloseMadhhabSheet"
      android:layout_width="38dp"
      android:layout_height="38dp"
      android:background="@drawable/bg_badge_pill"
      android:contentDescription="ফিরে যান"
      android:src="@drawable/ic_arrow_back"
      app:tint="@color/accent_mint" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="চার মাযহাবের ফিকহী তথ্য"
        android:textColor="@color/text_primary"
        android:textSize="17.5sp"
        android:textStyle="bold" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="হানাফী, মালিকী, শাফেয়ী ও হাম্বলী মাযহাবের দলীল"
        android:textColor="@color/text_secondary"
        android:textSize="11.5sp" />
    </LinearLayout>
  </LinearLayout>

  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="40dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <!-- Policy Notice -->
      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:padding="12dp">

          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="16sp" />

          <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:lineSpacingExtra="2dp"
            android:text="ফিকহী নীতি: চার প্রসিদ্ধ সুন্নী মাযহাবের ইমামগণের ইজতিহাদী মতপার্থক্য উম্মাহর জন্য রহমত ও বৈচিত্র্য। কোনো মাযহাবকে এককভাবে চূড়ান্ত দাবি করা হয় না।"
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Search Bar -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_badge_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:src="@drawable/ic_search"
          app:tint="@color/accent_mint" />

        <EditText
          android:id="@+id/etMadhhabSearch"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginStart="10dp"
          android:background="@null"
          android:hint="বিষয় লিখে খুঁজুন (যেমন: হাত বাঁধা, আমীন, ওজু)..."
          android:inputType="text"
          android:textColor="@color/text_primary"
          android:textColorHint="@color/text_secondary"
          android:textSize="13sp" />
      </LinearLayout>

      <!-- Issues Container -->
      <LinearLayout
        android:id="@+id/layoutMadhhabIssuesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</LinearLayout>