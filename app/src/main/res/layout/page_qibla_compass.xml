<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- 1. GLOBAL TOP APP BAR -->
    <RelativeLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_top_bar"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/btnCloseQibla"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circular_counter"
            android:backgroundTint="@color/bg_badge_pill"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/accent_mint" />
        </FrameLayout>

        <!-- Center: DeenOne Brand Logo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deen"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="One"
                android:textColor="@color/accent_mint"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- RIGHT: Theme Toggle & Standing Divider & Bell -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnQiblaThemeToggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circular_counter"
                android:backgroundTint="@color/bg_badge_pill"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivQiblaThemeIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_moon"
                    app:tint="@color/accent_mint" />
            </FrameLayout>

            <!-- Standing Vertical Divider Bar -->
            <View
                android:layout_width="1.5dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="6dp"
                android:background="@color/border_card" />

            <FrameLayout
                android:id="@+id/btnQiblaNotification"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circular_counter"
                android:backgroundTint="@color/bg_badge_pill"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/accent_mint" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/bg_circular_counter"
                    android:backgroundTint="#EF4444" />
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Subheader Bar: Page Title Pill & GPS Status Pill -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_top_bar"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/pillQiblaTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="@color/bg_card_active"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="• কিবলা কম্পাস"
            android:textColor="@color/accent_mint"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnRefreshGpsLocation"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_badge_pill"
                android:contentDescription="জিপিএস রিফ্রেশ"
                android:src="@drawable/ic_target_bullseye"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnQiblaHelp"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_pill"
                android:contentDescription="নির্দেশনা"
                android:src="@drawable/ic_info"
                app:tint="@color/text_primary" />
        </LinearLayout>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- 2. CARD 1: LOCATION, QIBLA ANGLE & MECCA DISTANCE (Exact Match to Screenshot) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="16dp">

                    <!-- Left Column: Location & Qibla Angle -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_location_pin"
                                app:tint="@color/accent_mint" />

                            <TextView
                                android:id="@+id/tvQiblaLocationName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="মদিনা মুনাওয়ারা, সৌদি আরব"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvQiblaAngleLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="কিবলার কোণ: 156.4°"
                            android:textColor="@color/accent_mint"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="@color/border_card" />

                    <!-- Right Column: Mecca Distance -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMeccaDistanceLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="মক্কার দূরত্ব"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvMeccaDistanceValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="842 কি.মি."
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. CARD 2: DYNAMIC ROTATION INSTRUCTION PILL (Exact Match to Screenshot) -->
            <LinearLayout
                android:id="@+id/layoutTurnInstructionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/bg_card"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/tvTurnInstruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="↻ আর 15° ডানে ঘুরুন"
                    android:textColor="@color/accent_gold"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 4. CENTER COMPASS DIAL VIEW (Dynamic Canvas Rendering) -->
            <FrameLayout
                android:layout_width="310dp"
                android:layout_height="310dp"
                android:layout_gravity="center"
                android:layout_marginVertical="16dp">

                <com.devflux.deenone.features.qibla.view.QiblaCompassView
                    android:id="@+id/viewQiblaCompass"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- 5. CARD 3: SENSOR STATUS & CALIBRATION (Exact Match to Screenshot) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSensorStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="16dp">

                    <!-- Top Row: Sensor Status & Calibrate Button -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/btnCalibrateSensor"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvSensorIcon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="((•))"
                                android:textColor="@color/accent_mint"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSensorStatusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="ম্যাগনেটোমিটার সেন্সর সংযুক্ত ও সক্রিয়"
                                android:textColor="@color/text_primary"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnCalibrateSensor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="6dp"
                            android:text="ক্যালিব্রেট"
                            android:textColor="@color/accent_mint"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Subtitle -->
                    <TextView
                        android:id="@+id/tvSensorGuidanceSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="3dp"
                        android:text="সঠিক দিক নির্দেশনার জন্য মোবাইল ফোনটি সমতল স্থানে বা মাটির সমান্তরালে রাখুন।"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
