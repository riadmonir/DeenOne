<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAyahItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_card"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Ayah Number Badge & Quick Action Buttons -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/tvAyahNumberBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="আয়াত ১"
                    android:textColor="@color/accent_mint"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Actions: Play Audio, Bookmark, Favorite, Copy, Share -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnPlayAyahAudio"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_pill"
                    android:padding="6dp"
                    android:src="@drawable/ic_audio_play"
                    app:tint="@color/accent_mint" />

                <ImageView
                    android:id="@+id/btnAyahWordByWord"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_pill"
                    android:padding="5.5dp"
                    android:src="@drawable/ic_translate"
                    app:tint="@color/accent_mint" />

                <ImageView
                    android:id="@+id/btnBookmarkAyah"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_pill"
                    android:padding="6dp"
                    android:src="@drawable/ic_bookmark"
                    app:tint="@color/text_muted" />

                <ImageView
                    android:id="@+id/btnCopyAyahItem"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_pill"
                    android:padding="6dp"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/text_muted" />

                <ImageView android:id="@+id/btnShareAyahItem"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_badge_pill"
                    android:padding="6dp"
                    android:src="@drawable/ic_share"
                    app:tint="@color/accent_mint" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Arabic Uthmani / Tashkeel Text with RTL support and Quranic typography -->
        <TextView
            android:id="@+id/tvAyahArabicText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="end"
            android:lineSpacingExtra="10dp"
            android:text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"
            android:textAlignment="viewEnd"
            android:textColor="@color/text_primary"
            android:textDirection="rtl"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Bengali Pronunciation / Transliteration -->
        <TextView
            android:id="@+id/tvAyahPronunciation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="উচ্চারণ: বিসমিল্লাহির রাহমানির রাহিম"
            android:textColor="@color/accent_mint"
            android:textSize="13sp" />

        <!-- Tafsir / Translation Toggle Button (Rule 7 compliant with touch animation) -->
        <LinearLayout
            android:id="@+id/btnToggleTafsir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <ImageView
                android:id="@+id/ivTafsirInfoIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_info"
                app:tint="@color/accent_gold" />

            <TextView
                android:id="@+id/tvToggleTafsirText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="সংক্ষিপ্ত তাফসির দেখুন"
                android:textColor="@color/accent_gold"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Expandable Tafsir / Translation Rounded Card Container (Matching User Screenshot 2) -->
        <LinearLayout
            android:id="@+id/layoutTafsirBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_tafsir_box"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <!-- Bengali Translation / Tafsir -->
            <TextView
                android:id="@+id/tvAyahBengaliTranslation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:text="অর্থ: শুরু করছি আল্লাহর নামে যিনি পরম করুণাময়, অতি দয়ালু।"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <!-- English Translation / Tafsir -->
            <TextView
                android:id="@+id/tvAyahEnglishTranslation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="English: In the name of Allah, the Entirely Merciful, the Especially Merciful."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
