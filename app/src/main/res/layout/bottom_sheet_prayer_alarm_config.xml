<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/layoutWaqtConfigHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_top_bar"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_badge_pill" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/btnBackWaqtConfig"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_badge_pill"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvConfiguringWaqtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Fazr"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Prayer Alarm Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPrayerAlarmMaster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="@color/bg_badge_pill">

                        <ImageView
                            android:id="@+id/ivWaqtBadgeIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_sunrise_vector"
                            app:tint="@color/accent_mint" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPrayerAlarmTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="নামাজের অ্যালার্ম"
                            android:textColor="@color/text_primary"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPrayerAlarmSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="অ্যালার্ম সক্রিয়"
                            android:textColor="@color/accent_mint"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchWaqtAlarmEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. Time Adjustment Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardTimeAdjustment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tvTimeAdjustmentTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="সময় সমন্বয়"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAdjustedTimeBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="@color/bg_badge_pill"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:text="🔔 04:47"
                            android:textColor="@color/accent_mint"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <!-- Slider / SeekBar -->
                    <SeekBar
                        android:id="@+id/seekBarTimeAdjustment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="60"
                        android:progress="30"
                        android:progressBackgroundTint="#2D3748"
                        android:progressTint="@color/accent_mint"
                        android:thumbTint="@color/accent_mint" />

                    <!-- Labels under SeekBar -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingHorizontal="6dp">

                        <TextView
                            android:id="@+id/tvSliderMinusLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="-৩০ মি."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvSliderCenterLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:text="সঠিক সময়ে"
                            android:textColor="@color/accent_mint"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSliderPlusLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="+৩০ মি."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. Alarm Sound & Azan Sound Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAlarmSoundList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvAlarmSoundTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:text="অ্যালার্মের সুর"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Option 1: Silent -->
                    <LinearLayout
                        android:id="@+id/rowSoundSilent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="@color/bg_badge_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:id="@+id/ivRadioSilent"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_radio_circle_checked" />

                        <TextView
                            android:id="@+id/tvTitleSilent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="নিঃশব্দ"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Option 2: Default Azan (Fajr / Standard) -->
                    <LinearLayout
                        android:id="@+id/rowSoundAzanDefault"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="#00000000"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:id="@+id/ivRadioAzanDefault"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_radio_circle_empty" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvTitleAzanDefault"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ডিফল্ট আযান"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSubtitleAzanDefault"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ওয়াক্তের নির্ধারিত আযান"
                                android:textColor="@color/accent_mint"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/btnPlayAzanDefault"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="@color/bg_badge_pill"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/ivPlayIconAzanDefault"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_play_arrow"
                                app:tint="@color/accent_mint" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Option 3: Azan (Common) -->
                    <LinearLayout
                        android:id="@+id/rowSoundAzanCommon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="#00000000"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:id="@+id/ivRadioAzanCommon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_radio_circle_empty" />

                        <TextView
                            android:id="@+id/tvTitleAzanCommon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="সাধারণ আযান"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/btnPlayAzanCommon"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="@color/bg_badge_pill"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/ivPlayIconAzanCommon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_play_arrow"
                                app:tint="@color/accent_mint" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Option 4: Azan (Standard) -->
                    <LinearLayout
                        android:id="@+id/rowSoundAzanStandard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="#00000000"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:id="@+id/ivRadioAzanStandard"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_radio_circle_empty" />

                        <TextView
                            android:id="@+id/tvTitleAzanStandard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="স্ট্যান্ডার্ড আযান"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/btnPlayAzanStandard"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="@color/bg_badge_pill"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/ivPlayIconAzanStandard"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_play_arrow"
                                app:tint="@color/accent_mint" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Option 5: Beep -->
                    <LinearLayout
                        android:id="@+id/rowSoundBeep"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="#00000000"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:id="@+id/ivRadioBeep"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_radio_circle_empty" />

                        <TextView
                            android:id="@+id/tvTitleBeep"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="মৃদু বীপ"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/btnPlayBeep"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="@color/bg_badge_pill"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/ivPlayIconBeep"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_play_arrow"
                                app:tint="@color/accent_mint" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Option 6: Ring -->
                    <LinearLayout
                        android:id="@+id/rowSoundRing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="#00000000"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:id="@+id/ivRadioRing"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_radio_circle_empty" />

                        <TextView
                            android:id="@+id/tvTitleRing"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="রিংটোন"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/btnPlayRing"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="@color/bg_badge_pill"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/ivPlayIconRing"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_play_arrow"
                                app:tint="@color/accent_mint" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Option 7: Notification -->
                    <LinearLayout
                        android:id="@+id/rowSoundNotification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="#00000000"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:id="@+id/ivRadioNotification"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_radio_circle_empty" />

                        <TextView
                            android:id="@+id/tvTitleNotification"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="নোটিফিকেশন সুর"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/btnPlayNotification"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_badge_pill"
                            android:backgroundTint="@color/bg_badge_pill"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/ivPlayIconNotification"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_play_arrow"
                                app:tint="@color/accent_mint" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 4. Vibration Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVibration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="@color/bg_badge_pill">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_vibration"
                            app:tint="@color/accent_mint" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvVibrationTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ভাইব্রেশন"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvVibrationSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="অ্যালার্ম বাজার সময় ভাইব্রেট করবে"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchVibration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sticky Save Button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_top_bar"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/btnSavePrayerAlarmConfig"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_btn_mint_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="সংরক্ষণ করুন"
            android:textColor="@color/btn_save_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

</LinearLayout>
