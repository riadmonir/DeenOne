<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardChapterItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_card"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="14dp">

        <!-- Number Badge (Light blue circular badge) -->
        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circular_counter"
            android:backgroundTint="#DDF3EF">

            <TextView
                android:id="@+id/tvChapterNumberBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="১"
                android:textColor="#0D5C55"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Chapter / Question Title -->
        <TextView
            android:id="@+id/tvChapterItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:lineSpacingExtra="2dp"
            android:text="(১) বান্দার উপর সর্বপ্রথম ওয়াজিব কোনটি?"
            android:textColor="@color/text_primary"
            android:textSize="14.5sp" />

        <!-- Book Icon on Right -->
        <ImageView
            android:id="@+id/ivChapterItemIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_menu_book"
            app:tint="@color/text_secondary" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
