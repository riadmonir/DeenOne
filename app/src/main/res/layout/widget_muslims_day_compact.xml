<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_glass_dark"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: App Icon + Hijri/Gregorian Date + Refresh -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivWidgetLogo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_deenone_logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/ivWidgetLogo"
            android:layout_toStartOf="@id/btnWidgetRefresh"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWidgetHijriDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="১৫ রমাদান ১৪৪৬"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetGregorianDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Sat, 28 Mar 2026"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnWidgetRefresh"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_badge_pill"
            android:padding="3dp"
            android:src="@drawable/ic_refresh" />
    </RelativeLayout>

    <!-- Waqt Name in Glowing Amber -->
    <TextView
        android:id="@+id/tvWidgetCurrentWaqt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="আসর"
        android:textColor="#F59E0B"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Big Current Waqt Time -->
    <TextView
        android:id="@+id/tvWidgetCurrentWaqtTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="০৩:৪৫ PM"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Next Prayer Countdown -->
    <TextView
        android:id="@+id/tvWidgetNextPrayerCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="পরবর্তী ওয়াক্ত ১ ঘণ্টা ২৩ মিনিটে"
        android:textColor="#94A3B8"
        android:textSize="11sp" />
</LinearLayout>
