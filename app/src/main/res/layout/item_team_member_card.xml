<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTeamMember"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_card"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="18dp">

        <!-- Circular Avatar Container -->
        <FrameLayout
            android:layout_width="74dp"
            android:layout_height="74dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivMemberAvatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_deenone_logo"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.DeenOne.Circle"
                app:strokeColor="@color/accent_mint"
                app:strokeWidth="2dp" />
        </FrameLayout>

        <!-- Role Badge/Tag -->
        <TextView
            android:id="@+id/tvMemberRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="প্রতিষ্ঠাতা ও প্রধান ডেভেলপার"
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <!-- Member Name -->
        <TextView
            android:id="@+id/tvMemberName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="রিয়াদ মনির"
            android:textColor="@color/accent_mint"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <!-- Social Action Buttons Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- LinkedIn -->
            <FrameLayout
                android:id="@+id/btnMemberLinkedIn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_badge_pill"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_linkedin"
                    app:tint="@color/accent_mint" />
            </FrameLayout>

            <!-- GitHub -->
            <FrameLayout
                android:id="@+id/btnMemberGitHub"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_badge_pill"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_github"
                    app:tint="@color/accent_mint" />
            </FrameLayout>

            <!-- Website / Portfolio -->
            <FrameLayout
                android:id="@+id/btnMemberWebsite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_badge_pill"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_globe"
                    app:tint="@color/accent_mint" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
