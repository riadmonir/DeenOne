<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardHifzIndexItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_card"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Number Circle Badge -->
        <FrameLayout
            android:id="@+id/layoutIndexNumberBadge"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circular_counter"
            android:backgroundTint="@color/bg_badge_pill">

            <TextView
                android:id="@+id/tvIndexNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="১৫"
                android:textColor="@color/accent_mint"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Center Text -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/layoutIndexNumberBadge"
            android:layout_toStartOf="@id/layoutIndexRight"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvIndexTitleBn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="পারা ১৫: সুবহানাল্লাজি"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIndexSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="পৃষ্ঠা ২৯৩ - ৩১২ • আল-ইসরা ১৭:১ - আল-কাহফ ১৮:৭৪"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Right Side Arabic & Action -->
        <LinearLayout
            android:id="@+id/layoutIndexRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvIndexArabicName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="سُبْحَانَ الَّذِي"
                android:textColor="@color/accent_gold"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIndexPageRangeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="পৃষ্ঠা ২৯৩"
                android:textColor="@color/accent_mint"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
