<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_margin="5dp"
  app:cardBackgroundColor="@color/bg_card"
  app:cardCornerRadius="16dp"
  app:cardElevation="2dp"
  app:strokeColor="@color/border_subtle"
  app:strokeWidth="1dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="90dp"
      android:background="@drawable/bg_card_secondary"
      android:padding="4dp">

      <ImageView
        android:id="@+id/ivGridBookIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_feat_book"
        app:tint="@color/accent_mint"
        android:contentDescription="বইয়ের আইকন" />

      <TextView
        android:id="@+id/tvGridBookLangBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_badge_pill"
        android:paddingHorizontal="5dp"
        android:paddingVertical="2dp"
        android:text="বাংলা"
        android:textColor="@color/accent_mint"
        android:textSize="9sp"
        android:textStyle="bold" />

      <ImageView
        android:id="@+id/ivGridBookFavoriteBtn"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_badge_pill"
        android:padding="5dp"
        android:src="@drawable/ic_favorite_border"
        app:tint="@color/text_secondary"
        android:contentDescription="বুকমার্ক" />
    </FrameLayout>

    <TextView
      android:id="@+id/tvGridBookCategoryBadge"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:background="@drawable/bg_badge_pill"
      android:paddingHorizontal="6dp"
      android:paddingVertical="2dp"
      android:text="তাফসীর"
      android:textColor="@color/accent_mint"
      android:textSize="9.5sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/tvGridBookTitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:ellipsize="end"
      android:maxLines="2"
      android:minLines="2"
      android:text="বইয়ের শিরোনাম"
      android:textColor="@color/text_primary"
      android:textSize="13sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/tvGridBookAuthor"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="লেখক"
      android:textColor="@color/text_secondary"
      android:textSize="11sp" />

    <TextView
      android:id="@+id/tvGridBookPagesAndSize"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="৮২০ পৃষ্ঠা • ১৮.৪ MB"
      android:textColor="@color/text_secondary"
      android:textSize="10sp" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btnGridBookAction"
      android:layout_width="match_parent"
      android:layout_height="36dp"
      android:layout_marginTop="8dp"
      android:backgroundTint="@color/accent_mint"
      android:insetTop="0dp"
      android:insetBottom="0dp"
      android:padding="0dp"
      android:text="পড়ুন"
      android:textColor="@color/bg_main"
      android:textSize="11.5sp"
      android:textStyle="bold"
      app:cornerRadius="8dp" />

  </LinearLayout>

</com.google.android.material.card.MaterialCardView>
