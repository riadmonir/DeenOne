<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardNaflContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardMaxElevation="0dp"
    app:strokeColor="@color/border_card"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Left Colored Icon Container -->
        <FrameLayout
            android:id="@+id/flNaflIconBox"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/ivNaflIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nafl_tahajjud" />
        </FrameLayout>

        <!-- Middle: Title and Time Range -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toStartOf="@+id/btnTrackNafl"
            android:layout_toEndOf="@+id/flNaflIconBox"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNaflTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="তাহাজ্জুদ"
                android:textColor="@color/text_primary"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNaflTimeRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="11:54 PM - 04:26 AM"
                android:textColor="@color/accent_mint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Right: Track Button (Uniform 104dp x 36dp, 0dp elevation, zero blurry shadow) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrackNafl"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="104dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp"
            android:gravity="center"
            android:textAlignment="center"
            android:text="ট্র্যাক"
            android:textColor="@color/accent_mint"
            android:textSize="12sp"
            android:textStyle="bold"
            android:elevation="0dp"
            app:elevation="0dp"
            android:stateListAnimator="@null"
            app:cornerRadius="18dp"
            app:strokeColor="@color/border_card"
            app:strokeWidth="1dp" />

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
