<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnCloseWidgetSheet"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_badge_pill"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHomeScreenWidgetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="হোম স্ক্রিন উইজেট"
                android:textColor="@color/text_primary"
                android:textSize="17.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHomeScreenWidgetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="ফোনের হোমস্ক্রিনের জন্য প্রিমিয়াম ইসলামিক উইজেট"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Widgets List RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHomeScreenWidgets"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="36dp" />
</LinearLayout>
