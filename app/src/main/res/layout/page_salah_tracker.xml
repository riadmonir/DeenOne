        <ImageView
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:layout_gravity="center"
          android:src="@drawable/ic_nav_salat"
          app:tint="@color/text_mint_bright" />
      </FrameLayout>

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/nav_salat"
        android:textColor="@color/text_mint_bright"
        android:textSize="11sp"
        android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. Amal Tab -->
    <LinearLayout
      android:id="@+id/tabAmal"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/bg_nav_tab_ripple"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center"
      android:orientation="vertical">

      <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_nav_amal"
        app:tint="@color/text_secondary" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/nav_amal"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />
    </LinearLayout>

    <!-- 4. Rank Tab -->
    <LinearLayout
      android:id="@+id/tabRank"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/bg_nav_tab_ripple"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center"
      android:orientation="vertical">

      <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_nav_rank"
        app:tint="@color/text_secondary" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/nav_rank"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />
    </LinearLayout>

    <!-- 5. Community Tab -->
    <LinearLayout
      android:id="@+id/tabCommunity"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/bg_nav_tab_ripple"
