<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:padding="20dp">

    <!-- Top Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_badge_pill"
        android:alpha="0.4" />

    <!-- Header with Icon & Category Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivDetailIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_deenone_logo"
            android:background="@drawable/bg_badge_pill"
            android:padding="9dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/tvDetailCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="দ্বীনি বার্তা ও ঘোষণা"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:background="@drawable/bg_badge_pill"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/tvDetailTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আজ • ১০:৩০ AM"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDetailClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="বন্ধ" />
    </LinearLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvDetailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="শিরোনাম"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginTop="16dp" />

    <!-- Message Body -->
    <TextView
        android:id="@+id/tvDetailBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="বিস্তারিত বার্তা..."
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginTop="10dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:alpha="0.2"
        android:background="?attr/colorOutline" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnDetailCopy"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="কপি করুন"
            android:textSize="13sp"
            android:layout_marginEnd="8dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <Button
            android:id="@+id/btnDetailAction"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.2"
            android:text="বিস্তারিত দেখুন"
            android:textSize="13sp"
            style="@style/Widget.MaterialComponents.Button" />
    </LinearLayout>

</LinearLayout>