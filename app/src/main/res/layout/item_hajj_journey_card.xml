<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Top Connecting Line (strictly centered on the 50% screen axis) -->
    <View
        android:id="@+id/lineConnectorTop"
        android:layout_width="2.2dp"
        android:layout_height="16dp"
        android:layout_gravity="center_horizontal"
        android:background="#B2DFDB" />

    <!-- Main Stage Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStageItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ========================================================= -->
            <!-- ODD STAGE (1, 3, 5, 7, 9, 11): IMAGE LEFT, TEXT RIGHT    -->
            <!-- Precise 50% Center Alignment via ConstraintLayout         -->
            <!-- ========================================================= -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutOddStage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="140dp"
                android:paddingHorizontal="14dp"
                android:paddingTop="0dp"
                android:paddingBottom="12dp">

                <!-- Center Guideline at exactly 50% -->
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidelineCenterOdd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5" />

                <!-- Vertical Line from Card Top to Star Rosette -->
                <View
                    android:id="@+id/lineVerticalTopOdd"
                    android:layout_width="2.2dp"
                    android:layout_height="0dp"
                    android:background="#EBCA28"
                    app:layout_constraintBottom_toTopOf="@id/badgeStarContainerOdd"
                    app:layout_constraintEnd_toEndOf="@id/guidelineCenterOdd"
                    app:layout_constraintStart_toStartOf="@id/guidelineCenterOdd"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Islamic Star Rosette Badge (30dp x 30dp) -->
                <FrameLayout
                    android:id="@+id/badgeStarContainerOdd"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="@id/guidelineCenterOdd"
                    app:layout_constraintStart_toStartOf="@id/guidelineCenterOdd"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/ivStarRosetteOdd"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Star Rosette"
                        android:src="@drawable/ic_hajj_star_rosette" />

                    <TextView
                        android:id="@+id/tvStageNumberOdd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="০১" />
                </FrameLayout>

                <!-- Vertical Line from Star Rosette to Bottom Curve -->
                <View
                    android:id="@+id/lineVerticalMiddleOdd"
                    android:layout_width="2.2dp"
                    android:layout_height="0dp"
                    android:layout_marginBottom="-1dp"
                    android:background="#EBCA28"
                    app:layout_constraintBottom_toTopOf="@id/ivHajjLineRight"
                    app:layout_constraintEnd_toEndOf="@id/guidelineCenterOdd"
                    app:layout_constraintStart_toStartOf="@id/guidelineCenterOdd"
                    app:layout_constraintTop_toBottomOf="@id/badgeStarContainerOdd" />

                <!-- Right-curving Line Asset (e.g. hajj_line_right1.png) -->
                <ImageView
                    android:id="@+id/ivHajjLineRight"
                    android:layout_width="24dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="-1dp"
                    android:layout_marginBottom="4dp"
                    android:contentDescription="Hajj Right Line"
                    android:scaleType="fitXY"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/guidelineCenterOdd"
                    tools:src="@drawable/hajj_line_right1" />

                <!-- Action Link: বিস্তারিত > (Vertically centered exactly with the icon) -->
                <LinearLayout
                    android:id="@+id/btnDetailsOdd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp"
                    android:paddingEnd="6dp"
                    app:layout_constraintBottom_toBottomOf="@id/ivHajjLineRight"
                    app:layout_constraintStart_toEndOf="@id/ivHajjLineRight"
                    app:layout_constraintTop_toTopOf="@id/ivHajjLineRight">

                    <TextView
                        android:id="@+id/tvBtnDetailsOdd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="বিস্তারিত"
                        android:textColor="@color/accent_teal"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="3dp"
                        android:contentDescription="Arrow"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/accent_teal" />
                </LinearLayout>

                <!-- Left Column: Stage Illustration (Centered in 0% to 50%) -->
                <ImageView
                    android:id="@+id/ivStageImageOdd"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="18dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Stage Illustration"
                    android:scaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guidelineCenterOdd"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@drawable/img_hajj_journey_stage_1" />

                <!-- Right Column: Title and Description (50% to 100%) -->
                <LinearLayout
                    android:id="@+id/layoutTextOdd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toTopOf="@id/btnDetailsOdd"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/guidelineCenterOdd"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0">

                    <TextView
                        android:id="@+id/tvStageTitleOdd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="ইহরাম" />

                    <TextView
                        android:id="@+id/tvStageDescOdd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingMultiplier="1.25"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp"
                        tools:text="হজের যাত্রা শুরু করুন একটি শুদ্ধ নিয়তের মাধ্যমে..." />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ========================================================= -->
            <!-- EVEN STAGE (2, 4, 6, 8, 10, 12): TEXT LEFT, IMAGE RIGHT   -->
            <!-- Precise 50% Center Alignment via ConstraintLayout         -->
            <!-- ========================================================= -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutEvenStage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="140dp"
                android:paddingHorizontal="14dp"
                android:paddingTop="0dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <!-- Center Guideline at exactly 50% -->
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidelineCenterEven"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5" />

                <!-- Vertical Line from Card Top to Star Rosette -->
                <View
                    android:id="@+id/lineVerticalTopEven"
                    android:layout_width="2.2dp"
                    android:layout_height="0dp"
                    android:background="#A3DE7C"
                    app:layout_constraintBottom_toTopOf="@id/badgeStarContainerEven"
                    app:layout_constraintEnd_toEndOf="@id/guidelineCenterEven"
                    app:layout_constraintStart_toStartOf="@id/guidelineCenterEven"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Islamic Star Rosette Badge (30dp x 30dp) -->
                <FrameLayout
                    android:id="@+id/badgeStarContainerEven"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="@id/guidelineCenterEven"
                    app:layout_constraintStart_toStartOf="@id/guidelineCenterEven"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/ivStarRosetteEven"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Star Rosette"
                        android:src="@drawable/ic_hajj_star_rosette" />

                    <TextView
                        android:id="@+id/tvStageNumberEven"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="০২" />
                </FrameLayout>

                <!-- Vertical Line from Star Rosette to Bottom Curve -->
                <View
                    android:id="@+id/lineVerticalMiddleEven"
                    android:layout_width="2.2dp"
                    android:layout_height="0dp"
                    android:layout_marginBottom="-1dp"
                    android:background="#A3DE7C"
                    app:layout_constraintBottom_toTopOf="@id/ivHajjLineLeft"
                    app:layout_constraintEnd_toEndOf="@id/guidelineCenterEven"
                    app:layout_constraintStart_toStartOf="@id/guidelineCenterEven"
                    app:layout_constraintTop_toBottomOf="@id/badgeStarContainerEven" />

                <!-- Left-curving Line Asset (e.g. hajj_line_left2.png) -->
                <ImageView
                    android:id="@+id/ivHajjLineLeft"
                    android:layout_width="24dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="-1.8dp"
                    android:layout_marginBottom="4dp"
                    android:contentDescription="Hajj Left Line"
                    android:scaleType="fitXY"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/guidelineCenterEven"
                    tools:src="@drawable/hajj_line_left2" />

                <!-- Action Link: বিস্তারিত > (Vertically centered exactly with the icon) -->
                <LinearLayout
                    android:id="@+id/btnDetailsEven"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp"
                    android:paddingStart="6dp"
                    app:layout_constraintBottom_toBottomOf="@id/ivHajjLineLeft"
                    app:layout_constraintEnd_toStartOf="@id/ivHajjLineLeft"
                    app:layout_constraintTop_toTopOf="@id/ivHajjLineLeft">

                    <TextView
                        android:id="@+id/tvBtnDetailsEven"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="বিস্তারিত"
                        android:textColor="@color/accent_teal"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="3dp"
                        android:contentDescription="Arrow"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/accent_teal" />
                </LinearLayout>

                <!-- Left Column: Title and Description (0% to 50%) -->
                <LinearLayout
                    android:id="@+id/layoutTextEven"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toTopOf="@id/btnDetailsEven"
                    app:layout_constraintEnd_toStartOf="@id/guidelineCenterEven"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0">

                    <TextView
                        android:id="@+id/tvStageTitleEven"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="তাওয়াফুল কুদুম" />

                    <TextView
                        android:id="@+id/tvStageDescEven"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingMultiplier="1.25"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp"
                        tools:text="মক্কায় প্রবেশের পর, ৭ চক্কর দিয়ে তাওয়াফুল কুদুম সম্পন্ন করুন..." />
                </LinearLayout>

                <!-- Right Column: Stage Illustration (Centered in 50% to 100%) -->
                <ImageView
                    android:id="@+id/ivStageImageEven"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Stage Illustration"
                    android:scaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/guidelineCenterEven"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@drawable/img_hajj_journey_stage_2" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
