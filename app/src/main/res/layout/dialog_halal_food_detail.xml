<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/bg_main"
  android:orientation="vertical">

  <!-- Top Standard App Bar (Centered) -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_top_bar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <ImageButton android:id="@+id/btnCloseHalalDetail"
      android:layout_width="38dp"
      android:layout_height="38dp"
      android:background="@drawable/bg_badge_pill"
      android:backgroundTint="@color/bg_badge_pill"
      android:contentDescription="ফিরে যান"
      android:src="@drawable/ic_arrow_back"
      app:tint="@color/accent_mint" />

    <TextView
      android:id="@+id/tvDetailTopTitle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center"
      android:text="হালাল খাদ্য ও পুষ্টি বিবরণ"
      android:textColor="@color/text_primary"
      android:textSize="17.5sp"
      android:textStyle="bold" />

    <View
      android:layout_width="38dp"
      android:layout_height="38dp" />
  </LinearLayout>

  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="40dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <!-- Hero Image Card -->
      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1.2dp">

        <ImageView
          android:id="@+id/ivDetailFoodImage"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="খাদ্য ও উপাদানের ছবি"
          android:scaleType="centerCrop"
          android:src="@drawable/bg_card_secondary" />
      </com.google.android.material.card.MaterialCardView>

      <!-- Title & Status Card -->
      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="18dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1.2dp">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

          <TextView
            android:id="@+id/tvDetailStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="@color/bg_card_active"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="হালাল"
            android:textColor="@color/accent_mint"
            android:textSize="12.5sp"
            android:textStyle="bold" />

          <TextView
            android:id="@+id/tvDetailArabicName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="عَسَل"
            android:textColor="#34D399"
            android:textSize="17sp"
            android:textStyle="bold" />

          <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="খাঁটি মধু"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

          <TextView
            android:id="@+id/tvDetailScientificName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="বৈজ্ঞানিক নাম: Apis mellifera nectar"
            android:textColor="@color/accent_mint"
            android:textSize="13sp" />

          <TextView
            android:id="@+id/tvDetailSourceOrigin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="উৎস: প্রাকৃতিক মৌ নির্যাস"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Nutritional & Health Benefits -->
      <TextView
        android:id="@+id/tvDetailBenefitsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="পুষ্টিগুণ ও স্বাস্থ্য উপকারিতা:"
        android:textColor="@color/accent_mint"
        android:textSize="14sp"
        android:textStyle="bold" />

      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <TextView
          android:id="@+id/tvDetailBenefits"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:lineSpacingMultiplier="1.3"
          android:padding="16dp"
          android:text="রোগ প্রতিরোধ ক্ষমতা বাড়ায়, হজমে সহায়তা করে এবং পেটের পীড়া দূর করে।"
          android:textColor="@color/text_secondary"
          android:textSize="13.5sp" />
      </com.google.android.material.card.MaterialCardView>

      <!-- How to Consume / Sunnah Instructions -->
      <TextView
        android:id="@+id/tvDetailHowToConsumeHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="খাওয়ার সুন্নাহ নিয়ম ও নির্দেশনা:"
        android:textColor="@color/accent_mint"
        android:textSize="14sp"
        android:textStyle="bold" />

      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <TextView
          android:id="@+id/tvDetailHowToConsume"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:lineSpacingMultiplier="1.3"
          android:padding="16dp"
          android:text="সকালে খালি পেটে কুসুম গরম পানিতে ১-২ চা চামচ মিশিয়ে পান করা সুন্নাত।"
          android:textColor="@color/text_secondary"
          android:textSize="13.5sp" />
      </com.google.android.material.card.MaterialCardView>

      <!-- Detailed Explanation & Shariah Discussion -->
      <TextView
        android:id="@+id/tvDetailDescriptionHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="শারীয়াহ বিধান ও বিস্তারিত আলোচনা:"
        android:textColor="@color/accent_mint"
        android:textSize="14sp"
        android:textStyle="bold" />

      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <TextView
          android:id="@+id/tvDetailDescription"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:lineSpacingMultiplier="1.3"
          android:padding="16dp"
          android:text="বিস্তারিত ফিকহি আলোচনা এখানে প্রদর্শিত হবে।"
          android:textColor="@color/text_secondary"
          android:textSize="13.5sp" />
      </com.google.android.material.card.MaterialCardView>

      <!-- Halal Alternative Container -->
      <LinearLayout
        android:id="@+id/layoutDetailAlternative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
          android:id="@+id/tvDetailAlternativeHeader"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="8dp"
          android:text="💡 নিরাপদ ও স্বাস্থ্যকর বিকল্প হালাল উপাদান:"
          android:textColor="@color/accent_mint"
          android:textSize="14sp"
          android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="16dp"
          app:cardBackgroundColor="@color/bg_card"
          app:cardCornerRadius="16dp"
          app:strokeColor="#10B981"
          app:strokeWidth="1.2dp">

          <TextView
            android:id="@+id/tvDetailAlternative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.3"
            android:padding="16dp"
            android:text="বিকল্প হালাল উপাদান।"
            android:textColor="#34D399"
            android:textSize="13.5sp"
            android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>
      </LinearLayout>

      <!-- Madhhab Analysis -->
      <TextView
        android:id="@+id/tvDetailMadhhabNoteHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="চার মাযহাবের ওলামায়ে কেরামের দৃষ্টিভঙ্গি:"
        android:textColor="@color/accent_mint"
        android:textSize="14sp"
        android:textStyle="bold" />

      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <TextView
          android:id="@+id/tvDetailMadhhabNote"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:lineSpacingMultiplier="1.3"
          android:padding="16dp"
          android:text="মাযহাবভিত্তিক দৃষ্টিভঙ্গি।"
          android:textColor="@color/text_secondary"
          android:textSize="13sp" />
      </com.google.android.material.card.MaterialCardView>

      <!-- Verified Reference -->
      <TextView
        android:id="@+id/tvDetailReferenceHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="নির্ভরযোগ্য সূত্র ও দলীল:"
        android:textColor="@color/accent_mint"
        android:textSize="14sp"
        android:textStyle="bold" />

      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <TextView
          android:id="@+id/tvDetailReference"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:lineSpacingMultiplier="1.2"
          android:padding="16dp"
          android:text="কিতাবের নাম ও ফতোয়া রেফারেন্স।"
          android:textColor="@color/text_secondary"
          android:textSize="12.5sp"
          android:textStyle="italic" />
      </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</LinearLayout>