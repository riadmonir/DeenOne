<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/bg_main">

  <!-- Top Header Bar -->
  <LinearLayout
    android:id="@+id/layoutSalahHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:orientation="vertical"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <!-- Global Top App Bar -->
    <RelativeLayout
      android:id="@+id/layoutTopHeader"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/bg_card"
      android:paddingHorizontal="16dp"
      android:paddingTop="12dp"
      android:paddingBottom="12dp">

      <FrameLayout
        android:id="@+id/btnCloseSalahSheet"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_circular_counter"
        android:backgroundTint="@color/bg_badge_pill"
        android:clickable="true"
        android:focusable="true">

        <ImageView
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_gravity="center"
          android:src="@drawable/ic_arrow_back"
          app:tint="@color/accent_mint" />
      </FrameLayout>

      <!-- Center: DeenOne Brand Logo -->
      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Deen"
          android:textColor="@color/text_primary"
          android:textSize="22sp"
          android:textStyle="bold" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="One"
          android:textColor="@color/accent_mint"
          android:textSize="22sp"
          android:textStyle="bold" />
      </LinearLayout>

      <!-- Right: Theme Toggle + Standing Divider + Notification Bell -->
      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
          android:id="@+id/btnSalahThemeToggle"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="@drawable/bg_circular_counter"
          android:backgroundTint="@color/bg_badge_pill"
          android:clickable="true"
          android:focusable="true">

          <ImageView
            android:id="@+id/ivSalahThemeIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_moon"
            app:tint="@color/accent_mint" />
        </FrameLayout>

        <View
          android:layout_width="1.5dp"
          android:layout_height="20dp"
          android:layout_marginHorizontal="6dp"
          android:background="@color/border_card" />

        <FrameLayout
          android:id="@+id/btnSalahNotification"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="@drawable/bg_circular_counter"
          android:backgroundTint="@color/bg_badge_pill"
          android:clickable="true"
          android:focusable="true">

          <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_notifications"
            app:tint="@color/accent_mint" />

          <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/bg_circular_counter"
            android:backgroundTint="@color/accent_red" />
        </FrameLayout>
      </LinearLayout>
    </RelativeLayout>

    <!-- Subheader -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/bg_card"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingHorizontal="16dp"
      android:paddingBottom="12dp">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
          android:id="@+id/tvSalahSubheaderTitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="পরিপূর্ণ নামাজ শিক্ষা ও গাইড"
          android:textColor="@color/text_primary"
          android:textSize="16sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/tvSalahSubheaderSubtitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:text="সহীহ হাদিস ও সুন্নাহর আলোকে"
          android:textColor="@color/accent_mint"
          android:textSize="11sp" />
      </LinearLayout>

      <TextView
        android:id="@+id/tvSalahTopicCountBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_pill"
        android:backgroundTint="@color/bg_badge_pill"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="১২টি বিষয়"
        android:textColor="@color/accent_mint"
        android:textSize="11.5sp"
        android:textStyle="bold" />
    </LinearLayout>

    <!-- Search Input Bar -->
    <EditText
      android:id="@+id/etSalahGuideSearch"
      android:layout_width="match_parent"
      android:layout_height="42dp"
      android:layout_marginTop="10dp"
      android:background="@drawable/bg_badge_pill"
      android:drawableStart="@drawable/ic_search"
      android:drawablePadding="10dp"
      android:hint="নামাজ, দোয়া বা কিরাত দিয়ে খুঁজুন..."
      android:imeOptions="actionSearch"
      android:inputType="text"
      android:paddingHorizontal="14dp"
      android:textColor="@color/text_primary"
      android:textColorHint="@color/text_secondary"
      android:textSize="12.5sp" />

    <!-- Filter Chips Row -->
    <HorizontalScrollView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:overScrollMode="never"
      android:scrollbars="none">

      <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupSalahFilters"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
          android:id="@+id/chipSalahAll"
          style="@style/Widget.MaterialComponents.Chip.Choice"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:checked="true"
          android:text="সব বিষয়"
          android:textColor="@color/text_primary"
          android:textSize="11.5sp" />

        <com.google.android.material.chip.Chip
          android:id="@+id/chipSalahPurity"
          style="@style/Widget.MaterialComponents.Chip.Choice"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="ওজু ও শর্ত"
          android:textColor="@color/text_primary"
          android:textSize="11.5sp" />

        <com.google.android.material.chip.Chip
          android:id="@+id/chipSalahFardh"
          style="@style/Widget.MaterialComponents.Chip.Choice"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="৫ ওয়াক্ত ফরজ"
          android:textColor="@color/text_primary"
          android:textSize="11.5sp" />

        <com.google.android.material.chip.Chip
          android:id="@+id/chipSalahSunnah"
          style="@style/Widget.MaterialComponents.Chip.Choice"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="সুন্নাত ও বিতর"
          android:textColor="@color/text_primary"
          android:textSize="11.5sp" />

        <com.google.android.material.chip.Chip
          android:id="@+id/chipSalahNafl"
          style="@style/Widget.MaterialComponents.Chip.Choice"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="নফল ও জানাযা"
          android:textColor="@color/text_primary"
          android:textSize="11.5sp" />

        <com.google.android.material.chip.Chip
          android:id="@+id/chipSalahSteps"
          style="@style/Widget.MaterialComponents.Chip.Choice"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="রুকন ও তাসবীহ"
          android:textColor="@color/text_primary"
          android:textSize="11.5sp" />
      </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Topic Buttons Horizontal Strip -->
    <HorizontalScrollView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:overScrollMode="never"
      android:scrollbars="none">

      <LinearLayout
        android:id="@+id/layoutTopicTabsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
    </HorizontalScrollView>
  </LinearLayout>

  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/layoutSalahHeader">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <!-- Active Topic Overview Card -->
      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
              android:id="@+id/tvTopicOverviewTitle"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_marginEnd="8dp"
              android:text="ফজর নামাজ"
              android:textColor="@color/accent_mint"
              android:textSize="16sp"
              android:textStyle="bold" />

            <TextView
              android:id="@+id/tvTopicRulingBadge"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:background="@drawable/bg_badge_pill"
              android:backgroundTint="@color/bg_badge_pill"
              android:paddingHorizontal="10dp"
              android:paddingVertical="4dp"
              android:text="ফরজ আইন"
              android:textColor="@color/accent_mint"
              android:textSize="11.5sp"
              android:textStyle="bold" />
          </LinearLayout>

          <!-- Badges Row: Rak'ah & Timing -->
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
              android:id="@+id/tvTopicRakahBadge"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:background="@drawable/bg_badge_pill"
              android:paddingHorizontal="8dp"
              android:paddingVertical="3dp"
              android:text="২ সুন্নাত + ২ ফরজ"
              android:textColor="@color/text_primary"
              android:textSize="11sp" />

            <TextView
              android:id="@+id/tvTopicTimingBadge"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="6dp"
              android:background="@drawable/bg_badge_pill"
              android:paddingHorizontal="8dp"
              android:paddingVertical="3dp"
              android:text="সুবহে সাদিক থেকে সূর্যোদয়"
              android:textColor="@color/text_secondary"
              android:textSize="11sp" />
          </LinearLayout>

          <TextView
            android:id="@+id/tvTopicMainDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="ফজরের সালাত দিনের শুরুতেই মুমিনের অন্তরে নূর ও বরকত প্রবেশ করায়।"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Steps Section Header -->
      <TextView
        android:id="@+id/tvStepsSectionHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="ধারাবাহিক নিয়ম, মাসনূন কিরাত ও দোয়া:"
        android:textColor="@color/text_primary"
        android:textSize="13.5sp"
        android:textStyle="bold" />

      <!-- Steps RecyclerView -->
      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSalahSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        tools:listitem="@layout/item_salah_step_card" />

    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
