<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_emerald_gradient"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Mosque / Waqt Icon -->
    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_clock" />

    <!-- Waqt Name -->
    <TextView
        android:id="@+id/tvWidgetWaqtName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="আসর"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Waqt Range -->
    <TextView
        android:id="@+id/tvWidgetWaqtRange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="০৪:৩২ - ০৬:২৩"
        android:textColor="#A7F3D0"
        android:textSize="11.5sp" />

    <!-- Countdown Pill -->
    <TextView
        android:id="@+id/tvWidgetCountdownBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_badge_pill"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="বাকি ১ ঘণ্টা ২৫ মি."
        android:textColor="#FDE047"
        android:textSize="10.5sp"
        android:textStyle="bold" />
</LinearLayout>
