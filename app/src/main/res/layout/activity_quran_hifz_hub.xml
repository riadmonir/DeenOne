<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <FrameLayout
            android:id="@+id/btnBackHifzHub"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circular_counter"
            android:backgroundTint="@color/bg_badge_pill">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/btnBackHifzHub"
            android:layout_toStartOf="@id/layoutTopActions"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHifzMainTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="হাফেজী কুরআন ও হিফজ হাব"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHifzMainSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="১৫-লাইন পৃষ্ঠা মোড ও মুরাজাআ ট্র্যাকার"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Top Action Icons -->
        <LinearLayout
            android:id="@+id/layoutTopActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Mask Mode Toggle Button -->
            <FrameLayout
                android:id="@+id/btnToggleMaskMode"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_circular_counter"
                android:backgroundTint="@color/bg_badge_pill">

                <ImageView
                    android:id="@+id/ivMaskIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/accent_mint" />
            </FrameLayout>

            <!-- Audio Loop Toggle Button -->
            <FrameLayout
                android:id="@+id/btnTopAudioLoop"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_circular_counter"
                android:backgroundTint="@color/bg_badge_pill">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_repeat"
                    app:tint="@color/accent_mint" />
            </FrameLayout>

            <!-- Bookmark / Mistakes Button -->
            <FrameLayout
                android:id="@+id/btnTopMistakesList"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circular_counter"
                android:backgroundTint="@color/bg_badge_pill">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bookmark"
                    app:tint="@color/accent_mint" />
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Quick Navigation Jump Bar (পারা • সূরা • পৃষ্ঠা) -->
    <LinearLayout
        android:id="@+id/layoutQuickJumpBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnJumpPara"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.1"
            android:background="@drawable/bg_badge_pill"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="পারা ১৫ ⌵"
            android:textColor="@color/accent_gold"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnJumpSurah"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_badge_pill"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="আল-কাহফ ⌵"
            android:textColor="@color/accent_mint"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnJumpPage"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_pill"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="পৃষ্ঠা ২৯৩ ⌵"
            android:textColor="@color/text_primary"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Segmented Tab Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_hadith_segmented_container"
            android:padding="3dp">

            <TextView
                android:id="@+id/tabMushaf"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_hadith_segmented_active"
                android:gravity="center"
                android:text="হাফেজী কুরআন"
                android:textColor="@color/bg_main"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabTracker"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="হিফজ ট্র্যাকার"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabIndex"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="সূচিপত্র"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabMistakes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="ভুল রিভিশন"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ========================================== -->
        <!-- TAB 1: 15-Line Hafezi Mushaf ViewPager2    -->
        <!-- ========================================== -->
        <RelativeLayout
            android:id="@+id/containerMushafTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerMushaf"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal" />

            <!-- Page Navigation Quick Float Controls -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_secondary"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:id="@+id/btnPrevPage"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_badge_pill"
                    android:padding="6dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/accent_mint" />

                <TextView
                    android:id="@+id/tvFloatingPageNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:text="২৯৩ / ৬০৪"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnNextPage"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_badge_pill"
                    android:padding="6dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/accent_mint" />
            </LinearLayout>
        </RelativeLayout>

        <!-- ========================================== -->
        <!-- TAB 2: Hifz Tracker & Muraja'ah Planner   -->
        <!-- ========================================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/containerTrackerTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Overall Progress Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tvTrackerHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="হিফজ অগ্রগতি মিটার"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTrackerStreak"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_badge_streak"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:text="🔥 ৫ দিন ধারাবাহিক"
                                android:textColor="@color/accent_gold"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">

                            <TextView
                                android:id="@+id/tvTrackerParasDone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="১২ / ৩০ পারা সম্পূর্ণ"
                                android:textColor="@color/accent_mint"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTrackerPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="৪০%"
                                android:textColor="@color/accent_mint"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressBarOverallHifz"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="6dp"
                            android:max="100"
                            android:progress="40"
                            app:indicatorColor="@color/accent_mint"
                            app:trackColor="@color/border_card"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sabaq Card (আজকের সবক) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvSabaqCardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="আজকের সবক (নতুন মুখস্থ)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSabaqCardDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="পারা ১৫ • পৃষ্ঠা ৩১২ - ৩১৩ (১ পৃষ্ঠা লক্ষ্য)"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/btnOpenSabaqPage"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_badge_pill"
                                android:gravity="center"
                                android:text="পৃষ্ঠায় যান"
                                android:textColor="@color/accent_mint"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/btnCompleteSabaq"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1.2"
                                android:background="@drawable/bg_btn_mint_pill"
                                android:gravity="center"
                                android:text="✓ সম্পন্ন হয়েছে"
                                android:textColor="@color/bg_main"
                                android:textSize="12.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sabaqi Card (সবকী) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvSabaqiCardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="সবকী (সাম্প্রতিক পাঠ রিভিশন)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSabaqiCardDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="বিগত ৩-৫ দিনের নতুন পড়া একসাথে শুনানো ও রিভিশন"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnCompleteSabaqi"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_btn_mint_pill"
                            android:gravity="center"
                            android:text="সবকী রিভিশন সম্পন্ন ✓"
                            android:textColor="@color/bg_main"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Muraja'ah Dor Card (মুরাজাআ / মনজিল দৌড়) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvMurajaahCardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="মুরাজাআ / মনজিল দৌড় (৩০ পারা রিভিশন)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvMurajaahCardDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="আজকের রিভিশন: পারা ৪ (লান তানা-লু)"
                            android:textColor="@color/accent_gold"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnCompleteMurajaah"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_btn_mint_pill"
                            android:gravity="center"
                            android:text="আজকের মুরাজাআ সম্পন্ন করুন ✓"
                            android:textColor="@color/bg_main"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ========================================== -->
        <!-- TAB 3: 30 Paras & 114 Surahs Directory    -->
        <!-- ========================================== -->
        <LinearLayout
            android:id="@+id/containerIndexTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Sub Filter (৩০ পারা / ১১৪ সূরা) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/btnSubFilterParas"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_badge_pill_teal"
                    android:gravity="center"
                    android:text="৩০ পারা সূচিপত্র"
                    android:textColor="@color/bg_main"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSubFilterSurahs"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_badge_pill"
                    android:gravity="center"
                    android:text="১১৪ সূরা সূচিপত্র"
                    android:textColor="@color/accent_mint"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHifzIndex"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingBottom="20dp" />
        </LinearLayout>

        <!-- ========================================== -->
        <!-- TAB 4: Marked Mistakes & Mutashabihat Hub -->
        <!-- ========================================== -->
        <LinearLayout
            android:id="@+id/containerMistakesTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvMistakesTabHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="পড়ার সময় যে যে আয়াতে ভুল হয়েছিল বা আটকে গেছেন, সেগুলো এখানে সংরক্ষিত থাকে যাতে দ্রুত রিভিশন দেওয়া যায়।"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHifzMistakes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingBottom="20dp" />
        </LinearLayout>

    </FrameLayout>

    <!-- Floating / Bottom Audio Repetition Loop Bar (Visible when audio loop is playing) -->
    <LinearLayout
        android:id="@+id/layoutHifzAudioLoopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet_rounded_top"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLoopAyahTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="সূরা আল-কাহফ: ১ • অডিও রিপিটেশন লুপ"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLoopCounterStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="পুনরাবৃত্তি: ১ / ৩ বার"
                    android:textColor="@color/accent_mint"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btnLoopPlayPause"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_btn_mint_pill">

                    <ImageView
                        android:id="@+id/ivLoopPlayPause"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_pause"
                        app:tint="@color/bg_main" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnCloseLoopBar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circular_counter"
                    android:backgroundTint="@color/bg_badge_pill">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_close"
                        app:tint="@color/text_secondary" />
                </FrameLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Loop Count Selector Pills -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnLoopPill3x"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_pill_teal"
                android:gravity="center"
                android:text="৩ বার"
                android:textColor="@color/bg_main"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLoopPill5x"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_pill"
                android:gravity="center"
                android:text="৫ বার"
                android:textColor="@color/accent_mint"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLoopPill10x"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_pill"
                android:gravity="center"
                android:text="১০ বার"
                android:textColor="@color/accent_mint"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLoopPill20x"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_pill"
                android:gravity="center"
                android:text="২০ বার"
                android:textColor="@color/accent_mint"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
