<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Top App Bar (Fixed Header with Exact Vertical Alignment) -->
    <LinearLayout
        android:id="@+id/layoutEssentialSurahsTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- Back Button in Circular Pill Container -->
        <FrameLayout
            android:id="@+id/btnBackEssentialSurahs"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_badge_pill"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <!-- Page Title -->
        <TextView
            android:id="@+id/tvEssentialSurahsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="প্রয়োজনীয় সূরা"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Search Icon in Circular Pill Container -->
        <FrameLayout
            android:id="@+id/btnSearchEssentialSurahs"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_badge_pill"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivSearchIconToggle"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <!-- Settings Gear Icon in Circular Pill Container -->
        <FrameLayout
            android:id="@+id/btnSettingsEssentialSurahs"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_badge_pill"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_primary" />
        </FrameLayout>
    </LinearLayout>

    <!-- Collapsible Search Bar (Smoothly shown when search icon is clicked) -->
    <LinearLayout
        android:id="@+id/layoutSearchBarContainer"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_below="@id/layoutEssentialSurahsTopBar"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="@color/text_secondary" />

        <EditText
            android:id="@+id/etSearchEssentialSurahs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="প্রয়োজনীয় সূরা খুঁজুন..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btnClearSearchEssentialSurahs"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Direct List of Essential Surahs (Exact DeenOne Quran Tab Card Look & Feel) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEssentialSurahs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutSearchBarContainer"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="24dp" />

</RelativeLayout>
