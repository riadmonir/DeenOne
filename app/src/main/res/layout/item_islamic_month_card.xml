<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardIslamicMonth"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_card"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Month Number, Bengali & Arabic Name, Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMonthNumberBadge"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="@color/bg_badge_pill"
                    android:gravity="center"
                    android:text="১"
                    android:textColor="@color/accent_mint"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMonthNameBengali"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="মুহররম"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMonthStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="সম্মানিত ৪টি মাসের ১ম"
                        android:textColor="@color/accent_mint"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvMonthNameArabic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="مُحَرَّم"
                android:textColor="@color/accent_mint"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Spiritual Significance -->
        <TextView
            android:id="@+id/tvMonthSignificance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="ইসলামিক বর্ষপঞ্জির প্রথম মাস। এটি অত্যন্ত মর্যাদাপূর্ণ ৪টি সম্মানিত মাসের অন্যতম।"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />

        <!-- Key Events in this month -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="@color/bg_badge_pill"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="প্রধান দিবস ও ঐতিহাসিক ঘটনাবলী:"
                android:textColor="@color/accent_mint"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMonthKeyEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="• ১ মুহররম: হিজরী নববর্ষ\n• ১০ মুহররম: পবিত্র আশুরা।"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
