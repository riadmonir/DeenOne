<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- Top Header -->
    <RelativeLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_main"
        android:paddingHorizontal="16dp">

        <!-- Back Button -->
        <FrameLayout
            android:id="@+id/btnCloseBanglaQuran"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circular_counter"
            android:backgroundTint="@color/bg_badge_pill">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <!-- Title & Subtitle Column -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toStartOf="@+id/layoutTopActions"
            android:layout_toEndOf="@+id/btnCloseBanglaQuran"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBanglaQuranTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="কুরআন বাংলা"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBanglaQuranSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="তানজিল প্রজেক্ট (Tanzil.net) অনুমোদিত বিশুদ্ধ বাংলা অনুবাদ"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Right Action Icons: Translator Pill + Offline Download Button + Theme Toggle -->
        <LinearLayout
            android:id="@+id/layoutTopActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Translator Picker Pill Button -->
            <LinearLayout
                android:id="@+id/btnSelectBanglaTranslator"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_pill"
                android:gravity="center"
                android:paddingHorizontal="10dp">

                <TextView
                    android:id="@+id/tvActiveTranslatorPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="মুহিউদ্দীন খান ▾"
                    android:textColor="@color/accent_gold"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Offline Download Full Bangla Quran Button -->
            <FrameLayout
                android:id="@+id/btnDownloadBanglaQuran"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_circle_gold">

                <ImageView
                    android:id="@+id/ivDownloadQuranIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_download"
                    app:tint="@color/text_dark" />

                <ProgressBar
                    android:id="@+id/pbDownloadQuran"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/text_dark"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvDownloadQuranPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:includeFontPadding="false"
                    android:text="0%"
                    android:textColor="@color/text_dark"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Theme Toggle -->
            <FrameLayout
                android:id="@+id/btnBanglaQuranThemeToggle"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circular_counter"
                android:backgroundTint="@color/bg_badge_pill">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_moon"
                    app:tint="@color/accent_mint" />
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Header Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_card" />

    <!-- Search Bar -->
    <RelativeLayout
        android:id="@+id/layoutBanglaQuranSearch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card_secondary"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/ivSearchIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="@color/accent_mint" />

        <EditText
            android:id="@+id/etSearchBanglaQuran"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/ivSearchIcon"
            android:background="@null"
            android:hint="বাংলায় সূরা বা পারা খুঁজুন..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp" />
    </RelativeLayout>

    <!-- 3 Tabs: ১১৪ টি সূরা | ৩০ টি পারা | বুকমার্ক -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabBanglaSurahs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_active"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="১১৪ টি সূরা"
            android:textColor="@color/accent_mint"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabBanglaParas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_pill"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="৩০ টি পারা"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabBanglaBookmarks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_pill"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="বুকমার্ক"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. 114 Surahs RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBanglaSurahs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="24dp"
            android:visibility="visible" />

        <!-- 2. 30 Paras RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBanglaParas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="24dp"
            android:visibility="gone" />

        <!-- 3. Unified Bookmarks Container -->
        <LinearLayout
            android:id="@+id/layoutBanglaBookmarksContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Sub-Filter Chips: সব | সূরা | পারা | আয়াত -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingHorizontal="16dp"
                android:paddingBottom="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutBookmarkFilterChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipBookmarkAll"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_tab_active"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="সব"
                        android:textColor="@color/accent_mint"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipBookmarkSurahs"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_badge_pill"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="সূরা"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipBookmarkParas"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_badge_pill"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="পারা"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipBookmarkAyahs"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_badge_pill"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="আয়াত"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Bookmarks Scrollable Lists -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/nsvBanglaBookmarksContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingBottom="28dp">

                    <!-- Surahs Section -->
                    <LinearLayout
                        android:id="@+id/layoutBookmarkedSurahsSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <TextView
                            android:id="@+id/tvBookmarkedSurahsHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="6dp"
                            android:text="সংরক্ষিত সূরাসমূহ"
                            android:textColor="@color/accent_gold"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvBookmarkedSurahs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>

                    <!-- Paras Section -->
                    <LinearLayout
                        android:id="@+id/layoutBookmarkedParasSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <TextView
                            android:id="@+id/tvBookmarkedParasHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="6dp"
                            android:text="সংরক্ষিত পারাসমূহ"
                            android:textColor="@color/accent_gold"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvBookmarkedParas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>

                    <!-- Ayahs Section -->
                    <LinearLayout
                        android:id="@+id/layoutBookmarkedAyahsSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <TextView
                            android:id="@+id/tvBookmarkedAyahsHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="6dp"
                            android:text="সংরক্ষিত আয়াতসমূহ"
                            android:textColor="@color/accent_gold"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvBookmarkedAyahs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>

                    <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/layoutBanglaBookmarksEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="40dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bookmark"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvBookmarksEmptyTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="কোনো বুকমার্ক সংরক্ষিত নেই"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBookmarksEmptySubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="কুরআন বাংলা পড়ার সময় যে কোনো সূরা, পারা বা আয়াত বুকমার্ক করলে তা এখানে দেখতে পাবেন।"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
