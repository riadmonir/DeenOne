<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutMissedPrayersSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_modal_emerald_sheet"
    android:orientation="vertical"
    android:paddingBottom="28dp">

    <!-- Top Center Drag / Grab Handle Pill -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_badge_pill"
        android:backgroundTint="@color/border_card" />

    <!-- Sheet Header Row: Title & Total Qaza Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMissedPrayersTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="ছুটে যাওয়া নামাজ ট্র্যাকার"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTotalMissedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_gold_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="মোট কাজা: ০ ওয়াক্ত"
            android:textColor="@color/gold_badge_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtitle Instruction -->
    <TextView
        android:id="@+id/tvMissedPrayersSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:text="আজকের যেসকল ওয়াক্ত পড়তে পারেননি, সেগুলো কাযা হিসেবে আদায় করে মার্ক করুন:"
        android:textColor="@color/text_secondary"
        android:textSize="13.5sp" />

    <!-- Empty State Message when no prayers missed -->
    <LinearLayout
        android:id="@+id/layoutEmptyMissedPrayers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card_secondary"
        android:backgroundTint="@color/bg_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_icon"
            android:backgroundTint="@color/feat_bg_journey">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/accent_mint" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvEmptyMissedPrayers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="আলহামদুলিল্লাহ! আজকের কোনো সালাত ছুটে যায়নি।"
            android:textColor="@color/accent_mint"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmptyMissedPrayersDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="আপনার আজকের সকল ওয়াক্ত সময়মতো আদায় হয়েছে।"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- 1. Fajr Waqt Row Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutRowFajr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_icon"
                android:backgroundTint="@color/badge_pill_red_bg">

                <ImageView
                    android:id="@+id/ivIndicatorFajr"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_cancel_circle"
                    app:tint="@color/accent_red" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNameFajr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ফজর ওয়াক্ত"
                    android:textColor="@color/text_primary"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusFajr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="সময় অতিক্রান্ত • কাজা হয়েছে"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnToggleFajr"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="105dp"
                android:background="@drawable/bg_btn_pill_green"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="আদায় করেছি"
                android:textColor="@color/white"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 2. Dhuhr Waqt Row Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutRowDhuhr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_icon"
                android:backgroundTint="@color/badge_pill_red_bg">

                <ImageView
                    android:id="@+id/ivIndicatorDhuhr"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_cancel_circle"
                    app:tint="@color/accent_red" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNameDhuhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="যোহর ওয়াক্ত"
                    android:textColor="@color/text_primary"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusDhuhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="সময় অতিক্রান্ত • কাজা হয়েছে"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnToggleDhuhr"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="105dp"
                android:background="@drawable/bg_btn_pill_green"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="আদায় করেছি"
                android:textColor="@color/white"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3. Asr Waqt Row Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutRowAsr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_icon"
                android:backgroundTint="@color/badge_pill_red_bg">

                <ImageView
                    android:id="@+id/ivIndicatorAsr"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_cancel_circle"
                    app:tint="@color/accent_red" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNameAsr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="আসর ওয়াক্ত"
                    android:textColor="@color/text_primary"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusAsr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="সময় অতিক্রান্ত • কাজা হয়েছে"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnToggleAsr"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="105dp"
                android:background="@drawable/bg_btn_pill_green"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="আদায় করেছি"
                android:textColor="@color/white"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 4. Maghrib Waqt Row Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutRowMaghrib"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_icon"
                android:backgroundTint="@color/badge_pill_red_bg">

                <ImageView
                    android:id="@+id/ivIndicatorMaghrib"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_cancel_circle"
                    app:tint="@color/accent_red" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNameMaghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="মাগরিব ওয়াক্ত"
                    android:textColor="@color/text_primary"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusMaghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="সময় অতিক্রান্ত • কাজা হয়েছে"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnToggleMaghrib"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="105dp"
                android:background="@drawable/bg_btn_pill_green"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="আদায় করেছি"
                android:textColor="@color/white"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 5. Isha Waqt Row Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutRowIsha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_card"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_icon"
                android:backgroundTint="@color/badge_pill_red_bg">

                <ImageView
                    android:id="@+id/ivIndicatorIsha"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_cancel_circle"
                    app:tint="@color/accent_red" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNameIsha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="এশা ওয়াক্ত"
                    android:textColor="@color/text_primary"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusIsha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="সময় অতিক্রান্ত • কাজা হয়েছে"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnToggleIsha"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="105dp"
                android:background="@drawable/bg_btn_pill_green"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="আদায় করেছি"
                android:textColor="@color/white"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Action Card: View Full Qaza Calculator -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnOpenLifetimeQaza"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/accent_teal"
        app:strokeWidth="1.2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_icon"
                android:backgroundTint="@color/feat_bg_journey">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/accent_teal" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOpenLifetimeQazaTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="কাজা নামাজ ক্যালকুলেটর"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOpenLifetimeQazaSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="জীবনের মোট কাজা নামাজের হিসাব ও পরিচালনা"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/accent_teal" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
