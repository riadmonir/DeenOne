<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/layoutAllahNamesHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_top_bar"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Global Top App Bar -->
        <RelativeLayout
            android:id="@+id/layoutTopHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_top_bar"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:id="@+id/btnCloseAllahNames"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circular_counter"
                android:backgroundTint="@color/bg_badge_pill"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/accent_mint" />
            </FrameLayout>

            <!-- Center: DeenOne Brand Logo -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deen"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="One"
                    android:textColor="@color/accent_mint"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Right: Theme Toggle + Notification Bell -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btnNamesThemeToggle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circular_counter"
                    android:backgroundTint="@color/bg_badge_pill"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivNamesThemeIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_moon"
                        app:tint="@color/accent_mint" />
                </FrameLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/border_card" />

                <FrameLayout
                    android:id="@+id/btnNamesNotification"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circular_counter"
                    android:backgroundTint="@color/bg_badge_pill"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_notifications"
                        app:tint="@color/accent_mint" />
                </FrameLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Subheader: Title & Counter Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAllahNamesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="আল্লাহর ৯৯টি গুণবাচক নাম"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAllahNamesSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="আসমাউল হুসনা • আরবি, বাংলা অর্থ ও ফজিলত"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTotalNamesBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="৯৯টি নাম"
                android:textColor="@color/accent_mint"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Continuous Audio Player Bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardContinuousPlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_card"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/layoutPlayerControls"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPlayerStatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="একসাথে সবগুলো নাম শুনুন"
                        android:textColor="@color/text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPlayerCurrentName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="১ থেকে ৯৯ নাম ধারাবাহিক তিলাওয়াত"
                        android:textColor="@color/accent_mint"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutPlayerControls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnPlayerPrev"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:src="@drawable/ic_skip_previous"
                        app:tint="@color/text_secondary" />

                    <FrameLayout
                        android:id="@+id/btnContinuousPlayPause"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@drawable/bg_circular_counter"
                        android:backgroundTint="@color/accent_mint">

                        <ImageView
                            android:id="@+id/ivContinuousPlayIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_play_arrow"
                            app:tint="@color/bg_main" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/btnPlayerNext"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:src="@drawable/ic_skip_next"
                        app:tint="@color/text_secondary" />
                </LinearLayout>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_badge_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/etSearchNames"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="নাম, অর্থ বা ফজিলত অনুসন্ধান করুন..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Filter Chips (Horizontal Scroll) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAllNames"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_active"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="সবগুলো"
                    android:textColor="@color/accent_mint"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipMercy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_card_secondary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="রহমত ও ক্ষমা"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/chipMajesty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_card_secondary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="মহিমা ও পরাক্রম"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/chipProvision"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_card_secondary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="রিজিক ও সৃষ্টি"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/chipWisdom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_card_secondary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="জ্ঞান ও ন্যায়বিচার"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Names RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAllahNames"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutAllahNamesHeader" />

</androidx.constraintlayout.widget.ConstraintLayout>
