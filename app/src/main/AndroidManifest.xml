<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network & Internet Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>

    <!-- Location Permissions for Accurate Prayer Calculations -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Notifications & Alarms -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Foreground Services for Audio & Prayer Sync -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- License Verification -->
    <uses-permission android:name="com.android.vending.CHECK_LICENSE" />

    <application
        android:name=".DeenOneApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeenOne">

        <!-- Google Mobile Ads Application ID (Loaded from strings.xml) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <!-- Splash Activity (Animated Cold Start) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DeenOne.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DeenOne"
            android:windowSoftInputMode="adjustResize" />

        <!-- Adhan Alarm Receiver -->
        <receiver
            android:name=".service.AdhanAlarmReceiver"
            android:exported="false" />

        <!-- Daily Islamic Reminders Receiver -->
        <receiver
            android:name=".core.notifications.DailyIslamicReminderScheduler"
            android:exported="false" />

        <!-- Smart Islamic Reminder Engine -->
        <receiver
            android:name=".core.notifications.SmartIslamicReminderEngine"
            android:exported="false" />

        <!-- Sehri & Iftar Reminders Receiver -->
        <receiver
            android:name=".core.notifications.SehriIftarReminderScheduler"
            android:exported="false" />

        <!-- Admin & Server Push Notifications Receiver -->
        <receiver
            android:name=".core.notifications.AdminNotificationManager"
            android:exported="false" />

        <!-- Timezone & System Time Change Receiver -->
        <receiver
            android:name=".core.alarms.TimezoneChangedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Jummah Special Friday Notifications Receiver -->
        <receiver
            android:name=".core.jummah.JummahNotificationReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.devflux.deenone.ACTION_JUMMAH_REMINDER" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Eid Special Notifications Receiver -->
        <receiver
            android:name=".core.eid.EidNotificationReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.devflux.deenone.ACTION_EID_REMINDER" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Daily Ayah & Hadith Midnight Rollover Receiver -->
        <receiver
            android:name=".core.content.DailyContentMidnightReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Quran Journey Daily Habit Reminder Receiver -->
        <receiver
            android:name=".core.alarms.QuranJourneyReminderReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.devflux.deenone.ACTION_QURAN_JOURNEY_REMINDER" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Durud Reminder Receiver -->
        <receiver
            android:name=".core.notifications.DurudReminderScheduler"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.devflux.deenone.ACTION_DURUD_REMINDER" />
                <action android:name="com.devflux.deenone.ACTION_JUMUAH_DURUD_REMINDER" />
            </intent-filter>
        </receiver>

        <!-- Istigfar & Tawbah Reminder Receiver -->
        <receiver
            android:name=".core.notifications.IstigfarReminderScheduler"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.devflux.deenone.ACTION_ISTIGFAR_REMINDER" />
                <action android:name="com.devflux.deenone.ACTION_SAYYIDUL_ISTIGFAR_MORNING" />
                <action android:name="com.devflux.deenone.ACTION_SAYYIDUL_ISTIGFAR_EVENING" />
                <action android:name="com.devflux.deenone.ACTION_BEDTIME_ISTIGFAR" />
            </intent-filter>
        </receiver>

        <!-- Audio Player Service (ExoPlayer - Adhan) -->
        <service
            android:name=".service.AudioPlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Quran Audio Service (Media3 MediaSessionService - background playback) -->
        <service
            android:name=".service.QuranAudioService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Islamic Audio Hub Player Service (ExoPlayer - background media playback) -->
        <service
            android:name=".features.audio.service.IslamicAudioPlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Quran Sleep Mode Player Service (ExoPlayer - background media playback with lockscreen & notification controls) -->
        <service
            android:name=".core.quran.service.QuranSleepService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Quran Unified Background Download Action Receiver (Pause, Resume, Cancel) -->
        <receiver
            android:name=".core.quran.QuranDownloadActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.devflux.deenone.ACTION_QURAN_DOWNLOAD_PAUSE" />
                <action android:name="com.devflux.deenone.ACTION_QURAN_DOWNLOAD_RESUME" />
                <action android:name="com.devflux.deenone.ACTION_QURAN_DOWNLOAD_CANCEL" />
            </intent-filter>
        </receiver>

        <!-- DeenOne 15 Home Screen Live Widget Providers -->
        <!-- 1. Day Summary -->
        <receiver
            android:name=".widget.DeenOnePrayerAppWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/deenone_prayer_widget_info" />
        </receiver>

        <!-- 2. Day Summary Transparent -->
        <receiver
            android:name=".widget.WidgetDaySummaryTransparentProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_day_summary_transparent_info" />
        </receiver>

        <!-- 3. Salat Countdown Schedule -->
        <receiver
            android:name=".widget.WidgetSalatCountdownScheduleProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_salat_countdown_schedule_info" />
        </receiver>

        <!-- 4. Salat Countdown Compact OLED -->
        <receiver
            android:name=".widget.WidgetSalatCountdownCompactProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_salat_countdown_compact_info" />
        </receiver>

        <!-- 5. Saom Fasting Timer -->
        <receiver
            android:name=".widget.WidgetSaomTimerProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_saom_timer_info" />
        </receiver>

        <!-- 6. Muslims Day 3x2 -->
        <receiver
            android:name=".widget.WidgetMuslimsDayCompactProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_muslims_day_compact_info" />
        </receiver>

        <!-- 7. Prayer Times List -->
        <receiver
            android:name=".widget.WidgetPrayerTimesListProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_prayer_times_list_info" />
        </receiver>

        <!-- 8. Prayer Times List Transparent -->
        <receiver
            android:name=".widget.WidgetPrayerTimesListTransparentProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_prayer_times_list_transparent_info" />
        </receiver>

        <!-- 9. Compact Prayer Bar -->
        <receiver
            android:name=".widget.WidgetCompactPrayerBarProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_compact_prayer_bar_info" />
        </receiver>

        <!-- 10. Single Waqt Focus -->
        <receiver
            android:name=".widget.WidgetSingleWaqtFocusProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_single_waqt_focus_info" />
        </receiver>

        <!-- 11. Daily Quran Ayah -->
        <receiver
            android:name=".widget.WidgetDailyAyahProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_daily_ayah_info" />
        </receiver>

        <!-- 12. Daily Hadith & Wisdom -->
        <receiver
            android:name=".widget.WidgetDailyHadithProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_daily_hadith_info" />
        </receiver>

        <!-- 13. Digital Tasbih & Zikr -->
        <receiver
            android:name=".widget.WidgetDigitalTasbihProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_digital_tasbih_info" />
        </receiver>

        <!-- 14. Islamic Calendar & Hijri Event -->
        <receiver
            android:name=".widget.WidgetIslamicCalendarProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_islamic_calendar_info" />
        </receiver>

        <!-- 15. Qibla Direction & Prayer Snapshot -->
        <receiver
            android:name=".widget.WidgetQiblaSnapshotProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_qibla_snapshot_info" />
        </receiver>

        <!-- Widget Interactive Actions Broadcast Receiver -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.devflux.deenone.widget.ACTION_REFRESH" />
                <action android:name="com.devflux.deenone.widget.ACTION_TASBIH_COUNT" />
                <action android:name="com.devflux.deenone.widget.ACTION_TASBIH_RESET" />
                <action android:name="com.devflux.deenone.widget.ACTION_NEXT_AYAH_HADITH" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for Sharing Hadith Screenshots / Cards -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>